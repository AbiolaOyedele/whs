# Resend — transactional email delivery for all four forms.
# Server-only. NEVER prefix with PUBLIC_.
RESEND_API_KEY=your_resend_api_key

# Where contact / application form notifications are delivered.
CONTACT_NOTIFICATION_EMAIL=your_notification_email

# PostHog analytics (optional at this stage — omit both to disable analytics).
PUBLIC_POSTHOG_KEY=your_posthog_key
PUBLIC_POSTHOG_HOST=https://your-posthog-host.example.com

# Canonical site origin. Used for sitemap.xml, canonical URLs, and OG tags.
PUBLIC_SITE_URL=http://localhost:4321
