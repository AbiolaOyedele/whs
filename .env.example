# Resend — transactional email delivery for all four forms.
# Server-only. NEVER prefix with PUBLIC_.
RESEND_API_KEY=your_resend_api_key

# Where contact / application form notifications are delivered.
CONTACT_NOTIFICATION_EMAIL=your_notification_email

# PostHog analytics (optional at this stage — omit both to disable analytics).
PUBLIC_POSTHOG_KEY=your_posthog_key
PUBLIC_POSTHOG_HOST=https://your-posthog-host.example.com

# Canonical site origin. Used for sitemap.xml, canonical URLs, and OG tags.
PUBLIC_SITE_URL=http://localhost:4321

# --- CV storage (optional) ---
# Without these an application still submits and the CV still arrives as an
# email attachment; it is just not filed anywhere. Uploads are signed
# server-side and stored as private "authenticated" raw assets, so a CV has no
# publicly guessable URL. See src/lib/cloudinary.ts.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================================
# ADMIN PANEL
# ----------------------------------------------------------------------------
# Everything below powers /admin. Validated as a group, lazily: with none of it
# set the marketing site still builds and all four forms still send — /admin
# just shows a setup screen naming what is missing.
#
# Supabase is server-only by design. The admin UI never talks to Supabase from
# the browser; it calls our own /api/v1/admin/* routes and the session lives in
# an httpOnly cookie. No Supabase key of any kind ships in a client bundle.
# ============================================================================

# Supabase — auth and data. Project settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses row-level security. Server-only. Treat as a root password.
SUPABASE_SERVICE_ROLE_KEY=

# Who may sign in. Comma-separated. A correct password is NOT enough — the
# address must also appear here, so a stray Supabase auth row grants nothing.
ADMIN_ALLOWED_EMAILS=you@example.com

# Mixed into every client quote PIN hash. Minimum 16 characters.
# Generate one:  openssl rand -base64 32
# Rotating this invalidates every existing quote PIN. That is the panic button.
QUOTE_PIN_PEPPER=

# AI-assisted quote drafting. Two providers, either or both, both optional —
# with neither key set the quote editor works exactly as normal and only the
# "Draft with AI" panel is disabled.
#
# Claude is the default. Gemini is selectable per request from the drafting
# panel, so an outage on one side never blocks a quote going out.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. Overrides the Claude model id. Defaults to claude-haiku-4-5, which
# is plenty for turning a brief into a structured draft. Set claude-sonnet-5 or
# claude-opus-5 here if a particular engagement needs more.
ANTHROPIC_MODEL=
# Optional. Overrides the Gemini model id. Defaults to gemini-3.8-flash.
# Note: the gemini-2.5 family is closed to newly-issued keys, so do not set one
# of those. Set this rather than editing code when the name moves on.
GEMINI_MODEL=

# Vercel Deploy Hook. The Publish button POSTs here to rebuild the static site.
# Project Settings → Git → Deploy Hooks. Optional: without it the admin still
# saves every edit, it just cannot push them live.
WH_VERCEL_DEPLOY_HOOK_URL=

# Vercel read-only API token, for the analytics section.
# Optional: without it the analytics page explains how to connect it.
WH_VERCEL_API_TOKEN=
WH_VERCEL_PROJECT_ID=
# Only needed if the project sits under a team rather than a personal account.
WH_VERCEL_TEAM_ID=

# --- Paystack -----------------------------------------------------------------
# FLAGGED DEVIATION: the confirmed stack names Stripe. Paystack was chosen for
# this build on request.
#
# Optional: with no keys the quote page simply does not offer payment.
#
# ⚠️ Paystack settles in NGN, GHS, ZAR, KES and USD depending on your account.
# It cannot charge GBP or EUR. A quote priced in an unsupported currency will
# not show a pay button at all, which is deliberate — better than one that
# fails after the client has clicked it.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
