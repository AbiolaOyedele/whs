---
/**
 * Home page.
 *
 * Copy from docs/site-copy.md (supplied 2026-08-26). Two sections are still
 * waiting on content and are marked in place:
 *   - Proof grid: needs real project content.
 *   - Testimonial: needs the actual quote text and attribution.
 * The stat strip was dropped for launch, per that document.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import WorkCard from '@/components/sections/WorkCard.astro'
import AnimatedText from '@/components/sections/AnimatedText.astro'
import Button from '@/components/ui/Button.astro'
import { SITE } from '@/config/site'
import { SERVICE_PILLARS, SERVICE_PILLAR_LABELS, SERVICE_PILLAR_TAGLINES } from '@/content.config'

const [work, services] = await Promise.all([
  getCollection('work', ({ data }) => !data.draft),
  getCollection('services', ({ data }) => !data.draft),
])

const featured = work.filter((e) => e.data.featured).sort((a, b) => a.data.order - b.data.order)
const pillars = services.sort((a, b) => a.data.order - b.data.order)

/**
 * TODO: the trust row should be products and apps WildHands has built, not
 * client logos. Placeholder names until the product list is supplied.
 */
const BUILT_BY_WILDHANDS = ['Northwind', 'Aeon', 'Harbor & Finch']

const problems = [
  {
    title: 'Automate the repeats.',
    body: 'We build tools that take repetitive work off your plate for good.',
  },
  {
    title: 'Get hours back.',
    body: 'Every system we build is judged the same way: how much time it saves you.',
  },
  {
    title: 'See what is happening, in real time.',
    body: 'Custom dashboards that show you the numbers that matter, without digging for them.',
  },
]
---

<BaseLayout title={SITE.name} description={SITE.description} darkHero>
  <Hero
    variant="home"
    title="Custom systems that give you your time back."
    standfirst="WildHands Studio designs and builds custom websites, apps, and internal tools for teams done doing repetitive work by hand."
  >
    <Fragment slot="logos">
      <p class="text-sm text-white/45">Built by WildHands</p>
      <ul class="mt-3 flex flex-wrap items-center gap-x-7 gap-y-2">
        {
          BUILT_BY_WILDHANDS.map((name) => (
            <li class="text-base font-medium tracking-tight text-white/85">{name}</li>
          ))
        }
      </ul>
    </Fragment>

    <Fragment slot="cta">
      <Button href="/get-in-touch" variant="accent" arrows={false} class="h-16 w-full md:h-20">
        Talk to Us
      </Button>
      <Button href="/work" variant="outline" onDark arrows={false} class="h-16 w-full md:h-20">
        See Our Work
      </Button>
    </Fragment>
  </Hero>

  <!-- The problem -->
  <section class="relative overflow-clip rounded-[2rem] bg-background text-foreground">
    <div class="lg:pt-[16.5rem]">
      <div
        class="lg:grid lg:min-h-[57.1875rem] lg:grid-cols-[42.7%_57.3%] lg:border-t lg:border-border"
      >
        <div class="border-b border-border px-5 py-10 md:px-8 lg:border-r lg:border-b-0 lg:py-0">
          <div
            class="flex flex-col justify-between gap-32 lg:sticky lg:top-24 lg:h-[min(calc(100dvh-6rem),100%)] lg:py-10"
          >
            <div>
              <p class="text-sm font-medium tracking-widest text-muted-foreground uppercase">
                The Problem
              </p>
              <AnimatedText>
                <h2 class="wh-h2 mt-5 max-w-[20ch]">
                  Your team is spending hours on work a system could do in seconds.
                </h2>
              </AnimatedText>
              <p class="mt-6 max-w-prose text-muted-foreground">
                Manual data entry. Reports rebuilt from scratch every week. No single place to see
                what is actually happening. That is hours gone that should have gone into the work
                only you can do.
              </p>
            </div>
            <Button href="/services" variant="link">See how we fix this &rarr;</Button>
          </div>
        </div>

        <div class="grid">
          {
            problems.map((item, index) => (
              <article class="min-h-[24rem] border-b border-border px-5 py-10 last:border-b-0 md:px-8 lg:pt-[2.875rem] lg:pr-8 lg:pl-[7.3vw]">
                <span class="text-sm text-muted-foreground tabular-nums">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-4 text-2xl font-medium tracking-tight md:text-3xl">{item.title}</h3>
                <p class="mt-4 max-w-prose text-muted-foreground">{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- What we build -->
  <section class="wh-container my-10 lg:my-20">
    <div class="relative border-t border-border pt-10 lg:pt-20">
      <h2 id="services-title" class="wh-h2 mt-5 mb-5 lg:absolute lg:left-0 lg:mb-10">
        What we build
      </h2>

      <div class="mx-auto w-full max-w-3xl lg:max-w-2xl lg:px-8">
        <ol class="wh-services-list">
          {
            SERVICE_PILLARS.map((pillar, index) => {
              const match = pillars.find((s) => s.data.pillar === pillar)
              const href = match ? `/services/${match.id}` : '/services'
              return (
                <li class="wh-service-row border-b border-border last:border-b-0">
                  <a href={href} class="group flex items-baseline gap-5 py-6 md:py-8">
                    <span class="text-sm text-muted-foreground tabular-nums">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="flex-1 text-2xl leading-snug md:text-[2rem]">
                      <span class="font-medium">{SERVICE_PILLAR_LABELS[pillar]}.</span>{' '}
                      <span class="text-muted-foreground">{SERVICE_PILLAR_TAGLINES[pillar]}</span>
                    </span>
                    <span
                      aria-hidden="true"
                      class="shrink-0 translate-x-0 text-xl transition-transform duration-300 group-hover:translate-x-1"
                    >
                      &rarr;
                    </span>
                  </a>
                </li>
              )
            })
          }
        </ol>

        <div class="mt-10 flex flex-wrap gap-3">
          <Button href="/services" variant="primary">See Services</Button>
          <Button href="/get-in-touch" variant="outline">Talk to Us</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent work -->
  <section class="wh-container">
    <h2 id="featured-projects-title" class="wh-h2 mt-20 mb-5 inline-block">Recent work</h2>

    {
      featured.length > 0 ? (
        <Fragment>
          <div class="wh-projects-grid grid gap-1 gap-y-10 pt-16 md:grid-cols-12">
            {featured.map((entry) => (
              <WorkCard
                href={`/work/${entry.id}`}
                client={entry.data.client}
                summary={entry.data.summary}
                techStack={entry.data.techStack}
                stats={entry.data.stats}
              />
            ))}
          </div>
          <p class="mt-2 text-sm text-muted-foreground">
            Placeholder projects — awaiting real product content.
          </p>
        </Fragment>
      ) : (
        <p class="mt-10 text-muted-foreground">Project content coming soon.</p>
      )
    }

    <div class="mt-12">
      <Button href="/work" variant="outline">See all work</Button>
    </div>
  </section>

  <!--
    TODO: testimonial section. Two client quotes exist but the text and
    attribution have not been supplied — deliberately not invented. Drop a
    <Testimonial /> here once the real quotes land.
    The stat strip was dropped for launch, per docs/site-copy.md.
  -->

  <!-- Closing CTA -->
  <div class="mx-auto mt-20 lg:max-w-[92rem] xl:max-w-[100rem]">
    <section
      class="relative flex min-h-svh flex-col justify-center overflow-clip rounded-3xl bg-[#131314] px-5 py-10 text-white md:px-[10vh] lg:py-32"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-[1]"
        style="background: radial-gradient(70rem 40rem at 78% 12%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 62%), linear-gradient(90deg, rgba(19,19,20,0.9) 0%, rgba(19,19,20,0.2) 55%, transparent 100%);"
      >
      </div>

      <div class="relative z-10 max-w-3xl">
        <AnimatedText>
          <h2 class="text-[clamp(2.25rem,6vw,4rem)] leading-[1.1] font-normal tracking-[-0.03em]">
            Ready to get some time back?
          </h2>
        </AnimatedText>
        <p class="mt-6 max-w-[35rem] text-xl text-white/70">
          Tell us what is eating your hours. We will show you what a system built for it looks like.
        </p>
        <div class="mt-10">
          <Button href="/get-in-touch" variant="accent" size="lg">Talk to Us</Button>
        </div>
        <p class="mt-6 text-sm text-white/50">A real conversation, not a sales pitch.</p>
      </div>
    </section>
  </div>
</BaseLayout>
