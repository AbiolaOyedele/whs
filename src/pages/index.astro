---
/**
 * Home page.
 *
 * Copy from docs/site-copy.md (supplied 2026-08-26). Two sections are still
 * waiting on content and are marked in place:
 *   - Proof grid: needs real project content.
 *   - Testimonial: needs the actual quote text and attribution.
 * The stat strip was dropped for launch, per that document.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import WorkCard from '@/components/sections/WorkCard.astro'
import AnimatedText from '@/components/sections/AnimatedText.astro'
import CTASection from '@/components/sections/CTASection.astro'
import Button from '@/components/ui/Button.astro'
import { SITE } from '@/config/site'
import { list, text } from '@/lib/admin/content'
import { SERVICE_PILLARS, SERVICE_PILLAR_LABELS, SERVICE_PILLAR_TAGLINES } from '@/content.config'

const [work, services] = await Promise.all([
  getCollection('work', ({ data }) => !data.draft),
  getCollection('services', ({ data }) => !data.draft),
])

const featured = work.filter((e) => e.data.featured).sort((a, b) => a.data.order - b.data.order)
const pillars = services.sort((a, b) => a.data.order - b.data.order)

/*
 * Copy comes from the website editor, falling back to the defaults registered
 * in src/config/content-registry.ts — which are the strings that used to be
 * written out here. Editing one of these in /admin/website and publishing
 * changes the page; an unreachable database changes nothing.
 */
const BUILT_BY_WILDHANDS = list('home.hero.logos')

const problems = [0, 1, 2].map((index) => ({
  title: text(`home.problems.${index}.title`),
  body: text(`home.problems.${index}.body`),
}))
---

<BaseLayout title={SITE.name} description={text('site.description')} darkHero>
  <Hero
    variant="home"
    title={text('home.hero.title')}
    standfirst={text('home.hero.standfirst')}
    titleKey="home.hero.title"
    standfirstKey="home.hero.standfirst"
  >
    <Fragment slot="logos">
      <p class="text-base text-white/70" data-wh-content="home.hero.logosLabel">
        {text('home.hero.logosLabel')}
      </p>
      <ul class="mt-3 flex flex-wrap items-center gap-x-7 gap-y-2">
        {
          BUILT_BY_WILDHANDS.map((name) => (
            <li class="text-base font-medium tracking-tight text-white/85">{name}</li>
          ))
        }
      </ul>
    </Fragment>

    <Fragment slot="cta">
      <Button href="/get-in-touch" variant="accent" arrows={false} class="h-16 w-full md:h-20">
        {text('home.hero.ctaPrimary')}
      </Button>
      <Button href="/work" variant="outline" onDark arrows={false} class="h-16 w-full md:h-20">
        {text('home.hero.ctaSecondary')}
      </Button>
    </Fragment>
  </Hero>

  {
    /*    The problem.

    Full-bleed band, but the copy lives inside `.wh-container` so it lands on
    the same left edge as every other section. It previously carried its own
    `px-5 md:px-8` gutters, which held 32px at 768px while the container around
    it held 20px, and 32px at 1920px while the container held 153px.

    The section carries no eyebrow label — the heading says what it is.*/
  }
  <section
    class="relative overflow-clip rounded-section bg-background text-foreground"
    aria-labelledby="homepage-problem-title"
  >
    <div class="wh-container">
      <div class="pt-12 lg:pt-20">
        <div
          class="lg:grid lg:min-h-[57.1875rem] lg:grid-cols-[42.7%_57.3%] lg:border-t lg:border-border"
        >
          <div class="border-b border-border py-10 lg:border-r lg:border-b-0 lg:py-0 lg:pr-10">
            {
              /* gap-10 below lg: `gap-32` fired at every breakpoint, dropping
                 128px of nothing between the heading and the paragraph that
                 explains it on a phone.*/
            }
            <div
              class="flex flex-col justify-between gap-10 lg:sticky lg:top-24 lg:h-[min(calc(100dvh-6rem),100%)] lg:gap-32 lg:py-10"
            >
              <AnimatedText>
                <h2 id="homepage-problem-title" class="wh-h2-display max-w-[34rem]">
                  Your team is spending hours on work a system could do in seconds.
                </h2>
              </AnimatedText>
              <div class="max-w-[28rem] lg:pb-6">
                <p class="mb-9 text-base text-muted-foreground">
                  Manual data entry. Reports rebuilt from scratch every week. No single place to see
                  what is actually happening. That is hours gone that should have gone into the work
                  only you can do.
                </p>
                <Button href="/services" variant="link">See how we fix this &rarr;</Button>
              </div>
            </div>
          </div>

          <div class="grid">
            {
              problems.map((item, index) => (
                <article class="min-h-[20rem] border-b border-border py-10 last:border-b-0 lg:min-h-[24rem] lg:pt-[2.875rem] lg:pl-10">
                  <span class="text-sm text-muted-foreground tabular-nums">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3
                    class="mt-4 max-w-[42.25rem] text-2xl leading-[1.2] font-medium tracking-[-0.02em] text-balance md:text-3xl lg:text-[2.5rem]"
                    data-wh-content={`home.problems.${index}.title`}
                  >
                    {item.title}
                  </h3>
                  <p
                    class="mt-6 max-w-[42.25rem] text-lg leading-[1.35] text-muted-foreground md:mt-8 md:text-xl"
                    data-wh-content={`home.problems.${index}.body`}
                  >
                    {item.body}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* What we build*/}
  <section class="wh-container my-10 lg:my-20">
    <div class="relative border-t border-border pt-10 lg:pt-20">
      <h2 id="services-title" class="wh-h2 mt-5 mb-5 lg:absolute lg:left-0 lg:mb-10">
        What we build
      </h2>

      <div class="mx-auto w-full max-w-3xl lg:max-w-2xl lg:px-8">
        <ol class="wh-services-list [&>li:last-child>a]:border-b-0">
          {
            SERVICE_PILLARS.map((pillar, index) => {
              const match = pillars.find((s) => s.data.pillar === pillar)
              const href = match ? `/services/${match.id}` : '/services'
              return (
                <li class="wh-service-row">
                  <a href={href} class="wh-sweep group relative flex border-b border-border py-5">
                    <span
                      aria-hidden="true"
                      class="mt-0.5 mr-5 flex size-10 flex-none items-center justify-center overflow-hidden rounded-full bg-foreground text-base text-background tabular-nums"
                    >
                      {index + 1}
                    </span>
                    <span class="mr-4 flex-1 text-left">
                      <span class="block pt-[5px] text-lg md:text-2xl">
                        <span class="wh-sweep__label">{SERVICE_PILLAR_LABELS[pillar]}</span>
                      </span>
                      <span class="mt-1 block text-sm text-muted-foreground md:text-base">
                        {SERVICE_PILLAR_TAGLINES[pillar]}
                      </span>
                    </span>
                    <span
                      aria-hidden="true"
                      class="mt-0.5 shrink-0 self-start text-xl transition-transform duration-300 group-hover:translate-x-1"
                    >
                      &rarr;
                    </span>
                  </a>
                </li>
              )
            })
          }
        </ol>

        <div class="mt-10 flex flex-wrap gap-3">
          <Button href="/services" variant="primary">See Services</Button>
          <Button href="/get-in-touch" variant="outline">Talk to Us</Button>
        </div>
      </div>
    </div>
  </section>

  {/* Recent work*/}
  <section class="wh-container">
    <h2 id="featured-projects-title" class="wh-h2 mt-20 mb-5 inline-block">Recent work</h2>

    {
      featured.length > 0 ? (
        <Fragment>
          <div class="wh-projects-grid grid pt-16 md:grid-cols-12">
            {featured.map((entry) => (
              <WorkCard
                href={`/work/${entry.id}`}
                client={entry.data.client}
                summary={entry.data.summary}
                stats={entry.data.stats}
              />
            ))}
          </div>
        </Fragment>
      ) : (
        <p class="mt-10 text-muted-foreground">Project content coming soon.</p>
      )
    }

    <div class="mt-12">
      <Button href="/work" variant="outline">See all work</Button>
    </div>
  </section>

  {
    /*    TODO: testimonial section. Two client quotes exist but the text and
    attribution have not been supplied — deliberately not invented. Drop a
    <Testimonial /> here once the real quotes land.
    The stat strip was dropped for launch, per docs/site-copy.md.*/
  }

  {
    /* Closing CTA. Was a hand-rolled copy of CTASection with its own radius,
       padding and heading scale; now the shared component at `lg`.*/
  }
  <CTASection
    size="lg"
    heading="Ready to get some time back?"
    subheading="Tell us what is eating your hours. We will show you what a system built for it looks like."
    ctaLabel="Talk to Us"
    note="A real conversation, not a sales pitch."
  />
</BaseLayout>
