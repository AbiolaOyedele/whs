---
/**
 * Home page.
 *
 * Section layout follows the reference's compiled markup:
 *  1. Full-bleed dark hero, absolute-positioned content blocks.
 *  2. "Why teams come to us" — a 42.7% / 57.3% split with a sticky left column
 *     and bordered article rows on the right.
 *  3. Services — heading pinned left, content in a narrow centred measure.
 *  4. Featured projects — asymmetric 12-column grid (7/5/5/7/7/5).
 *  5. Closing CTA — full-height rounded panel.
 *
 * TODO: all copy on this page is provisional placeholder text.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import WorkCard from '@/components/sections/WorkCard.astro'
import Testimonial from '@/components/sections/Testimonial.astro'
import AnimatedText from '@/components/sections/AnimatedText.astro'
import Button from '@/components/ui/Button.astro'
import { PROCESS_STEPS, SITE } from '@/config/site'
import { SERVICE_PILLAR_LABELS } from '@/content.config'

const [work, services] = await Promise.all([
  getCollection('work', ({ data }) => !data.draft),
  getCollection('services', ({ data }) => !data.draft),
])

const featured = work.filter((e) => e.data.featured).sort((a, b) => a.data.order - b.data.order)
const pillars = services.sort((a, b) => a.data.order - b.data.order)

/** TODO: fictional placeholder names. Replace with real clients before launch. */
const LOGOS = [
  'Northwind Retail',
  'Aeon Logistics',
  'Harbor & Finch',
  'Calder Health',
  'Brightmoor Energy',
  'Tessellate Labs',
]

const painPoints = [
  {
    title: 'Every change waits on a developer',
    body: 'A one-line copy change becomes a ticket, a sprint, and a deploy. Eventually the marketing team stops asking, and the site stops reflecting what the business actually does.',
  },
  {
    title: 'Every brand sits on a different platform',
    body: 'Three acquisitions later there are four CMS licences, four sets of credentials, and nobody who can answer what the estate costs to run each year.',
  },
  {
    title: 'Every year it costs more to run',
    body: 'The licence renews, the plugins drift, the theme forks. Maintenance grows faster than the traffic it supports, and no single change is ever big enough to justify fixing it.',
  },
]
---

<BaseLayout title={SITE.name} description={SITE.description} darkHero>
  <Hero
    variant="home"
    title="Websites your team can actually run."
    subtitle="We audit, design, migrate and run marketing sites for companies whose platform stopped keeping up."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/get-in-touch" variant="accent" size="lg">Talk to us</Button>
      <Button href="/services" variant="outline" size="lg" onDark>See how we work</Button>
    </div>

    <Fragment slot="footer">
      <p class="text-sm font-medium text-white/50">Trusted by teams at</p>
      <ul class="mt-10 grid gap-1 sm:grid-cols-2 md:h-20 lg:mt-[7.75rem]">
        {
          LOGOS.map((name) => (
            <li class="flex items-center text-lg font-medium text-white/85 md:text-xl">{name}</li>
          ))
        }
      </ul>
    </Fragment>
  </Hero>

  <!-- Why teams come to us -->
  <section class="relative overflow-clip rounded-[2rem] bg-background text-foreground">
    <div class="lg:pt-[16.5rem]">
      <div
        class="lg:grid lg:min-h-[57.1875rem] lg:grid-cols-[42.7%_57.3%] lg:border-t lg:border-border"
      >
        <div class="border-b border-border px-5 py-10 md:px-8 lg:border-r lg:border-b-0 lg:py-0">
          <div
            class="flex flex-col justify-between gap-32 lg:sticky lg:top-24 lg:h-[min(calc(100dvh-6rem),100%)] lg:py-10"
          >
            <div>
              <p class="text-sm font-medium tracking-widest text-muted-foreground uppercase">
                Why teams come to us
              </p>
              <AnimatedText>
                <h2 class="wh-h2 mt-5 max-w-[20ch]">
                  The site got big. The platform did not keep up.
                </h2>
              </AnimatedText>
              <p class="mt-6 max-w-prose text-muted-foreground">
                Most of the estates we take on were fine when they were built. They stopped being
                fine when the team grew, the markets multiplied, and nobody owned the platform.
              </p>
            </div>
            <Button href="/services" variant="link">Here is what we would do about it &rarr;</Button
            >
          </div>
        </div>

        <div class="grid">
          {
            painPoints.map((point, index) => (
              <article class="min-h-[24rem] border-b border-border px-5 py-10 last:border-b-0 md:px-8 lg:pt-[2.875rem] lg:pr-8 lg:pl-[7.3vw]">
                <span class="text-sm text-muted-foreground tabular-nums">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-4 text-2xl font-medium tracking-tight md:text-3xl">{point.title}</h3>
                <p class="mt-4 max-w-prose text-muted-foreground">{point.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="wh-container my-10 lg:my-20">
    <div class="relative border-t border-border pt-10 lg:pt-20">
      <h2 id="services-title" class="wh-h2 mt-5 mb-5 lg:absolute lg:left-0 lg:mb-10">Services</h2>

      <div class="mx-auto w-full max-w-3xl lg:max-w-2xl lg:px-8">
        <ol class="wh-services-list">
          {
            PROCESS_STEPS.map((step, index) => {
              const match = pillars.find((s) => SERVICE_PILLAR_LABELS[s.data.pillar] === step)
              const href = match ? `/services/${match.id}` : '/services'
              return (
                <li class="wh-service-row border-b border-border last:border-b-0">
                  <a href={href} class="group flex items-baseline gap-5 py-6 md:py-8">
                    <span class="text-sm text-muted-foreground tabular-nums">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="flex-1 text-2xl leading-snug md:text-[2rem]">
                      <span class="font-medium">{step}.</span>{' '}
                      <span class="text-muted-foreground">
                        {match?.data.summary ?? 'Placeholder — no service maps to this pillar yet.'}
                      </span>
                    </span>
                    <span
                      aria-hidden="true"
                      class="shrink-0 translate-x-0 text-xl transition-transform duration-300 group-hover:translate-x-1"
                    >
                      &rarr;
                    </span>
                  </a>
                </li>
              )
            })
          }
        </ol>

        <div class="mt-10 flex flex-wrap gap-3">
          <Button href="/get-in-touch" variant="primary">Talk to us</Button>
          <Button href="/services" variant="outline">Services overview</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="wh-container">
    <h2 id="featured-projects-title" class="wh-h2 mt-20 mb-5 inline-block">Featured projects</h2>

    <div class="wh-projects-grid grid gap-1 gap-y-10 pt-16 md:grid-cols-12">
      {
        featured.map((entry) => (
          <WorkCard
            href={`/work/${entry.id}`}
            client={entry.data.client}
            summary={entry.data.summary}
            techStack={entry.data.techStack}
            stats={entry.data.stats}
          />
        ))
      }
    </div>

    <div class="mt-12">
      <Button href="/work" variant="outline">All work</Button>
    </div>
  </section>

  <!-- Closing CTA -->
  <div class="mx-auto mt-20 lg:max-w-[92rem] xl:max-w-[100rem]">
    <section
      class="relative flex min-h-svh flex-col justify-around overflow-clip rounded-3xl bg-[#131314] px-5 py-10 text-white md:px-[10vh] lg:py-32"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-[1]"
        style="background: radial-gradient(70rem 40rem at 78% 12%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 62%), linear-gradient(90deg, rgba(19,19,20,0.9) 0%, rgba(19,19,20,0.2) 55%, transparent 100%);"
      >
      </div>

      <div class="relative z-10 max-w-3xl">
        <AnimatedText>
          <h2 class="text-[clamp(2.25rem,6vw,4rem)] leading-[1.1] font-normal tracking-[-0.03em]">
            Your website should not be a mystery to your own team.
          </h2>
        </AnimatedText>
        <p class="mt-6 max-w-[35rem] text-xl text-white/70">
          Tell us where it hurts and we will tell you what we would do about it.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href="/get-in-touch" variant="accent" size="lg">Talk to us</Button>
          <Button href="/work" variant="outline" size="lg" onDark>See the work</Button>
        </div>
      </div>

      {
        featured[0]?.data.testimonial && (
          <div class="relative z-10 mt-20 max-w-2xl border-l border-white/20 pl-6">
            <Testimonial {...featured[0].data.testimonial} onDark />
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
