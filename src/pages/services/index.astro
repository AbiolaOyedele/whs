---
/** Services index — the four pillars, each listing its services. */
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import CTASection from '@/components/sections/CTASection.astro'
import Button from '@/components/ui/Button.astro'
import { breadcrumbSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'
import { SERVICE_PILLARS, SERVICE_PILLAR_LABELS } from '@/content.config'

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
)

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')

const PILLAR_BLURBS: Record<(typeof SERVICE_PILLARS)[number], string> = {
  audit: 'Find out what is actually wrong before anyone proposes a rebuild.',
  design: 'Design systems and page templates the team can extend without us.',
  migrate: 'Move off the platform that is holding you back, without losing search traffic.',
  run: 'Stay fast, current and shipping long after launch.',
}

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Services', url: `${siteUrl}/services` },
  ]),
]
---

<BaseLayout
  title="Services"
  description="WildHands Studios audits, designs, migrates and runs marketing websites. Four pillars, in that order."
  jsonLd={jsonLd}
  darkHero
>
  <Hero
    eyebrow="Services"
    title="Your whole web team."
    subtitle="Auditing, migrating, and running your platform long after launch."
  />

  <div class="wh-container wh-section">
    <div class="space-y-16 md:space-y-24">
      {
        SERVICE_PILLARS.map((pillar, index) => {
          const inPillar = services.filter((s) => s.data.pillar === pillar)
          return (
            <section class="grid gap-8 border-t border-border pt-8 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
              <div>
                <span class="text-xs text-muted-foreground tabular-nums">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h2 class="mt-2 text-3xl font-medium tracking-tight md:text-4xl">
                  {SERVICE_PILLAR_LABELS[pillar]}
                </h2>
                <p class="mt-3 max-w-prose text-muted-foreground">{PILLAR_BLURBS[pillar]}</p>
              </div>

              {inPillar.length > 0 ? (
                <ul class="grid gap-4 sm:grid-cols-2">
                  {inPillar.map((service) => (
                    <li class="relative rounded-xl border border-border bg-card p-5 transition-[transform,box-shadow] duration-200 ease-out focus-within:-translate-y-0.5 focus-within:shadow-md hover:-translate-y-0.5 hover:shadow-md">
                      <h3 class="text-lg font-medium">
                        <a
                          href={`/services/${service.id}`}
                          class="wh-sweep inline-flex after:absolute after:inset-0 after:content-['']"
                        >
                          <span class="wh-sweep__label">{service.data.title}</span>
                        </a>
                      </h3>
                      <p class="mt-2 text-sm text-muted-foreground">{service.data.summary}</p>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="self-center text-sm text-muted-foreground">
                  No services published under this pillar yet.
                </p>
              )}
            </section>
          )
        })
      }
    </div>

    <div class="mt-16 flex flex-wrap gap-3">
      <Button href="/get-in-touch" variant="primary" size="lg">Talk to us</Button>
      <Button href="/work" variant="outline" size="lg">See the work</Button>
    </div>
  </div>

  <CTASection />
</BaseLayout>
