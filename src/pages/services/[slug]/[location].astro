---
/**
 * Service × location — the programmatic SEO pages.
 *
 * One route, 3 services × 29 locations = 87 pages. Each carries:
 *   - A title, meta description and H1 that name both the service and the
 *     location, so search engines see the intent match on the page they
 *     will show a searcher.
 *   - A local-context paragraph hand-written per location, so no two pages
 *     read the same. Templated find-and-replace is exactly what Google's
 *     helpful-content system exists to demote.
 *   - A location-specific FAQ answer ("do you work in <place>?").
 *   - LocalBusiness JSON-LD stamped with the location's country, and a
 *     Service node whose `areaServed` is the location itself.
 *
 * The service-side copy comes from the same markdown as `/services/<slug>`
 * — a single source of truth, so a change to what "websites" means
 * ripples through every location page for websites at once.
 */
import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import SectionHeading from '@/components/sections/SectionHeading.astro'
import NumberedList from '@/components/sections/NumberedList.astro'
import FAQAccordion from '@/components/sections/FAQAccordion.astro'
import CTASection from '@/components/sections/CTASection.astro'
import Prose from '@/components/ui/Prose.astro'
import Button from '@/components/ui/Button.astro'
import { breadcrumbSchema, faqPageSchema, localBusinessSchema, serviceSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'
import { PROCESS_STEPS, SITE } from '@/config/site'
import { SERVICE_LOCATIONS, type ServiceLocation } from '@/config/service-locations'

export const getStaticPaths = (async () => {
  const services = await getCollection('services', ({ data }) => !data.draft)
  return services.flatMap((entry) =>
    SERVICE_LOCATIONS.map((location) => ({
      params: { slug: entry.id, location: location.slug },
      props: { entry, location },
    }))
  )
}) satisfies GetStaticPaths

const { entry, location } = Astro.props as {
  entry: Awaited<ReturnType<typeof getCollection<'services'>>>[number]
  location: ServiceLocation
}
const { data } = entry
const { Content } = await render(entry)

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const canonical = `${siteUrl}/services/${entry.id}/${location.slug}`
const parentUrl = `${siteUrl}/services/${entry.id}`

/*
 * Titles and copy are constructed rather than stored per-combo:
 *
 *   - A hand-written string per service × location (87 rows) would drift
 *     the moment a service name changed. The service copy is authoritative
 *     in markdown; the location copy is authoritative in the config.
 *   - The templating is minimal on purpose — just enough to give search
 *     engines the intent-match phrase without generating obviously
 *     find-and-replace prose.
 */
/*
 * The short, composable name of the service — "Websites", "Apps",
 * "Tools & Systems". Used as the base for the H1 and breadcrumbs so
 * the location page reads cleanly. The service's `title` was tuned
 * for its own SEO ("Custom Website Design in Lagos, Nigeria") and does
 * not compose here: "Custom Website Design in Lagos, Nigeria in
 * Lekki, Lagos" is the wrong sentence.
 *
 * `eyebrow` is optional in the schema; a service without one gets a
 * best-guess fallback from the service id (a slug like "apps"
 * capitalised).
 */
const eyebrowLabel =
  data.eyebrow ?? entry.id.charAt(0).toUpperCase() + entry.id.slice(1).replace(/-/g, ' ')
const serviceNoun = eyebrowLabel.toLowerCase()

const heroKicker = `${eyebrowLabel} · ${location.longLabel}`

const pageTitle = `Custom ${serviceNoun} in ${location.longLabel} | ${SITE.name}`

const pageDescription = `${SITE.name} builds custom ${serviceNoun} for businesses in ${location.longLabel}. ${data.summary}`

/*
 * FAQs on this page:
 *   1. The location-specific "do you work here?" up-front — the question
 *      a local searcher actually types, answered directly.
 *   2. The service's own FAQs, so a page landing from search still has
 *      the pricing and process answers a client will ask next.
 */
const localFaq = {
  question: `Do you build ${serviceNoun} for businesses in ${location.label}?`,
  answer: location.faqAnswer,
}
const combinedFaqs = [localFaq, ...data.faqs]

const jsonLd = [
  localBusinessSchema(siteUrl),
  serviceSchema({
    name: `${eyebrowLabel} — ${location.longLabel}`,
    /*
     * The hand-written local context lives here rather than on the
     * page. Google reads Service.description for entity understanding,
     * so the SEO signal is preserved without inflicting a "we work in
     * X because of Y" paragraph on every client who lands here from a
     * different city.
     */
    description: `${pageDescription} ${location.localContext}`,
    url: canonical,
    siteUrl,
  }),
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Services', url: `${siteUrl}/services` },
    { name: eyebrowLabel, url: parentUrl },
    { name: location.label, url: canonical },
  ]),
  faqPageSchema(combinedFaqs),
]

---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd} darkHero>
  <Hero eyebrow={heroKicker} title={`${eyebrowLabel} in ${location.longLabel}`} subtitle={data.summary}>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/get-in-touch" variant="accent" size="lg">Talk to Us</Button>
      <Button href={`/services/${entry.id}`} variant="outline" onDark size="lg">
        More about {eyebrowLabel.toLowerCase()}
      </Button>
    </div>
  </Hero>

  {/* The hand-written local context deliberately does NOT render on the
      page. It rides on the Service JSON-LD's description above, so search
      engines still receive the local signal, but a client landing here
      does not read a paragraph explaining why their own city matters. */}

  <section class="wh-container wh-section">
    <SectionHeading level={2}>Our approach</SectionHeading>
    <p class="mt-5 max-w-[65ch] text-lg text-muted-foreground">{data.definition}</p>
  </section>

  {
    data.includes.length > 0 && (
      <section class="wh-container wh-section">
        <SectionHeading level={2}>What it includes</SectionHeading>
        <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_28rem] lg:items-start">
          <NumberedList items={data.includes} columns={2} />
          {
            data.shipsWith.length > 0 && (
              <aside class="rounded-3xl border border-border bg-card p-8 lg:sticky lg:top-24">
                <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
                  Every build ships with
                </p>
                {/* Two columns so a list of nine reads as a shape rather
                    than a scroll. Long items sit on two lines instead of
                    being clipped by a narrow column. */}
                <ul class="mt-5 grid grid-cols-2 gap-x-5 gap-y-3 text-base">
                  {data.shipsWith.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <span
                        aria-hidden="true"
                        class="mt-1 flex size-5 shrink-0 items-center justify-center rounded-full bg-accent text-accent-foreground"
                      >
                        <svg viewBox="0 0 12 12" class="size-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M2 6.5L5 9.5L10 3.5" />
                        </svg>
                      </span>
                      <span class="leading-snug">{item}</span>
                    </li>
                  ))}
                </ul>
              </aside>
            )
          }
        </div>
      </section>
    )
  }

  {
    data.includes.length === 0 && data.shipsWith.length > 0 && (
      <section class="wh-container wh-section">
        <aside class="rounded-3xl border border-border bg-card p-6 md:max-w-md">
          <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
            Every build ships with
          </p>
          <ul class="mt-4 flex flex-col gap-3 text-base">
            {data.shipsWith.map((item) => (
              <li class="flex items-start gap-3">
                <span
                  aria-hidden="true"
                  class="mt-1 flex size-5 shrink-0 items-center justify-center rounded-full bg-accent text-accent-foreground"
                >
                  <svg viewBox="0 0 12 12" class="size-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 6.5L5 9.5L10 3.5" />
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </aside>
      </section>
    )
  }

  <section class="wh-container wh-section">
    <SectionHeading level={2} eyebrow="Process">How it works.</SectionHeading>
    <ol class="mt-10 grid gap-8 sm:grid-cols-3">
      {
        PROCESS_STEPS.map((step, index) => (
          <li class="border-t border-border pt-5">
            <span class="text-xs text-muted-foreground tabular-nums">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-lg font-medium">{step.title}</h3>
            <p class="mt-2 text-muted-foreground">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wh-container wh-section">
    <Prose>
      <Content />
    </Prose>
  </section>

  {
    data.pricingNote && (
      <section class="wh-container wh-section">
        <SectionHeading level={2}>What it costs</SectionHeading>
        <p class="mt-5 max-w-[65ch] text-muted-foreground">{data.pricingNote}</p>
        <div class="mt-8">
          <Button href="/request-a-quote" variant="accent">Request a quote</Button>
        </div>
      </section>
    )
  }

  <FAQAccordion faqs={combinedFaqs} />

  <CTASection />
</BaseLayout>
