---
/** Apply wizard, step 1 of 3. */
import type { GetStaticPaths } from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import JobApplicationForm from '@/components/forms/JobApplicationForm.tsx'
import WizardSteps from '@/components/sections/WizardSteps.astro'
import { ROLES } from '@/config/roles'

export const getStaticPaths = (() =>
  ROLES.map((role) => ({ params: { role: role.slug }, props: { role } }))) satisfies GetStaticPaths

const { role } = Astro.props
---

<BaseLayout
  title={`Apply for ${role.title}`}
  description={`Apply for the ${role.title} role at WildHands.`}
  noindex
>
  <div class="wh-container pt-28 pb-16 md:pt-36 md:pb-24">
    <div class="max-w-2xl">
      <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
        {role.title}
      </p>
      <h1 class="mt-3 text-3xl font-medium tracking-tight md:text-4xl">Apply</h1>

      <WizardSteps current={1} class="mt-8" />

      <div class="mt-10">
        <JobApplicationForm client:load role={role.title} roleSlug={role.slug} />
      </div>
    </div>
  </div>
</BaseLayout>
