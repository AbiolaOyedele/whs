---
/**
 * Apply wizard, step 2 — a short video response.
 *
 * Recording uses getUserMedia with a plain file-upload fallback, so the step is
 * completable on a browser that blocks camera access or does not support
 * MediaRecorder. The step is also skippable: it should never block an
 * application from being submitted.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import WizardSteps from '@/components/sections/WizardSteps.astro'
import VideoResponse from '@/components/forms/VideoResponse.tsx'
---

<BaseLayout
  title="Short video"
  description="Optional short video response as part of your application."
  noindex
>
  <div class="wh-container pt-28 pb-16 md:pt-36 md:pb-24">
    <div class="max-w-2xl">
      <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">Application</p>
      <h1 class="mt-3 text-3xl font-medium tracking-tight md:text-4xl">
        Tell us about a migration that went wrong.
      </h1>
      <WizardSteps current={2} class="mt-8" />

      <p class="mt-8 text-lg text-muted-foreground">
        Two minutes, unedited, no slides. We are not assessing production quality. We want to hear
        how you think about a project that did not go to plan.
      </p>

      <div class="mt-10">
        <VideoResponse client:load />
      </div>
    </div>
  </div>
</BaseLayout>
