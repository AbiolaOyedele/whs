---
/**
 * Industry landing page. No index route by design — these are cross-linked
 * from services and work, and written for buyer and answer-engine search intent.
 */
import type { GetStaticPaths } from 'astro'
import { getCollection, getEntries } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import SectionHeading from '@/components/sections/SectionHeading.astro'
import NumberedList from '@/components/sections/NumberedList.astro'
import FAQAccordion from '@/components/sections/FAQAccordion.astro'
import AtAGlanceTable from '@/components/sections/AtAGlanceTable.astro'
import Testimonial from '@/components/sections/Testimonial.astro'
import WorkCard from '@/components/sections/WorkCard.astro'
import CTASection from '@/components/sections/CTASection.astro'
import { PROCESS_STEPS } from '@/config/site'
import { breadcrumbSchema, faqPageSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'

export const getStaticPaths = (async () => {
  const industries = await getCollection('industries', ({ data }) => !data.draft)
  return industries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}) satisfies GetStaticPaths

const { entry } = Astro.props
const { data } = entry

const relatedWork = data.relatedWork.length > 0 ? await getEntries(data.relatedWork) : []

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const url = `${siteUrl}/industries/${entry.id}`

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: data.title, url },
  ]),
  ...(data.faqs.length > 0 ? [faqPageSchema(data.faqs)] : []),
]
---

<BaseLayout
  title={data.title}
  description={data.description}
  jsonLd={jsonLd}
  darkHero
  noindex={data.placeholder}
>
  <Hero eyebrow="Industries" title={data.headline} subtitle={data.summary} />

  {
    data.whatWeDo.length > 0 && (
      <section class="wh-container wh-section">
        <SectionHeading level={2}>What we do here</SectionHeading>
        <NumberedList items={data.whatWeDo} columns={2} class="mt-10" />
      </section>
    )
  }

  {
    data.reasons.length > 0 && (
      <section class="wh-container wh-section">
        <SectionHeading level={2}>Why teams in this sector pick us</SectionHeading>
        <NumberedList items={data.reasons} columns={2} class="mt-10" />
      </section>
    )
  }

  {
    data.estateNotes.length > 0 && (
      <section class="wh-container wh-section">
        <SectionHeading level={2}>What makes these estates different</SectionHeading>
        <NumberedList items={data.estateNotes} columns={2} class="mt-10" />
      </section>
    )
  }

  {
    data.testimonial && (
      <section class="wh-container wh-section">
        <Testimonial {...data.testimonial} class="max-w-4xl" />
      </section>
    )
  }

  <section class="wh-container wh-section">
    <SectionHeading level={2} eyebrow="Process">How it starts.</SectionHeading>
    <ol class="mt-10 grid gap-8 sm:grid-cols-3">
      {
        PROCESS_STEPS.map((step, index) => (
          <li class="border-t border-border pt-5">
            <span class="text-xs text-muted-foreground tabular-nums">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-lg font-medium">{step.title}</h3>
            <p class="mt-2 text-muted-foreground">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    relatedWork.length > 0 && (
      <section class="wh-container wh-section">
        <SectionHeading level={2}>Related work</SectionHeading>
        <div class="wh-projects-grid mt-16 grid md:grid-cols-2">
          {relatedWork.map((item) => (
            <WorkCard
              href={`/work/${item.id}`}
              client={item.data.client}
              summary={item.data.summary}
              stats={item.data.stats}
            />
          ))}
        </div>
      </section>
    )
  }

  <FAQAccordion faqs={data.faqs} />
  <AtAGlanceTable rows={data.atAGlance} />
  <CTASection />
</BaseLayout>
