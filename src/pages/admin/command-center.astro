---
/**
 * Command Center.
 *
 * One hub for everything connected to this studio's infrastructure — Rayo,
 * Dory, Planes, Amber, Marque and the shop platform — plus the combined, cross-product view. Replaces five
 * separate nav items: a status card here, a click through to each product's
 * own detailed analytics page (unchanged, still at /admin/rayo etc.), and the
 * combined numbers live on this same page rather than a separate one.
 *
 * Server-rendered, same as every other admin number page here.
 */
import AdminLayout from '@/layouts/AdminLayout.astro'
import FormSelect from '@/components/admin/FormSelect.astro'
import { StatTile } from '@/components/admin/analytics/StatTile'
import { BreakdownBars } from '@/components/admin/analytics/BreakdownBars'
import {
  loadCommandCenter,
  parseCommandCenterRange,
  COMMAND_CENTER_RANGE_LABELS,
} from '@/lib/admin/command-center'

export const prerender = false

const session = Astro.locals.adminSession
const range = parseCommandCenterRange(Astro.url.searchParams.get('range'))
const data = await loadCommandCenter(range)

const numberFormat = new Intl.NumberFormat('en-GB')
const fmt = (value: number): string => numberFormat.format(value)
const windowLabel = COMMAND_CENTER_RANGE_LABELS[range].toLowerCase()

const NOT_OK_COPY: Record<string, string> = {
  'not-configured': 'Not connected yet.',
  unavailable: 'Could not read its schema.',
}
---

<AdminLayout title="Command Center" section="command-center" email={session?.email}>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="wh-h1-compact">Command Center</h1>
      <p class="mt-1 text-muted-foreground">
        Every product on this studio's infrastructure, and the combined picture.
      </p>
    </div>

    <form method="get" class="flex items-end gap-3">
      <div class="flex flex-col gap-1.5">
        <span class="text-sm text-muted-foreground">Window</span>
        <FormSelect
          id="command-center-range"
          name="range"
          label="Window"
          value={range}
          options={(['7d', '30d', '90d', 'all'] as const).map((value) => ({
            value,
            label: COMMAND_CENTER_RANGE_LABELS[value],
          }))}
        />
      </div>
      <noscript>
        <button
          type="submit"
          class="min-h-11 rounded-full bg-primary px-5 text-sm text-primary-foreground transition-colors hover:bg-foreground"
        >
          Apply
        </button>
      </noscript>
    </form>
  </div>

  {/* --- Per-product status -------------------------------------------- */}
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3" aria-label="Connected products">
    {
      data.apps.map((app) => (
        <div class="flex flex-col rounded-3xl border border-border bg-card p-5">
          <h2 class="font-display text-xl">{app.name}</h2>
          <p class="mt-1 text-sm text-muted-foreground">{app.blurb}</p>

          {app.status.ok ? (
            <div class="mt-4 flex items-baseline gap-5">
              <div>
                <p class="font-mono text-2xl leading-none tabular-nums">
                  {fmt(app.status.accountsTotal)}
                </p>
                <p class="mt-1 text-xs text-muted-foreground">Accounts</p>
              </div>
              <div>
                <p class="font-mono text-2xl leading-none tabular-nums">
                  {fmt(app.status.activeLast30d)}
                </p>
                <p class="mt-1 text-xs text-muted-foreground">Active, 30d</p>
              </div>
            </div>
          ) : (
            <p class="mt-4 text-sm text-muted-foreground">
              {NOT_OK_COPY[app.status.reason] ?? 'Not available right now.'}
            </p>
          )}

          <div class="mt-5 flex flex-wrap gap-2">
            <a
              href={app.href}
              class="inline-flex min-h-11 items-center gap-1 rounded-full border border-border px-4 text-sm transition-colors hover:border-foreground"
            >
              Full analytics
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-3.5"
              >
                <path d="m9 18 6-6-6-6" />
              </svg>
            </a>
            <a
              href={app.liveHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-1 rounded-full border border-border px-4 text-sm transition-colors hover:border-foreground"
            >
              Open live
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-3.5"
              >
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </a>
          </div>
        </div>
      ))
    }
  </section>

  {/* --- Combined -------------------------------------------------------- */}
  <h2 class="mt-10 font-display text-xl">Combined</h2>
  <p class="text-sm text-muted-foreground">
    Every connected product together, in {windowLabel}.
  </p>

  <section class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    <StatTile label="Accounts across every product" value={fmt(data.combined.accountsTotal)} />
    <StatTile
      label="Active in the last 30 days"
      value={fmt(data.combined.activeLast30d)}
      hint="Summed across every connected product."
    />
    <StatTile
      label={`New in ${windowLabel}`}
      value={fmt(data.combined.newInRange)}
      hint="Signups for each product; banners made for Amber."
    />
  </section>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <BreakdownBars
      client:visible
      title="Accounts by product"
      rows={data.combined.accountsByProduct}
      emptyMessage="Nothing connected yet."
    />
    <BreakdownBars
      client:visible
      title="Active last 30 days, by product"
      rows={data.combined.activeByProduct}
      emptyMessage="Nothing connected yet."
    />
  </div>
</AdminLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('form[method="get"]')
  const select = document.querySelector<HTMLInputElement>('input[name="range"]')
  if (form && select) {
    const observer = new MutationObserver(() => form.submit())
    observer.observe(select, { attributes: true, attributeFilter: ['value'] })
  }
</script>
