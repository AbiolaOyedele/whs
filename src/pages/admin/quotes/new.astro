---
/**
 * Create a quote.
 *
 * Server-handled POST, so the PIN can be rendered once on the response and
 * never travels through client JavaScript or sits in a fetch result. It cannot
 * be recovered afterwards — only replaced — so this page shows it prominently
 * and says exactly that.
 */
import AdminLayout from '@/layouts/AdminLayout.astro'
import FormSelect from '@/components/admin/FormSelect.astro'
import { publicEnv } from '@/config/env'
import { assertAdminOrigin } from '@/lib/admin/auth'
import { createQuote } from '@/lib/admin/quotes'
import { isAppError } from '@/lib/errors'
import { CURRENCIES } from '@/types/quote'

export const prerender = false

const session = Astro.locals.adminSession

let error: string | null = null
let created: { id: string; slug: string; pin: string } | null = null
let clientName = ''
let projectTitle = ''
let currency = 'GBP'

if (Astro.request.method === 'POST' && session) {
  try {
    assertAdminOrigin(Astro.request, publicEnv.PUBLIC_SITE_URL)

    const form = await Astro.request.formData()
    clientName = String(form.get('clientName') ?? '').trim()
    projectTitle = String(form.get('projectTitle') ?? '').trim()
    currency = String(form.get('currency') ?? 'GBP')
    const slug = String(form.get('slug') ?? '')
      .trim()
      .toLowerCase()

    if (!clientName || !projectTitle) {
      error = 'A client name and a project title are both needed.'
    } else {
      created = await createQuote(
        { clientName, projectTitle, currency, slug: slug || undefined },
        session.userId
      )
    }
  } catch (cause) {
    error = isAppError(cause)
      ? cause.message
      : 'Something on our end stopped that from going through. Please try again.'
  }
}

const shareUrl = created
  ? `${publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')}/quote/${created.slug}`
  : ''
---

<AdminLayout title="New quote" section="quotes" email={session?.email}>
  <div class="max-w-2xl">
    {
      created ? (
        <>
          <h1 class="wh-h1-compact mb-2">Quote created</h1>
          <p class="mb-8 text-muted-foreground">
            Send the client both of these. The code is stored hashed, so this is the only time it
            can be shown.
          </p>

          <div class="mb-6 rounded-3xl border border-border bg-card p-6">
            <p class="mb-2 text-sm text-muted-foreground">Their link</p>
            <p class="mb-6 font-mono text-lg break-all">{shareUrl}</p>

            <p class="mb-2 text-sm text-muted-foreground">Their access code</p>
            <p class="font-mono text-4xl tracking-[0.3em]">{created.pin}</p>
          </div>

          <div class="rounded-2xl border border-accent bg-accent/10 p-5">
            <p class="text-base">
              Write the code down now. It cannot be displayed again: if it is lost you can issue a
              new one from the quote, but the old one stops working the moment you do.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={`/admin/quotes/${created.id}`}
              class="inline-flex min-h-12 items-center rounded-full bg-primary px-6 text-base text-primary-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              Build the quote
            </a>
            <a
              href="/admin/quotes"
              class="inline-flex min-h-12 items-center rounded-full border border-border bg-card px-6 text-base transition-colors hover:border-foreground"
            >
              Back to quotes
            </a>
          </div>
        </>
      ) : (
        <>
          <h1 class="wh-h1-compact mb-2">New quote</h1>
          <p class="mb-8 text-muted-foreground">
            Just enough to create it. Everything else is edited afterwards.
          </p>

          {error && (
            <div
              role="alert"
              class="mb-6 rounded-xl border border-destructive/30 bg-destructive/10 px-4 py-3 text-base"
            >
              {error}
            </div>
          )}

          <form method="post" class="flex flex-col gap-6">
            <div class="flex flex-col gap-2">
              <label for="clientName" class="text-sm text-muted-foreground">
                Client name
              </label>
              <input
                id="clientName"
                name="clientName"
                required
                maxlength="120"
                value={clientName}
                class="min-h-12 rounded-xl border border-border bg-card px-4 text-lg outline-none focus-visible:border-foreground"
              />
            </div>

            <div class="flex flex-col gap-2">
              <label for="projectTitle" class="text-sm text-muted-foreground">
                Project title
              </label>
              <input
                id="projectTitle"
                name="projectTitle"
                required
                maxlength="200"
                value={projectTitle}
                class="min-h-12 rounded-xl border border-border bg-card px-4 text-lg outline-none focus-visible:border-foreground"
              />
            </div>

            <div class="flex flex-col gap-2">
              <span class="text-sm text-muted-foreground">Currency</span>
              <FormSelect
                id="currency"
                name="currency"
                label="Currency"
                value={currency}
                options={CURRENCIES.map((entry) => ({
                  value: entry.code,
                  label: `${entry.code} (${entry.label})`,
                }))}
              />
            </div>

            <div class="flex flex-col gap-2">
              <label for="slug" class="text-sm text-muted-foreground">
                Link ending <span class="text-muted-foreground/60">(optional)</span>
              </label>
              <input
                id="slug"
                name="slug"
                maxlength="80"
                placeholder="Built from the client name if you leave this empty"
                class="min-h-12 rounded-xl border border-border bg-card px-4 text-lg outline-none focus-visible:border-foreground"
              />
              <p class="text-sm text-muted-foreground">
                The quote will live at {publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')}/quote/…
              </p>
            </div>

            <button
              type="submit"
              class="min-h-14 rounded-full bg-primary px-8 text-lg text-primary-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              Create quote
            </button>
          </form>
        </>
      )
    }
  </div>
</AdminLayout>
