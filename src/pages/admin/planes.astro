---
/**
 * Planes, the studio's task-planning product (planes.whstd.com).
 *
 * How the product is doing: accounts, signups, who's active and how much people plan and land,
 * never what any one person is doing. Planes holds people's day, so this page shows counts only:
 * no task titles, no names, no crew tags, no messages.
 *
 * Server-rendered: this is a table of numbers, not an app.
 */
import AdminLayout from '@/layouts/AdminLayout.astro'
import FormSelect from '@/components/admin/FormSelect.astro'
import { fetchPlanesStats, PLANES_RANGE_LABELS, type PlanesRange } from '@/lib/admin/planes-stats'

export const prerender = false

const session = Astro.locals.adminSession

const rangeParam = Astro.url.searchParams.get('range')
const range: PlanesRange = (['24h', '7d', '30d', '90d', 'all'] as const).includes(
  rangeParam as PlanesRange
)
  ? (rangeParam as PlanesRange)
  : '30d'

const result = await fetchPlanesStats(range)

const numberFormat = new Intl.NumberFormat('en-GB')
const fmt = (value: number): string => numberFormat.format(value)
const windowLabel = PLANES_RANGE_LABELS[range].toLowerCase()
---

<AdminLayout title="Planes" section="planes" email={session?.email}>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="wh-h1-compact">Planes</h1>
      <p class="mt-1 text-muted-foreground">
        How the product is being used. Counts only: no task titles, no names.
      </p>
      <a
        href="https://planes.whstd.com"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex min-h-11 items-center gap-1 rounded-full border border-border bg-card px-4 py-1.5 text-sm transition-colors hover:border-foreground"
      >
        Open Planes
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5"
        >
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
    </div>

    <form method="get" class="flex items-end gap-3">
      <div class="flex flex-col gap-1.5">
        <span class="text-sm text-muted-foreground">Window</span>
        <FormSelect
          id="planes-range"
          name="range"
          label="Window"
          value={range}
          options={(['24h', '7d', '30d', '90d', 'all'] as const).map((value) => ({
            value,
            label: PLANES_RANGE_LABELS[value],
          }))}
        />
      </div>
      <noscript>
        <button
          type="submit"
          class="min-h-11 rounded-full bg-primary px-5 text-sm text-primary-foreground transition-colors hover:bg-foreground"
        >
          Apply
        </button>
      </noscript>
    </form>
  </div>

  {
    result.ok ? (
      <>
        {/* --- Headline counts -------------------------------------------- */}
        <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Headline counts">
          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Signed up</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.accounts.total)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              {result.data.accounts.newInRange > 0
                ? `+${fmt(result.data.accounts.newInRange)} in ${windowLabel}`
                : range === 'all'
                  ? 'Since Planes went live.'
                  : 'None new in this window.'}
            </p>
          </div>

          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Active in the last 30 days</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.accounts.activeLast30d)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">Accounts that added a task.</p>
          </div>

          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Notifications on</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.accounts.notificationsOn)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              Accounts with time's-up alerts on a device.
            </p>
          </div>

          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Crew links</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.accounts.crewLinks)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">Pairs of friends connected.</p>
          </div>
        </section>

        {/* --- Usage -------------------------------------------------------- */}
        <h2 class="mt-8 font-display text-xl">What people do</h2>
        <p class="text-sm text-muted-foreground">In {windowLabel}. Counts, never contents.</p>

        <section class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Tasks added</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.usage.tasksAdded)}
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Tasks landed</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.usage.tasksLanded)}
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Timers started</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.usage.timersStarted)}
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Tasks flown to friends</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.usage.tasksPassed)}
            </p>
          </div>
        </section>

        {/* --- Signups sparkline ---------------------------------------- */}
        {result.data.signupSeries.length > 0 && (
          <section class="mt-8 rounded-3xl border border-border bg-card p-5 md:p-6">
            <h2 class="mb-1 font-display text-xl">Signups</h2>
            <p class="mb-4 text-sm text-muted-foreground">
              Each bar is a day. Height is the number of accounts created.
            </p>
            {(() => {
              const points = result.data.signupSeries
              const max = Math.max(...points.map((p) => p.count), 1)
              const width = Math.max(points.length * 12, 200)
              return (
                <svg
                  viewBox={`0 0 ${width} 80`}
                  class="h-24 w-full"
                  role="img"
                  aria-label={`Signups per day for ${windowLabel}`}
                >
                  {points.map((point, index) => {
                    const barWidth = 8
                    const gap = 4
                    const x = index * (barWidth + gap)
                    const h = Math.max((point.count / max) * 72, 2)
                    return (
                      <rect
                        x={x}
                        y={80 - h}
                        width={barWidth}
                        height={h}
                        rx={2}
                        fill="var(--accent)"
                      >
                        <title>{`${point.day}: ${point.count}`}</title>
                      </rect>
                    )
                  })}
                </svg>
              )
            })()}
          </section>
        )}
      </>
    ) : (
      <div class="max-w-2xl rounded-3xl border border-border bg-card p-6 md:p-8">
        {result.reason === 'not-configured' && (
          <>
            <h2 class="mb-3 font-display text-xl">Planes is not connected</h2>
            <p class="text-base text-muted-foreground">
              The admin Supabase project is not configured, so there is no schema to read. See
              /admin/setup.
            </p>
          </>
        )}

        {result.reason === 'unavailable' && (
          <>
            <h2 class="mb-3 font-display text-xl">Could not read the Planes schema</h2>
            <p class="mb-3 text-base text-muted-foreground">
              The `planes` schema is missing or not exposed. Add it under Settings → API → Exposed
              schemas in Supabase, then reload.
            </p>
            {result.detail && (
              <p class="rounded-xl border border-border bg-muted px-3 py-2 font-mono text-sm text-muted-foreground">
                {result.detail}
              </p>
            )}
          </>
        )}
      </div>
    )
  }
</AdminLayout>

{
  /*
  The range picker submits on change with no framework: a plain listener that
  reads the form and navigates. Keeps the whole page zero-JS beyond this.
*/
}
<script>
  const form = document.querySelector<HTMLFormElement>('form[method="get"]')
  const select = document.querySelector<HTMLInputElement>('input[name="range"]')
  if (form && select) {
    const observer = new MutationObserver(() => form.submit())
    observer.observe(select, { attributes: true, attributeFilter: ['value'] })
  }
</script>
