---
/**
 * Rayo, the sibling product.
 *
 * A dashboard for the studio, not the operators of Rayo itself. Answers "how
 * is the product doing?" — how many accounts, how many quotes, how many
 * drafts run — without ever showing what any one account is doing. Never a
 * client name, never a project title, never a specific amount. Aggregate
 * only.
 *
 * Server-rendered: this is a table of numbers, not an app.
 */
import AdminLayout from '@/layouts/AdminLayout.astro'
import FormSelect from '@/components/admin/FormSelect.astro'
import {
  fetchRayoStats,
  RAYO_RANGE_LABELS,
  type RayoRange,
} from '@/lib/admin/rayo-stats'

export const prerender = false

const session = Astro.locals.adminSession

const rangeParam = Astro.url.searchParams.get('range')
const range: RayoRange = (['24h', '7d', '30d', '90d', 'all'] as const).includes(
  rangeParam as RayoRange
)
  ? (rangeParam as RayoRange)
  : '30d'

const result = await fetchRayoStats(range)

const numberFormat = new Intl.NumberFormat('en-GB')
const fmt = (value: number): string => numberFormat.format(value)

/* Sparkline. A crude but honest picture of the signup shape over the range.
   Deliberately not a chart library — this is a strip of bars sized by
   Tailwind classes, and using a library for it would ship a dependency to
   admin only I use. */
const RANGE_STATUS_LABELS: Record<string, string> = {
  draft: 'Drafts',
  sent: 'Sent',
  viewed: 'Viewed',
  accepted: 'Accepted',
  declined: 'Declined',
  expired: 'Expired',
  archived: 'Archived',
}
---

<AdminLayout title="Rayo" section="rayo" email={session?.email}>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="wh-h1-compact">Rayo</h1>
      <p class="mt-1 text-muted-foreground">
        How the product is being used. No client details, no quote contents.
      </p>
      {/*
        Requests deliberately live on their own page because they are personal
        by design — this overview stays aggregate-only. A prominent link,
        not a small tab, so the working queue is one click from the numbers.
      */}
      <a
        href="/admin/rayo/requests"
        class="mt-3 inline-flex min-h-11 items-center gap-1 rounded-full border border-border bg-card px-4 py-1.5 text-sm transition-colors hover:border-foreground"
      >
        Customisation requests
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5"
        >
          <path d="m9 18 6-6-6-6" />
        </svg>
      </a>
    </div>

    {/* The range is a plain form because there is nothing to hydrate. */}
    <form method="get" class="flex items-end gap-3">
      {/* Not a wrapping <label>: FormSelect renders its own sr-only label for
          the trigger, so nesting would double-label the control. The visible
          "Window" is a caption. */}
      <div class="flex flex-col gap-1.5">
        <span class="text-sm text-muted-foreground">Window</span>
        <FormSelect
          id="rayo-range"
          name="range"
          label="Window"
          value={range}
          options={(['24h', '7d', '30d', '90d', 'all'] as const).map((value) => ({
            value,
            label: RAYO_RANGE_LABELS[value],
          }))}
        />
      </div>
      <noscript>
        <button
          type="submit"
          class="min-h-11 rounded-full bg-primary px-5 text-sm text-primary-foreground transition-colors hover:bg-foreground"
        >
          Apply
        </button>
      </noscript>
    </form>
  </div>

  {
    result.ok ? (
      <>
        {/* --- Headline counts -------------------------------------------- */}
        <section
          class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4"
          aria-label="Headline counts"
        >
          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Signed up</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.accounts.total)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              {result.data.accounts.newInRange > 0
                ? `+${fmt(result.data.accounts.newInRange)} in ${RAYO_RANGE_LABELS[range].toLowerCase()}`
                : range === 'all'
                  ? 'Since Rayo went live.'
                  : 'None new in this window.'}
            </p>
          </div>

          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Active in the last 30 days</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.accounts.activeLast30d)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              Accounts that saved or opened something.
            </p>
          </div>

          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Quotes created</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.quotes.total)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              {result.data.quotes.newInRange > 0
                ? `+${fmt(result.data.quotes.newInRange)} in this window.`
                : range === 'all'
                  ? 'Everything ever drafted.'
                  : 'None new in this window.'}
            </p>
          </div>

          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Invoices issued</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.invoices.total)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              {result.data.invoices.newInRange > 0
                ? `+${fmt(result.data.invoices.newInRange)} in this window.`
                : range === 'all'
                  ? 'Everything ever billed.'
                  : 'None new in this window.'}
            </p>
          </div>
        </section>

        {/* --- Quote pipeline -------------------------------------------- */}
        <h2 class="mt-8 font-display text-xl">Quote pipeline</h2>
        <p class="text-sm text-muted-foreground">
          Where every quote sits today. No amounts, no clients.
        </p>

        <section class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Sent, awaiting</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.quotes.sent)}
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Accepted</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.quotes.accepted)}
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Conversion</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {result.data.quotes.sent + result.data.quotes.accepted === 0
                ? '—'
                : `${Math.round(
                    (result.data.quotes.accepted /
                      (result.data.quotes.sent + result.data.quotes.accepted)) *
                      100
                  )}%`}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              Accepted out of everything sent or read.
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">All-time total</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.quotes.total)}
            </p>
          </div>
        </section>

        {/* --- By status breakdown --------------------------------------- */}
        {result.data.quotes.byStatus.length > 0 && (
          <section class="mt-6 overflow-hidden rounded-2xl border border-border bg-card">
            <table class="w-full text-left text-base">
              <thead class="border-b border-border">
                <tr>
                  <th class="px-5 py-3 font-medium text-muted-foreground">Status</th>
                  <th class="px-5 py-3 text-right font-medium text-muted-foreground">Count</th>
                </tr>
              </thead>
              <tbody>
                {result.data.quotes.byStatus.map((row, index) => (
                  <tr
                    class:list={[
                      index === result.data.quotes.byStatus.length - 1
                        ? ''
                        : 'border-b border-border',
                    ]}
                  >
                    <td class="px-5 py-3">
                      {RANGE_STATUS_LABELS[row.status] ?? row.status}
                    </td>
                    <td class="px-5 py-3 text-right font-mono tabular-nums">{fmt(row.count)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )}

        {/* --- Drafter usage --------------------------------------------- */}
        <h2 class="mt-8 font-display text-xl">AI drafter</h2>
        <p class="text-sm text-muted-foreground">
          Usage inside {RAYO_RANGE_LABELS[range].toLowerCase()}.
        </p>

        <section class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Drafts run</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.drafter.draftsInRange)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              Every deducted credit is a draft the model finished.
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Credits topped up</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.drafter.creditsBoughtInRange)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              Bought and granted credits combined.
            </p>
          </div>
        </section>

        {/* --- Signups sparkline ---------------------------------------- */}
        {result.data.signupSeries.length > 0 && (
          <section class="mt-8 rounded-3xl border border-border bg-card p-5 md:p-6">
            <h2 class="mb-1 font-display text-xl">Signups</h2>
            <p class="mb-4 text-sm text-muted-foreground">
              Each bar is a day. Height is the number of accounts created.
            </p>

            {/* Bars are inline SVG so they scale without a chart library. The
                y-axis is not labelled: this is a shape, not a measurement. */}
            {(() => {
              const points = result.data.signupSeries
              const max = Math.max(...points.map((p) => p.count), 1)
              const width = Math.max(points.length * 12, 200)
              return (
                <svg
                  viewBox={`0 0 ${width} 80`}
                  class="h-24 w-full"
                  role="img"
                  aria-label={`Signups per day for ${RAYO_RANGE_LABELS[range].toLowerCase()}`}
                >
                  {points.map((point, index) => {
                    const barWidth = 8
                    const gap = 4
                    const x = index * (barWidth + gap)
                    const h = Math.max((point.count / max) * 72, 2)
                    const y = 80 - h
                    return (
                      <rect
                        x={x}
                        y={y}
                        width={barWidth}
                        height={h}
                        rx={2}
                        fill="var(--accent)"
                      >
                        <title>{`${point.day}: ${point.count}`}</title>
                      </rect>
                    )
                  })}
                </svg>
              )
            })()}
          </section>
        )}
      </>
    ) : (
      <div class="max-w-2xl rounded-3xl border border-border bg-card p-6 md:p-8">
        {result.reason === 'not-configured' && (
          <>
            <h2 class="mb-3 font-display text-xl">Rayo is not connected</h2>
            <p class="text-base text-muted-foreground">
              The admin Supabase project is not configured, so there is no schema to read.
              See /admin/setup.
            </p>
          </>
        )}

        {result.reason === 'unavailable' && (
          <>
            <h2 class="mb-3 font-display text-xl">Could not read the Rayo schema</h2>
            <p class="mb-3 text-base text-muted-foreground">
              The `rayo` schema is missing or not exposed. Add it under Settings → API →
              Exposed schemas in Supabase, then reload.
            </p>
            {result.detail && (
              <p class="rounded-xl border border-border bg-muted px-3 py-2 font-mono text-sm text-muted-foreground">
                {result.detail}
              </p>
            )}
          </>
        )}
      </div>
    )
  }
</AdminLayout>

{/*
  The range picker submits on change with no framework: a plain listener that
  reads the form and navigates. Keeps the whole page zero-JS beyond this.
*/}
<script>
  const form = document.querySelector<HTMLFormElement>('form[method="get"]')
  const select = document.querySelector<HTMLInputElement>('input[name="range"]')
  if (form && select) {
    const observer = new MutationObserver(() => form.submit())
    observer.observe(select, { attributes: true, attributeFilter: ['value'] })
  }
</script>
