---
/**
 * Invoice detail.
 *
 * Preview the PDF as it will actually render (fetched from the same
 * renderer the client would hit), see who was billed and when, and take
 * the actions that belong to an invoice: mark part or all of it paid, or
 * download the PDF.
 *
 * Standalone invoices only for now. A quote-backed invoice still lives on
 * its quote page, where the ledger and the source scope live together —
 * splitting that view here would duplicate context, so this page redirects
 * the operator back to the quote instead.
 */
import AdminLayout from '@/layouts/AdminLayout.astro'
import Icon from '@/components/ui/Icon.astro'
import { getInvoiceById } from '@/lib/admin/repositories/invoices'
import { listPaymentsForInvoice } from '@/lib/admin/repositories/payments'
import { getClient } from '@/lib/admin/repositories/clients'
import { formatMoney } from '@/lib/admin/money'

export const prerender = false

const session = Astro.locals.adminSession
const { id } = Astro.params

const invoice = id ? await getInvoiceById(id) : null
if (!invoice) return Astro.redirect('/admin/invoices')
if (invoice.quoteId) return Astro.redirect(`/admin/quotes/${invoice.quoteId}`)

const [payments, client] = await Promise.all([
  listPaymentsForInvoice(invoice.id),
  invoice.clientId ? getClient(invoice.clientId) : Promise.resolve(null),
])

const settled = payments.filter((p) => p.status === 'paid')
const paidMinor = settled.reduce((sum, p) => sum + p.amountMinor, 0)
const outstandingMinor = Math.max(0, invoice.amountMinor - paidMinor)
const settledInFull = paidMinor >= invoice.amountMinor

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
const money = (minor: number) => formatMoney(minor, invoice.currency)
---

<AdminLayout title={`Invoice ${invoice.number}`} section="invoices" email={session?.email}>
  <a
    href="/admin/invoices"
    class="mb-6 inline-flex min-h-11 items-center text-base text-muted-foreground transition-colors hover:text-foreground"
  >
    <Icon name="arrowLeft" class="mr-2 size-4" />
    All invoices
  </a>

  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="wh-h1-compact">{invoice.number}</h1>
      <p class="mt-1 text-muted-foreground">
        {invoice.snapshot.projectTitle} · Issued {dateFormat.format(new Date(invoice.issuedAt))}
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <a
        href={`/api/v1/admin/invoices/${invoice.id}/pdf?download=1`}
        class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border bg-card px-4 text-base transition-colors hover:border-foreground"
      >
        Download PDF
      </a>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
    {/* PDF preview — an iframe reading the same renderer the client would hit */}
    <section class="rounded-3xl border border-border bg-card p-3 md:p-4">
      <div class="mb-3 flex items-baseline justify-between gap-3 px-2">
        <h2 class="font-display text-lg">Preview</h2>
        <p class="text-sm text-muted-foreground">
          Exactly what a client would see. Reloads with edits.
        </p>
      </div>
      {/* Height chosen so an A4 page fits without excessive whitespace at
         common admin widths. Aspect scales down on mobile.*/}
      <iframe
        title={`Preview of invoice ${invoice.number}`}
        src={`/api/v1/admin/invoices/${invoice.id}/pdf`}
        class="aspect-[210/297] w-full rounded-2xl border border-border bg-background"
      ></iframe>
    </section>

    <aside class="flex flex-col gap-4">
      <section class="rounded-3xl border border-border bg-card p-5">
        <p class="text-sm text-muted-foreground">Total</p>
        <p class="mt-1 font-mono text-3xl leading-none tabular-nums">{money(invoice.amountMinor)}</p>

        <dl class="mt-5 flex flex-col gap-2 border-t border-border pt-4 text-base">
          <div class="flex justify-between gap-3">
            <dt class="text-muted-foreground">Paid</dt>
            <dd class="font-mono tabular-nums">{money(paidMinor)}</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-muted-foreground">Outstanding</dt>
            <dd class="font-mono tabular-nums">{money(outstandingMinor)}</dd>
          </div>
          {
            invoice.dueAt && (
              <div class="flex justify-between gap-3 border-t border-border pt-2">
                <dt class="text-muted-foreground">Due</dt>
                <dd>{dateFormat.format(new Date(invoice.dueAt))}</dd>
              </div>
            )
          }
        </dl>

        {
          settledInFull ? (
            <p class="mt-4 flex min-h-11 items-center justify-center rounded-full border border-accent bg-accent/10 px-4 text-base">
              Settled in full
            </p>
          ) : (
            <form data-mark-paid class="mt-4 flex flex-col gap-2">
              <label class="text-sm text-muted-foreground" for="amount">
                Record a payment
              </label>
              <div class="flex flex-wrap gap-2">
                <input
                  id="amount"
                  name="amount"
                  type="number"
                  step="0.01"
                  min="0"
                  placeholder={(outstandingMinor / 100).toFixed(2)}
                  class="min-h-11 flex-1 rounded-full border border-border bg-background px-4 text-base outline-none focus-visible:border-foreground"
                />
                <button
                  type="submit"
                  data-submit
                  class="min-h-11 rounded-full bg-primary px-5 text-base text-primary-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                >
                  Mark paid
                </button>
              </div>
              <p data-error class="hidden text-sm text-destructive" role="alert"></p>
            </form>
          )
        }
      </section>

      <section class="rounded-3xl border border-border bg-card p-5">
        <h2 class="mb-3 font-display text-lg">Billed to</h2>
        <p class="text-base">{invoice.snapshot.clientName}</p>
        {invoice.snapshot.clientCompany && (
          <p class="text-sm text-muted-foreground">{invoice.snapshot.clientCompany}</p>
        )}
        {invoice.snapshot.clientEmail && (
          <p class="mt-1 text-sm">
            <a class="underline underline-offset-2" href={`mailto:${invoice.snapshot.clientEmail}`}>
              {invoice.snapshot.clientEmail}
            </a>
          </p>
        )}
        {client && (
          <a
            href={`/admin/clients?focus=${client.id}`}
            class="mt-3 inline-flex min-h-11 items-center text-sm underline underline-offset-2"
          >
            Open client
          </a>
        )}
      </section>

      {
        settled.length > 0 && (
          <section class="rounded-3xl border border-border bg-card p-5">
            <h2 class="mb-3 font-display text-lg">Payments</h2>
            <ul class="flex flex-col gap-2">
              {settled.map((payment) => (
                <li class="flex items-baseline justify-between gap-3 border-b border-border pb-2 text-sm last:border-0">
                  <span>
                    {payment.channel === 'manual' ? 'Marked paid' : payment.channel}
                    {payment.paidAt && (
                      <span class="ml-2 text-muted-foreground">
                        {dateFormat.format(new Date(payment.paidAt))}
                      </span>
                    )}
                  </span>
                  <span class="font-mono tabular-nums">{money(payment.amountMinor)}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>
  </div>
</AdminLayout>

<script define:vars={{ invoiceId: invoice.id, outstandingMinor }}>
  /*
    Mark-paid without a page reload of everything: the form posts to the
    existing /api/v1/admin/invoices endpoint, and on success the whole
    page reloads so the PDF preview picks up the new "amount due".
  */
  const form = document.querySelector('[data-mark-paid]')
  const errorEl = form?.querySelector('[data-error]')
  const submit = form?.querySelector('[data-submit]')

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!(form instanceof HTMLFormElement) || !(submit instanceof HTMLButtonElement)) return

    const input = form.querySelector('input[name="amount"]')
    if (!(input instanceof HTMLInputElement)) return

    const raw = input.value.trim()
    const amountMajor = raw ? Number(raw) : outstandingMinor / 100
    if (!Number.isFinite(amountMajor) || amountMajor <= 0) {
      if (errorEl) {
        errorEl.textContent = 'Enter an amount greater than zero.'
        errorEl.classList.remove('hidden')
      }
      return
    }

    const amountMinor = Math.round(amountMajor * 100)
    submit.disabled = true
    submit.textContent = 'Recording…'

    try {
      const response = await fetch(`/api/v1/admin/invoices?id=${invoiceId}&action=mark-paid`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amountMinor, note: '' }),
      })
      const body = await response.json()
      if (!response.ok) {
        if (errorEl) {
          errorEl.textContent = body?.error?.message ?? 'That could not be saved.'
          errorEl.classList.remove('hidden')
        }
        submit.disabled = false
        submit.textContent = 'Mark paid'
        return
      }
      window.location.reload()
    } catch {
      if (errorEl) {
        errorEl.textContent = 'We could not reach the server. Try again.'
        errorEl.classList.remove('hidden')
      }
      submit.disabled = false
      submit.textContent = 'Mark paid'
    }
  })
</script>
