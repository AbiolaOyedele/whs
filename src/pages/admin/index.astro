---
/**
 * Admin overview.
 *
 * A landing screen that answers "what needs me?" rather than a wall of numbers.
 * The three sections each have their own page; this is what is waiting.
 */
import AdminLayout from '@/layouts/AdminLayout.astro'
import { listQuotes } from '@/lib/admin/quotes'
import { formatMoney } from '@/lib/admin/money'
import { QUOTE_STATUS_LABELS } from '@/types/quote'

export const prerender = false

const session = Astro.locals.adminSession
const quotes = await listQuotes()

const drafts = quotes.filter((quote) => quote.status === 'draft')
const awaiting = quotes.filter((quote) => quote.status === 'sent' || quote.status === 'viewed')
const accepted = quotes.filter((quote) => quote.status === 'accepted')

/** Value of everything still in play. Accepted work is no longer a pipeline. */
const pipelineByCurrency = new Map<string, number>()
for (const quote of awaiting) {
  pipelineByCurrency.set(
    quote.currency,
    (pipelineByCurrency.get(quote.currency) ?? 0) + quote.totalMinor
  )
}

const recent = [...quotes]
  .sort((a, b) => Date.parse(b.updatedAt) - Date.parse(a.updatedAt))
  .slice(0, 5)

const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' })

const CARDS = [
  {
    href: '/admin/website',
    title: 'Website',
    body: 'Edit the copy and the brand colours, then publish when you are ready.',
  },
  {
    href: '/admin/analytics',
    title: 'Analytics',
    body: 'Visitors, the pages they read, and where they came from.',
  },
  {
    href: '/admin/quotes',
    title: 'Quotes',
    body: 'Build a quote, price it, and send the client a link with an access code.',
  },
]
---

<AdminLayout title="Overview" section="overview" email={session?.email}>
  <div class="mb-8">
    <h1 class="wh-h3">Overview</h1>
    <p class="mt-1 text-muted-foreground">Everything waiting on you.</p>
  </div>

  <div class="mb-10 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <div class="rounded-2xl border border-border bg-card p-5">
      <p class="text-sm text-muted-foreground">Out with clients</p>
      <p class="mt-2 font-sans text-4xl leading-none tabular-nums">{awaiting.length}</p>
      <p class="mt-3 text-sm text-muted-foreground">
        {
          pipelineByCurrency.size === 0
            ? 'Nothing waiting on a decision.'
            : [...pipelineByCurrency.entries()]
                .map(([currency, total]) => formatMoney(total, currency))
                .join(' · ')
        }
      </p>
    </div>

    <div class="rounded-2xl border border-border bg-card p-5">
      <p class="text-sm text-muted-foreground">Drafts</p>
      <p class="mt-2 font-sans text-4xl leading-none tabular-nums">{drafts.length}</p>
      <p class="mt-3 text-sm text-muted-foreground">
        {drafts.length === 0 ? 'Nothing half-finished.' : 'Not yet sent to anyone.'}
      </p>
    </div>

    <div class="rounded-2xl border border-border bg-card p-5">
      <p class="text-sm text-muted-foreground">Accepted</p>
      <p class="mt-2 font-sans text-4xl leading-none tabular-nums">{accepted.length}</p>
      <p class="mt-3 text-sm text-muted-foreground">Won and ready to start.</p>
    </div>
  </div>

  {
    recent.length > 0 && (
      <section class="mb-10">
        <div class="mb-4 flex items-baseline justify-between gap-4">
          <h2 class="font-display text-xl">Recent quotes</h2>
          <a href="/admin/quotes" class="text-base text-muted-foreground underline">
            See all
          </a>
        </div>

        <ul class="flex flex-col gap-2">
          {recent.map((quote) => (
            <li>
              <a
                href={`/admin/quotes/${quote.id}`}
                class="flex flex-wrap items-baseline justify-between gap-3 rounded-2xl border border-border bg-card px-4 py-4 transition-colors hover:border-foreground"
              >
                <span class="min-w-0">
                  <span class="font-display text-lg">{quote.clientName}</span>
                  <span class="block text-sm text-muted-foreground">{quote.projectTitle}</span>
                </span>
                <span class="flex shrink-0 items-baseline gap-4 text-sm">
                  <span class="text-muted-foreground">{QUOTE_STATUS_LABELS[quote.status]}</span>
                  <span class="font-mono text-base">
                    {formatMoney(quote.totalMinor, quote.currency)}
                  </span>
                  <span class="text-muted-foreground">
                    {dateFormat.format(new Date(quote.updatedAt))}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="grid gap-4 md:grid-cols-3">
    {
      CARDS.map((card) => (
        <a
          href={card.href}
          class="rounded-3xl border border-border bg-card p-6 transition-colors hover:border-foreground"
        >
          <h2 class="mb-2 font-display text-xl">{card.title}</h2>
          <p class="text-base text-muted-foreground">{card.body}</p>
        </a>
      ))
    }
  </div>
</AdminLayout>
