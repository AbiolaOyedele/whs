---
/**
 * Amber, the team banner tool (amber.whstd.com).
 *
 * Who can sign in, the heading lines it rotates through, and how much it is
 * used. Amber keeps no images or wording people type: usage is a count of
 * downloads by template, nothing more.
 */
import AdminLayout from '@/layouts/AdminLayout.astro'
import FormSelect from '@/components/admin/FormSelect.astro'
import AmberPanel from '@/components/admin/amber/AmberPanel'
import { AMBER_RANGE_LABELS, canManageAccounts, loadAmber, parseRange } from '@/lib/admin/amber'
import { AMBER_TEMPLATE_LABELS } from '@/types/amber'

export const prerender = false

const session = Astro.locals.adminSession
const range = parseRange(Astro.url.searchParams.get('range'))
const result = await loadAmber(range)
const canManage = result.ok && canManageAccounts()

const numberFormat = new Intl.NumberFormat('en-GB')
const fmt = (value: number): string => numberFormat.format(value)
const windowLabel = AMBER_RANGE_LABELS[range].toLowerCase()
---

<AdminLayout title="Amber" section="amber" email={session?.email}>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="wh-h1-compact">Amber</h1>
      <p class="mt-1 text-muted-foreground">
        The banner tool for Daash storefronts. Team accounts, headings and usage.
      </p>
      <a
        href="https://amber.whstd.com"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex min-h-11 items-center gap-1 rounded-full border border-border bg-card px-4 py-1.5 text-sm transition-colors hover:border-foreground"
      >
        Open Amber
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5"
        >
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
    </div>

    <form method="get" class="flex items-end gap-3">
      <div class="flex flex-col gap-1.5">
        <span class="text-sm text-muted-foreground">Window</span>
        <FormSelect
          id="amber-range"
          name="range"
          label="Window"
          value={range}
          options={(['7d', '30d', '90d', 'all'] as const).map((value) => ({
            value,
            label: AMBER_RANGE_LABELS[value],
          }))}
        />
      </div>
      <noscript>
        <button
          type="submit"
          class="min-h-11 rounded-full bg-primary px-5 text-sm text-primary-foreground transition-colors hover:bg-foreground"
        >
          Apply
        </button>
      </noscript>
    </form>
  </div>

  {
    result.ok ? (
      <>
        <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Headline counts">
          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Banners made</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.stats.banners)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">In {windowLabel}.</p>
          </div>
          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">All time</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.stats.bannersAllTime)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">Since Amber went live.</p>
          </div>
          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">People making banners</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.stats.activePeople)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              Downloaded at least one, {windowLabel}.
            </p>
          </div>
          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Accounts</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.stats.accounts)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">Switched on.</p>
          </div>
        </section>

        <section class="mt-8 rounded-3xl border border-border bg-card p-5 md:p-6">
          <h2 class="mb-1 font-display text-xl">By template</h2>
          <p class="mb-4 text-sm text-muted-foreground">Downloads in {windowLabel}.</p>
          {(() => {
            const rows = result.data.stats.byTemplate
            const max = Math.max(...rows.map((r) => r.count), 1)
            return (
              <ul class="flex flex-col gap-2">
                {rows.map((row) => (
                  <li class="grid grid-cols-[8rem_1fr_3rem] items-center gap-3 text-sm">
                    <span>{AMBER_TEMPLATE_LABELS[row.template]}</span>
                    <svg
                      viewBox="0 0 100 8"
                      preserveAspectRatio="none"
                      class="h-2 w-full"
                      aria-hidden="true"
                    >
                      <rect width="100" height="8" rx="4" fill="var(--muted)" />
                      <rect
                        width={(row.count / max) * 100}
                        height="8"
                        rx="4"
                        fill="var(--accent)"
                      />
                    </svg>
                    <span class="text-right font-mono tabular-nums">{fmt(row.count)}</span>
                  </li>
                ))}
              </ul>
            )
          })()}
        </section>

        <div class="mt-8">
          <AmberPanel
            client:load
            users={result.data.users}
            headlines={result.data.headlines}
            canManage={canManage}
          />
        </div>
      </>
    ) : (
      <div class="max-w-2xl rounded-3xl border border-border bg-card p-6 md:p-8">
        {result.reason === 'not-configured' && (
          <>
            <h2 class="mb-3 font-display text-xl">Amber is not connected</h2>
            <p class="text-base text-muted-foreground">
              The admin Supabase project is not configured, so there is no schema to read. See
              /admin/setup.
            </p>
          </>
        )}
        {result.reason === 'unavailable' && (
          <>
            <h2 class="mb-3 font-display text-xl">Could not read the Amber schema</h2>
            <p class="mb-3 text-base text-muted-foreground">
              Run Amber’s migration (supabase/migrations/0001_amber.sql in the Amber project) in the
              SQL editor, then add `amber` under Settings → API → Exposed schemas in Supabase and
              reload.
            </p>
            {result.detail && (
              <p class="rounded-xl border border-border bg-muted px-3 py-2 font-mono text-sm text-muted-foreground">
                {result.detail}
              </p>
            )}
          </>
        )}
      </div>
    )
  }
</AdminLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('form[method="get"]')
  const select = document.querySelector<HTMLInputElement>('input[name="range"]')
  if (form && select) {
    const observer = new MutationObserver(() => form.submit())
    observer.observe(select, { attributes: true, attributeFilter: ['value'] })
  }
</script>
