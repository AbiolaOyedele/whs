---
/**
 * Rayo customisation requests.
 *
 * Every submission from the "Request customisation" button in the Rayo
 * sidebar lands here. Personal on purpose — this is the working queue for
 * "reply to this person about this thing", not an aggregate stat.
 *
 * Server-rendered. The list is small (dozens at most, ever) and each row
 * is a link back to an email you'll send by hand.
 */
import AdminLayout from '@/layouts/AdminLayout.astro'
import { fetchRayoRequests, type RayoRequest } from '@/lib/admin/rayo-requests'

export const prerender = false

const session = Astro.locals.adminSession

const result = await fetchRayoRequests()

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
})

const formatDate = (value: string): string => dateFormat.format(new Date(value))

const statusLabel: Record<RayoRequest['status'], string> = {
  new: 'New',
  in_progress: 'In progress',
  closed: 'Closed',
}

const statusClass: Record<RayoRequest['status'], string> = {
  new: 'bg-accent text-accent-foreground',
  in_progress: 'border border-border text-muted-foreground',
  closed: 'bg-muted text-muted-foreground',
}

const buckets = { new: 0, in_progress: 0, closed: 0 }
if (result.ok) {
  for (const row of result.data) buckets[row.status] += 1
}
---

<AdminLayout title="Rayo requests" section="rayo" email={session?.email}>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="wh-h1-compact">Rayo requests</h1>
      <p class="mt-1 text-muted-foreground">
        Customisation requests from the Rayo sidebar. Reply directly to the address on each card.
      </p>
    </div>
    <a
      href="/admin/rayo"
      class="min-h-11 rounded-full border border-border bg-card px-4 py-2 text-sm transition-colors hover:border-foreground"
    >
      Back to overview
    </a>
  </div>

  {
    result.ok ? (
      <>
        <section class="grid gap-3 sm:grid-cols-3" aria-label="Counts">
          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">New</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">{buckets.new}</p>
          </div>
          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">In progress</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">{buckets.in_progress}</p>
          </div>
          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Closed</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">{buckets.closed}</p>
          </div>
        </section>

        {result.data.length === 0 ? (
          <div class="mt-8 rounded-3xl border border-border bg-card p-8 text-center">
            <h2 class="font-display text-xl">No requests yet</h2>
            <p class="mx-auto mt-2 max-w-md text-base text-muted-foreground">
              When a Rayo user asks for customisation from the sidebar, it lands here.
            </p>
          </div>
        ) : (
          <ul class="mt-8 flex flex-col gap-3">
            {result.data.map((row) => (
              <li class="rounded-2xl border border-border bg-card p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span
                        class:list={[
                          'rounded-full px-2.5 py-0.5 text-xs',
                          statusClass[row.status],
                        ]}
                      >
                        {statusLabel[row.status]}
                      </span>
                      <span class="text-sm text-muted-foreground">{formatDate(row.createdAt)}</span>
                    </div>
                    <p class="mt-2 text-base break-words">
                      {row.businessName || row.contactName || 'Unnamed'}
                    </p>
                    <p class="text-sm text-muted-foreground">
                      {row.contactName ? `${row.contactName} · ` : ''}
                      {row.businessEmail ? (
                        <a
                          href={`mailto:${row.businessEmail}`}
                          class="underline hover:text-foreground"
                        >
                          {row.businessEmail}
                        </a>
                      ) : (
                        <span>(no email on account)</span>
                      )}
                      {row.sector && ` · ${row.sector}`}
                    </p>
                  </div>
                </div>

                {row.services.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {row.services.map((service) => (
                      <span class="rounded-full border border-border px-2 py-0.5 text-xs">
                        {service}
                      </span>
                    ))}
                  </div>
                )}

                <p class="mt-4 text-base leading-relaxed whitespace-pre-wrap break-words">
                  {row.message}
                </p>
              </li>
            ))}
          </ul>
        )}
      </>
    ) : (
      <div class="max-w-2xl rounded-3xl border border-border bg-card p-6 md:p-8">
        {result.reason === 'not-configured' && (
          <>
            <h2 class="mb-3 font-display text-xl">Rayo is not connected</h2>
            <p class="text-base text-muted-foreground">
              The admin Supabase project is not configured, so there is no schema to read.
              See /admin/setup.
            </p>
          </>
        )}

        {result.reason === 'unavailable' && (
          <>
            <h2 class="mb-3 font-display text-xl">Could not read Rayo requests</h2>
            <p class="mb-3 text-base text-muted-foreground">
              The `rayo` schema is missing or the `customisation_requests` table has not
              been created yet. Run migration 0008 on the Rayo Supabase project.
            </p>
            {result.detail && (
              <p class="rounded-xl border border-border bg-muted px-3 py-2 font-mono text-sm text-muted-foreground">
                {result.detail}
              </p>
            )}
          </>
        )}
      </div>
    )
  }
</AdminLayout>
