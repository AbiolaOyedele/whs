---
/**
 * Invoices.
 *
 * The ledger: what has been invoiced and what has actually been paid. Paid
 * state is read from the payment records rather than stored on the invoice, so
 * card payments and bank transfers marked off by hand appear the same way.
 *
 * Opening this page also sweeps any payment still sitting at `pending` — this
 * deployment does not receive Paystack's webhook, so a client who paid and then
 * closed the tab is settled here rather than by a delivery we never get. See
 * `src/lib/admin/payment-reconcile.ts`.
 */
import AdminLayout from '@/layouts/AdminLayout.astro'
import InvoicesPanel from '@/components/admin/invoices/InvoicesPanel'
import { listInvoices } from '@/lib/admin/repositories/invoices'
import { sweepStalePayments } from '@/lib/admin/payment-reconcile'

export const prerender = false

const session = Astro.locals.adminSession

// Sweep first, then read: the ledger below derives paid state from these rows,
// so reading first would render figures we are about to correct.
await sweepStalePayments()

const invoices = await listInvoices()
---

<AdminLayout title="Invoices" section="invoices" email={session?.email}>
  <InvoicesPanel client:load invoices={invoices} />
</AdminLayout>
