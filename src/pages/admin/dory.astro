---
/**
 * Dory, the studio's personal-finance product (dory.whstd.com).
 *
 * How the product is doing: accounts, signups, setups and how much people log, never what any
 * one person is doing. Dory holds people's money, so this page shows counts only: no names, no
 * emails, no amounts, no descriptions.
 *
 * Server-rendered: this is a table of numbers, not an app.
 */
import AdminLayout from '@/layouts/AdminLayout.astro'
import FormSelect from '@/components/admin/FormSelect.astro'
import { TrendChart } from '@/components/admin/analytics/TrendChart'
import { BreakdownBars } from '@/components/admin/analytics/BreakdownBars'
import { fetchDoryStats, DORY_RANGE_LABELS, type DoryRange } from '@/lib/admin/dory-stats'

export const prerender = false

const session = Astro.locals.adminSession

const rangeParam = Astro.url.searchParams.get('range')
const range: DoryRange = (['24h', '7d', '30d', '90d', 'all'] as const).includes(
  rangeParam as DoryRange
)
  ? (rangeParam as DoryRange)
  : '30d'

const result = await fetchDoryStats(range)

const numberFormat = new Intl.NumberFormat('en-GB')
const fmt = (value: number): string => numberFormat.format(value)
const windowLabel = DORY_RANGE_LABELS[range].toLowerCase()
---

<AdminLayout title="Dory" section="command-center" email={session?.email}>
  <a
    href="/admin/command-center"
    class="mb-4 inline-flex min-h-11 items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-3.5"
    >
      <path d="M15 18l-6-6 6-6"></path>
    </svg>
    Command Center
  </a>

  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="wh-h1-compact">Dory</h1>
      <p class="mt-1 text-muted-foreground">
        How the product is being used. Counts only: no names, no amounts.
      </p>
      <a
        href="https://dory.whstd.com"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex min-h-11 items-center gap-1 rounded-full border border-border bg-card px-4 py-1.5 text-sm transition-colors hover:border-foreground"
      >
        Open Dory
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5"
        >
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
    </div>

    <form method="get" class="flex items-end gap-3">
      <div class="flex flex-col gap-1.5">
        <span class="text-sm text-muted-foreground">Window</span>
        <FormSelect
          id="dory-range"
          name="range"
          label="Window"
          value={range}
          options={(['24h', '7d', '30d', '90d', 'all'] as const).map((value) => ({
            value,
            label: DORY_RANGE_LABELS[value],
          }))}
        />
      </div>
      <noscript>
        <button
          type="submit"
          class="min-h-11 rounded-full bg-primary px-5 text-sm text-primary-foreground transition-colors hover:bg-foreground"
        >
          Apply
        </button>
      </noscript>
    </form>
  </div>

  {
    result.ok ? (
      <>
        {/* --- Headline counts -------------------------------------------- */}
        <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Headline counts">
          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Signed up</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.accounts.total)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              {result.data.accounts.newInRange > 0
                ? `+${fmt(result.data.accounts.newInRange)} in ${windowLabel}`
                : range === 'all'
                  ? 'Since Dory went live.'
                  : 'None new in this window.'}
            </p>
          </div>

          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Active in the last 30 days</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.accounts.activeLast30d)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              Accounts that logged spending
              {result.data.accounts.total > 0 &&
                ` — ${Math.round((result.data.accounts.activeLast30d / result.data.accounts.total) * 100)}% of everyone who's signed up.`}
            </p>
          </div>

          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Finished setup</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.accounts.setUp)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">Have set up a monthly budget.</p>
          </div>

          <div class="rounded-3xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Allowed in</p>
            <p class="mt-2 font-mono text-3xl leading-none tabular-nums">
              {fmt(result.data.accounts.allowed)}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              Emails on the access list, signed in or not.
            </p>
          </div>
        </section>

        {/* --- Usage -------------------------------------------------------- */}
        <h2 class="mt-8 font-display text-xl">What people log</h2>
        <p class="text-sm text-muted-foreground">
          Created in {windowLabel}. Counts, never amounts.
        </p>

        <section class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Expenses</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.usage.expenses)}
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Shopping trips</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.usage.shoppingTrips)}
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Loans recorded</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.usage.loans)}
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-card p-5">
            <p class="text-sm text-muted-foreground">Subscriptions added</p>
            <p class="mt-2 font-mono text-2xl leading-none tabular-nums">
              {fmt(result.data.usage.subscriptions)}
            </p>
          </div>
        </section>

        <div class="mt-3">
          <BreakdownBars
            client:visible
            title="Usage mix"
            rows={[
              { label: 'Expenses', value: result.data.usage.expenses },
              { label: 'Shopping trips', value: result.data.usage.shoppingTrips },
              { label: 'Loans recorded', value: result.data.usage.loans },
              { label: 'Subscriptions added', value: result.data.usage.subscriptions },
            ]}
            emptyMessage="Nothing logged in this window yet."
          />
        </div>

        {/* --- Trends ------------------------------------------------------- */}
        <h2 class="mt-8 font-display text-xl">Trends</h2>
        <p class="mb-3 text-sm text-muted-foreground">Day by day, over {windowLabel}.</p>

        <div class="grid gap-4 lg:grid-cols-2">
          <TrendChart
            client:visible
            label="Signups"
            unitLabel="signups"
            series={result.data.signupSeries.map((p) => ({ date: p.day, value: p.count }))}
            emptyMessage="No signups recorded in this period yet."
          />
          <TrendChart
            client:visible
            label="Expenses logged"
            unitLabel="expenses"
            series={result.data.usageSeries.map((p) => ({ date: p.day, value: p.count }))}
            emptyMessage="No expenses logged in this period yet."
          />
        </div>

        {/* --- Weekly rhythm -------------------------------------------- */}
        <h2 class="mt-8 font-display text-xl">Weekly rhythm</h2>
        <p class="mb-3 text-sm text-muted-foreground">
          Which day of the week it happens on, summed across {windowLabel}.
        </p>

        <div class="grid gap-4 lg:grid-cols-2">
          <BreakdownBars
            client:visible
            title="Signups by day of week"
            rows={result.data.signupsByWeekday}
            emptyMessage="No signups recorded in this period yet."
          />
          <BreakdownBars
            client:visible
            title="Expenses by day of week"
            rows={result.data.usageByWeekday}
            emptyMessage="No expenses logged in this period yet."
          />
        </div>
      </>
    ) : (
      <div class="max-w-2xl rounded-3xl border border-border bg-card p-6 md:p-8">
        {result.reason === 'not-configured' && (
          <>
            <h2 class="mb-3 font-display text-xl">Dory is not connected</h2>
            <p class="text-base text-muted-foreground">
              The admin Supabase project is not configured, so there is no schema to read. See
              /admin/setup.
            </p>
          </>
        )}

        {result.reason === 'unavailable' && (
          <>
            <h2 class="mb-3 font-display text-xl">Could not read the Dory schema</h2>
            <p class="mb-3 text-base text-muted-foreground">
              The `dory` schema is missing or not exposed. Add it under Settings → API → Exposed
              schemas in Supabase, then reload.
            </p>
            {result.detail && (
              <p class="rounded-xl border border-border bg-muted px-3 py-2 font-mono text-sm text-muted-foreground">
                {result.detail}
              </p>
            )}
          </>
        )}
      </div>
    )
  }
</AdminLayout>

{
  /*
  The range picker submits on change with no framework: a plain listener that
  reads the form and navigates. Keeps the whole page zero-JS beyond this.
*/
}
<script>
  const form = document.querySelector<HTMLFormElement>('form[method="get"]')
  const select = document.querySelector<HTMLInputElement>('input[name="range"]')
  if (form && select) {
    const observer = new MutationObserver(() => form.submit())
    observer.observe(select, { attributes: true, attributeFilter: ['value'] })
  }
</script>
