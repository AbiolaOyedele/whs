---
/**
 * Every v2 page (src/v2/routes.tsx lists them), prerendered one file per
 * path. Existing Astro pages keep priority over this catch-all, so /work,
 * /insights, /services, /admin and the rest are untouched.
 */
import type { GetStaticPaths } from 'astro'
import V2Layout from '@/layouts/V2Layout.astro'
import App from '@v2/App'
import { allPaths, resolveRoute } from '@v2/routes'
import { SCENES } from '@v2/components/layout/SiteChrome'
import { categoryByLabel, postBySlug, postFaqs, type BlogPost } from '@v2/content/blog'
import { getUseCase } from '@v2/content/use-cases'
import { locationBySlug, serviceLocationContent } from '@v2/content/service-locations'
import { articleSchema, breadcrumbSchema, faqPageSchema, localBusinessSchema, serviceSchema, type JsonLd } from '@/lib/seo'
import { publicEnv } from '@/config/env'

export const getStaticPaths = (() =>
  allPaths().map((path) => ({
    params: { v2: path === '/' ? undefined : path.slice(1) },
    props: { path },
  }))) satisfies GetStaticPaths

const { path } = Astro.props
const route = resolveRoute(path)

// The mapping SceneSync uses on the client, applied here too so the first
// paint already has the right scene.
const scene = SCENES[path] ?? 'home'
const template = path === '/about' ? 'about' : 'default'

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')

/**
 * Structured data for an Insights article: the Article itself, its
 * breadcrumb trail and, when it ends with questions, a FAQPage built from the
 * same questions the reader sees. Built here rather than in routes.tsx so the
 * schema helpers stay out of the browser bundle.
 */
function blogPostJsonLd(post: BlogPost): JsonLd[] {
  const url = `${siteUrl}/blog/${post.slug}`
  const studio = { '@type': 'Organization', name: post.author.name, url: `${siteUrl}/` }
  const category = post.categories.map((label) => categoryByLabel(label)).find((found) => found !== undefined)
  const faqs = postFaqs(post)
  return [
    {
      ...articleSchema({
        headline: post.title,
        description: post.excerpt,
        url,
        siteUrl,
        datePublished: new Date(`${post.date}T00:00:00Z`),
        authorName: post.author.name,
      }),
      // The byline is the studio, not a person, and v2 pages carry no
      // separate Organization node for an @id to point at.
      author: studio,
      publisher: studio,
      image: `${siteUrl}${post.photo.src}`,
      inLanguage: 'en-NG',
    },
    breadcrumbSchema([
      { name: 'Home', url: `${siteUrl}/` },
      { name: 'Insights', url: `${siteUrl}/blog` },
      ...(category ? [{ name: category.label, url: `${siteUrl}/blog/category/${category.slug}` }] : []),
      { name: post.title, url },
    ]),
    ...(faqs.length > 0 ? [faqPageSchema(faqs)] : []),
  ]
}

/**
 * Structured data for a service page and its location pages, carried over
 * from the original /services/<service>/<location> pages: the studio as a
 * LocalBusiness, the Service itself, the breadcrumb and the page's questions.
 * On a location page the Service names the place it serves, and its
 * description carries that place's hand-written context, which is written for
 * search engines and deliberately not shown on the page.
 */
function useCaseJsonLd(serviceSlug: string, locationSlug: string | undefined): JsonLd[] {
  const service = getUseCase(serviceSlug)
  if (!service) return []
  const location = locationSlug ? locationBySlug(locationSlug) : undefined
  const content = location ? serviceLocationContent(serviceSlug, location.slug) : service
  if (!content) return []

  const serviceUrl = `${siteUrl}/use-cases/${service.slug}`
  const url = location ? `${serviceUrl}/${location.slug}` : serviceUrl
  const node = serviceSchema({
    name: location ? `${service.label} in ${location.longLabel}` : service.label,
    description: location ? `${content.meta.description} ${location.localContext}` : content.meta.description,
    url,
    siteUrl,
  })

  return [
    localBusinessSchema(siteUrl),
    location
      ? {
          ...node,
          areaServed: {
            '@type': location.kind === 'country' ? 'Country' : location.kind === 'city' ? 'City' : 'Place',
            name: location.longLabel,
            address: { '@type': 'PostalAddress', addressCountry: location.countryCode },
          },
        }
      : node,
    breadcrumbSchema([
      { name: 'Home', url: `${siteUrl}/` },
      { name: service.label, url: serviceUrl },
      ...(location ? [{ name: location.label, url }] : []),
    ]),
    ...(content.faqs.length > 0 ? [faqPageSchema(content.faqs)] : []),
  ]
}

const postSlug = /^\/blog\/([^/]+)$/.exec(path)?.[1]
const post = postSlug ? postBySlug(postSlug) : undefined
const useCase = /^\/use-cases\/([^/]+)(?:\/([^/]+))?$/.exec(path)
const jsonLd: JsonLd[] = post
  ? blogPostJsonLd(post)
  : useCase?.[1]
    ? useCaseJsonLd(useCase[1], useCase[2])
    : []
---

<V2Layout
  title={route.title}
  description={route.description}
  scene={scene}
  template={template}
  jsonLd={jsonLd}
  noindex={route.noindex ?? false}
>
  <App client:load path={path} />
</V2Layout>
