---
/** Stack category index — every technology in one category. */
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import CTASection from '@/components/sections/CTASection.astro'
import Tag from '@/components/ui/Tag.astro'
import { breadcrumbSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'
import { STACK_CATEGORIES, STACK_CATEGORY_LABELS } from '@/content.config'

export const getStaticPaths = (async () => {
  const stack = await getCollection('stack', ({ data }) => !data.draft)
  return STACK_CATEGORIES.map((category) => ({
    params: { category },
    props: {
      category,
      entries: stack
        .filter((entry) => entry.data.category === category)
        .sort((a, b) => a.data.order - b.data.order),
    },
  }))
}) satisfies GetStaticPaths

const { category, entries } = Astro.props
const label = STACK_CATEGORY_LABELS[category]

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Stack', url: `${siteUrl}/stack` },
    { name: label, url: `${siteUrl}/stack/${category}` },
  ]),
]
---

<BaseLayout
  title={label}
  description={`The ${label.toLowerCase()} options WildHands Studios works with, with a note on when each one is the wrong fit.`}
  jsonLd={jsonLd}
  darkHero
>
  <Hero
    eyebrow="Stack"
    title={label}
    subtitle={`${entries.length} ${entries.length === 1 ? 'option' : 'options'} we have shipped with.`}
  />

  <div class="wh-container wh-section">
    {
      entries.length === 0 ? (
        <p class="text-muted-foreground">Nothing published in this category yet.</p>
      ) : (
        <ul class="grid gap-4 md:grid-cols-2">
          {entries.map((entry) => (
            <li class="relative rounded-xl border border-border bg-card p-6 transition-[transform,box-shadow] duration-200 ease-out focus-within:-translate-y-0.5 focus-within:shadow-md hover:-translate-y-0.5 hover:shadow-md">
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-xl font-medium">
                  <a
                    href={`/stack/${category}/${entry.id.split('/').pop()}`}
                    class="wh-sweep inline-flex after:absolute after:inset-0 after:content-['']"
                  >
                    <span class="wh-sweep__label">{entry.data.name}</span>
                  </a>
                </h2>
                {entry.data.recommended && <Tag>Recommended</Tag>}
              </div>
              <p class="mt-3 text-sm text-muted-foreground">{entry.data.positioning}</p>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-10">
      <a href="/stack" class="wh-sweep wh-tap inline-flex items-center text-sm">
        <span class="wh-sweep__label">&larr; All categories</span>
      </a>
    </p>
  </div>

  <CTASection />
</BaseLayout>
