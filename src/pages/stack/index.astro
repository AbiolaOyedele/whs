---
/**
 * Stack hub.
 *
 * Layout follows the reference /stack page: a dark hero with an indented
 * introduction, a two-by-two recommendation grid under hairline category
 * labels, a three-up principles panel, and two-by-two category cards listing
 * what sits in each layer.
 *
 * TODO: docs/site-copy.md lists Stack as still to be written, so the editorial
 * copy here is provisional. The structure is final and the platform data is
 * read from the content collection, so only the strings need swapping.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import AnimatedText from '@/components/sections/AnimatedText.astro'
import Button from '@/components/ui/Button.astro'
import { breadcrumbSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'
import { STACK_CATEGORIES, STACK_CATEGORY_LABELS, type StackCategory } from '@/content.config'

const stack = await getCollection('stack', ({ data }) => !data.draft)
const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Stack', url: `${siteUrl}/stack` },
  ]),
]

/** The question each layer answers, shown on the category cards. */
const CATEGORY_QUESTIONS: Record<StackCategory, string> = {
  cms: 'Where does content live, and can the team actually run it?',
  framework: 'What do we build the front end with?',
  hosting: 'Where does it run, including your own cloud?',
  integrations: 'How does it connect to the tools you already use?',
}

/** TODO: provisional editorial. What we would reach for on a new build. */
const RECOMMENDATIONS: Record<StackCategory, { title: string; body: string }> = {
  cms: {
    title: 'Sanity or Storyblok',
    body: 'Sanity when the content model is unusual and the editing experience has to bend around it. Storyblok when marketing wants visual editing without giving up structure underneath.',
  },
  framework: {
    title: 'Astro',
    body: 'For content-heavy sites it ships almost no JavaScript, so the performance budget holds after launch rather than just at it. Next.js when the surface is app-like: dashboards, logged-in product, heavy interactivity.',
  },
  hosting: {
    title: 'Vercel, or your cloud',
    body: 'Preview deployments and edge delivery suit most builds. Your own AWS, Azure or GCP contract when data residency or procurement says so. That path is first-class, not a compromise.',
  },
  integrations: {
    title: 'Keep what you run',
    body: 'CRM, analytics, billing and internal APIs stay; the stack connects to them. Nothing here is rip-and-replace for its own sake.',
  },
}

/** Where we stand, so the recommendations can be read for what they are. */
const PRINCIPLES = [
  {
    title: 'Exclusive with none',
    body: 'We hold no vendor partnership that pays us to recommend one platform over another.',
  },
  {
    title: 'Paid for work, not referrals',
    body: 'Our revenue is building and running what we ship. The platform choice is your cost, not our income.',
  },
  {
    title: '"Keep what you have" is a real answer',
    body: 'If the honest answer is that your current stack is fine, that is the answer you get.',
  },
]

/** Groups the collection by category and pulls out what each card needs. */
const groups = STACK_CATEGORIES.map((category) => {
  const entries = stack
    .filter((entry) => entry.data.category === category)
    .sort(
      (a, b) =>
        Number(b.data.recommended) - Number(a.data.recommended) || a.data.order - b.data.order
    )
  return {
    category,
    label: STACK_CATEGORY_LABELS[category],
    question: CATEGORY_QUESTIONS[category],
    recommendation: RECOMMENDATIONS[category],
    entries,
    slugFor: (id: string) => `/stack/${category}/${id.split('/').pop()}`,
  }
})
---

<BaseLayout
  title="Stack"
  description="The platforms WildHands Studio builds on, and the reasoning behind each choice. Vendor-agnostic by design."
  jsonLd={jsonLd}
  darkHero
>
  <Hero
    eyebrow="Introduction"
    title="The stack we build on, and the reasoning behind it."
    standfirst="A curated, opinionated reference: CMS, framework, hosting, and the integrations that tie it into your business. Not a directory of everything that exists, and vendor-agnostic by design — the set we actually evaluate, recommend and ship, grouped by the decision each layer answers."
  />

  <!-- If we started today -->
  <section class="wh-container my-10 lg:my-20">
    <div class="mx-auto max-w-4xl">
      <AnimatedText>
        <h2 class="wh-h2 max-w-[16ch]">If we started your build today.</h2>
      </AnimatedText>

      <div class="mt-14 grid gap-x-12 gap-y-14 md:grid-cols-2">
        {
          groups.map((group) => (
            <div>
              <p class="border-t border-border pt-4 text-xs tracking-widest text-muted-foreground uppercase">
                {group.label}
              </p>
              <h3 class="mt-8 text-xl font-medium">{group.recommendation.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
                {group.recommendation.body}
              </p>
              <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
                {group.entries.slice(0, 3).map((entry) => (
                  <li>
                    <a
                      href={group.slugFor(entry.id)}
                      class="wh-sweep wh-tap inline-flex items-center text-sm"
                    >
                      <span class="wh-sweep__label">{entry.data.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <!-- Where we stand -->
      <div class="mt-16 rounded-2xl border border-border p-6 md:p-8">
        <ul class="grid gap-8 md:grid-cols-3">
          {
            PRINCIPLES.map((principle) => (
              <li>
                <h3 class="text-sm font-medium">{principle.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{principle.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Category cards -->
  <section class="wh-container my-10 lg:my-20">
    <div class="grid gap-4 lg:grid-cols-2">
      {
        groups.map((group) => (
          <article class="relative flex flex-col rounded-2xl border border-border bg-card p-6 transition-[transform,box-shadow] duration-200 ease-out focus-within:-translate-y-0.5 focus-within:shadow-md hover:-translate-y-0.5 hover:shadow-md md:p-8">
            <div class="flex items-start justify-between gap-6">
              <div>
                <h2 class="text-2xl font-medium">
                  <a
                    href={`/stack/${group.category}`}
                    class="after:absolute after:inset-0 after:content-['']"
                  >
                    {group.label}
                  </a>
                </h2>
                <p class="mt-3 max-w-[34ch] text-sm text-muted-foreground">{group.question}</p>
              </div>
              <span
                aria-hidden="true"
                class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-accent text-accent-foreground transition-transform duration-300 group-hover:translate-x-0.5"
              >
                &rarr;
              </span>
            </div>

            <p class="mt-8 text-xs text-muted-foreground tabular-nums">
              (1&ndash;{group.entries.length})
            </p>

            <ul class="mt-3 flex flex-wrap gap-2">
              {group.entries.slice(0, 4).map((entry) => (
                <li class="rounded-full border border-border px-3 py-1.5 text-xs">
                  <span class="font-medium">{entry.data.name}</span>
                  <span class="text-muted-foreground"> — {entry.data.positioning}</span>
                </li>
              ))}
              {group.entries.length > 4 && (
                <li class="rounded-full bg-muted px-3 py-1.5 text-xs text-muted-foreground">
                  +{group.entries.length - 4} more
                </li>
              )}
            </ul>

            <p class="mt-6 border-t border-border pt-4 text-xs text-muted-foreground">
              {group.entries.length} {group.entries.length === 1 ? 'platform' : 'platforms'} covered
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Closing CTA, right-aligned as on the reference -->
  <section class="wh-container my-16 lg:my-24">
    <div class="ml-auto max-w-xl">
      <p class="text-sm text-muted-foreground">Not sure which fits?</p>
      <AnimatedText>
        <h2 class="wh-h2 mt-4">Get a reasoned recommendation, not a ranking.</h2>
      </AnimatedText>
      <p class="mt-5 text-muted-foreground">
        On a discovery call we map what you already run, work out what it is costing you in time,
        and put the recommendation in writing — so you can defend the choice internally.
      </p>
      <div class="mt-8">
        <Button href="/get-in-touch" variant="accent">Talk to Us</Button>
      </div>
    </div>
  </section>
</BaseLayout>
