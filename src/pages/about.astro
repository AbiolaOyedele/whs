---
/**
 * About page.
 *
 * Layout follows the reference /about page: a light hero with an eyebrow above
 * a large mission statement, an origin block, a founder quote set over an
 * oversized logo watermark, values as centred hairline rows rather than cards,
 * and a centred closing CTA.
 *
 * TODO: docs/site-copy.md lists About as "next up", so the wording here is
 * provisional. The structure is final; swap the strings when copy lands.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import AnimatedText from '@/components/sections/AnimatedText.astro'
import Button from '@/components/ui/Button.astro'
import Logo from '@/components/ui/Logo.astro'
import { breadcrumbSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'About', url: `${siteUrl}/about` },
  ]),
]

/** TODO: provisional. Values wording pending the copy doc. */
const VALUES = ['Clarity', 'Craft', 'Commitment', 'Candour']
---

<BaseLayout
  title="About"
  description="WildHands builds custom websites, apps, and internal tools for teams done doing repetitive work by hand."
  jsonLd={jsonLd}
>
  <!-- Mission -->
  <section class="relative isolate overflow-hidden">
    <!-- TODO: the reference sets a large abstract render behind this. No
         WildHands asset exists, so this is a soft tonal wash in its place. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10"
      style="background:
        radial-gradient(60rem 40rem at 82% -10%, color-mix(in oklab, var(--accent) 20%, transparent), transparent 60%),
        radial-gradient(50rem 40rem at 5% 20%, rgba(0,0,0,0.05), transparent 62%);"
    >
    </div>

    <div class="wh-container pt-40 pb-20 md:pt-52 md:pb-32">
      <div class="max-w-[46rem] md:ml-[10%]">
        <p class="text-sm text-muted-foreground">Our mission is</p>
        <AnimatedText immediate>
          <h1 class="wh-h1 mt-5">To build systems that give people their time back.</h1>
        </AnimatedText>
      </div>
    </div>
  </section>

  <!-- Origin -->
  <section class="wh-container my-10 lg:my-20">
    <div class="max-w-[46rem] md:ml-[10%]">
      <p class="text-sm text-muted-foreground">Who is behind it</p>
      <AnimatedText>
        <h2 class="mt-5 text-[clamp(1.75rem,4vw,2.75rem)] leading-[1.15] tracking-[-0.025em]">
          We started small, solving one team's repetitive work. Today we build the systems that run
          behind businesses, driven by the same idea.
        </h2>
      </AnimatedText>
      <p class="mt-8 max-w-[38rem] text-muted-foreground">
        Every system we build is judged the same way: how much time it gives back. You can see that
        in <a href="/work" class="underline underline-offset-4">the work we ship</a> and in
        <a href="/services" class="underline underline-offset-4">how we scope a project</a>, from
        first call to launch.
      </p>
    </div>
  </section>

  <!-- Founder quote over the logo watermark -->
  <!--
    On mobile the mark is proportionally far larger than the quote set over it,
    so the glyph strokes land across the first lines and cost real legibility.
    Below md it is scaled down and the section is padded enough for the quote to
    start clear of it; from md up the quote sits over the mark as designed.
  -->
  <section class="relative isolate overflow-hidden pt-40 pb-16 md:py-28">
    <Logo
      variant="mark"
      label=""
      class="pointer-events-none absolute -top-10 left-1/2 -z-10 w-[min(78rem,125%)] -translate-x-1/2 text-foreground/[0.06] md:-top-8 md:w-[min(78rem,150%)]"
    />

    <div class="wh-container">
      <div class="max-w-[42rem] md:ml-[10%]">
        <blockquote class="text-[clamp(1.25rem,2.6vw,1.75rem)] leading-[1.4] tracking-[-0.02em]">
          <p>
            WildHands exists because most teams lose hours every week to work a system could do in
            seconds. We would rather build the system once than watch anyone rebuild the same report
            again.
          </p>
        </blockquote>
        <figcaption class="mt-6 text-sm text-muted-foreground">
          <span class="text-foreground">Abiola Oyedele</span> — Founder
        </figcaption>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="wh-container my-10 lg:my-20">
    <h2 class="wh-h2 text-center">Values</h2>
    <ul class="mx-auto mt-10 max-w-3xl border-t border-border">
      {
        VALUES.map((value) => (
          <li class="border-b border-border py-6 text-center text-lg md:py-8 md:text-xl">
            {value}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Closing CTA -->
  <section class="wh-container my-16 text-center lg:my-24">
    <p class="text-sm text-muted-foreground">Your hours should go into the work only you can do.</p>
    <AnimatedText>
      <h2
        class="mx-auto mt-5 max-w-[18ch] text-[clamp(2rem,5vw,3.5rem)] leading-[1.1] tracking-[-0.03em]"
      >
        Ready to get some time back?
      </h2>
    </AnimatedText>
    <div class="mt-10 flex justify-center">
      <Button href="/get-in-touch" variant="accent" size="lg">Talk to Us</Button>
    </div>
  </section>
</BaseLayout>
