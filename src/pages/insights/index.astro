---
/**
 * Insights hub. All posts render server-side; the category tabs are real links
 * to the category routes rather than a client-side filter, so every listing is
 * crawlable and linkable.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import CTASection from '@/components/sections/CTASection.astro'
import ArticleList from '@/components/sections/ArticleList.astro'
import CategoryTabs from '@/components/sections/CategoryTabs.astro'
import { breadcrumbSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'

const posts = (
  await getCollection('insights', ({ data }) => !data.draft && !data.placeholder)
).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Insights', url: `${siteUrl}/insights` },
  ]),
]
---

<BaseLayout
  title="Insights"
  description="Notes on migrations, platform decisions, design systems and the ordinary work of running a website."
  jsonLd={jsonLd}
  darkHero
>
  <Hero
    eyebrow="Insights"
    title="Notes from the work."
    subtitle="What we have learned shipping migrations, picking platforms and keeping design systems alive."
  />

  <div class="wh-container wh-section">
    {
      /*      No tabs while nothing is published. Five categories that each lead to a
      page saying the same thing is a taxonomy for an empty shelf.*/
    }
    {posts.length > 0 && <CategoryTabs current={null} />}
    <ArticleList posts={posts} class={posts.length > 0 ? 'mt-10' : ''} />
  </div>

  <CTASection />
</BaseLayout>
