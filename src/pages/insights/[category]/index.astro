---
/** Insights category index. */
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import CTASection from '@/components/sections/CTASection.astro'
import ArticleList from '@/components/sections/ArticleList.astro'
import CategoryTabs from '@/components/sections/CategoryTabs.astro'
import { breadcrumbSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'
import { INSIGHT_CATEGORIES, INSIGHT_CATEGORY_LABELS } from '@/content.config'

export const getStaticPaths = (async () => {
  const posts = await getCollection('insights', ({ data }) => !data.draft)
  return INSIGHT_CATEGORIES.map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts
        .filter((post) => post.data.category === category)
        .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()),
    },
  }))
}) satisfies GetStaticPaths

const { category, posts } = Astro.props
const label = INSIGHT_CATEGORY_LABELS[category]

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Insights', url: `${siteUrl}/insights` },
    { name: label, url: `${siteUrl}/insights/${category}` },
  ]),
]
---

<BaseLayout
  title={label}
  description={`WildHands Studios writing on ${label.toLowerCase()}.`}
  jsonLd={jsonLd}
  darkHero
>
  <Hero
    eyebrow="Insights"
    title={label}
    subtitle={`${posts.length} ${posts.length === 1 ? 'article' : 'articles'}.`}
  />

  <div class="wh-container wh-section">
    <CategoryTabs current={category} />
    <ArticleList posts={posts} class="mt-10" />
  </div>

  <CTASection />
</BaseLayout>
