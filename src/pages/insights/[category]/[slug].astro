---
/** Insights article template. */
import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import FAQAccordion from '@/components/sections/FAQAccordion.astro'
import CTASection from '@/components/sections/CTASection.astro'
import Prose from '@/components/ui/Prose.astro'
import ShareRow from '@/components/sections/ShareRow.astro'
import ChecklistCard from '@/components/insights/ChecklistCard'
import SiteCheckDialog from '@/components/insights/SiteCheckDialog'
import Button from '@/components/ui/Button.astro'
import { articleSchema, breadcrumbSchema, faqPageSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'
import { INSIGHT_CATEGORY_LABELS } from '@/content.config'

export const getStaticPaths = (async () => {
  const posts = await getCollection('insights', ({ data }) => !data.draft && !data.placeholder)
  return posts.map((entry) => ({
    params: { category: entry.data.category, slug: entry.id.split('/').pop() ?? entry.id },
    props: { entry },
  }))
}) satisfies GetStaticPaths

const { entry } = Astro.props
const { data } = entry
const { Content } = await render(entry)

const slug = entry.id.split('/').pop() ?? entry.id
const label = INSIGHT_CATEGORY_LABELS[data.category]
const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const url = `${siteUrl}/insights/${data.category}/${slug}`

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

const jsonLd = [
  articleSchema({
    headline: data.title,
    description: data.description,
    url,
    siteUrl,
    datePublished: data.publishDate,
    dateModified: data.updatedDate,
    authorName: data.author.name,
  }),
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Insights', url: `${siteUrl}/insights` },
    { name: label, url: `${siteUrl}/insights/${data.category}` },
    { name: data.title, url },
  ]),
  ...(data.faqs.length > 0 ? [faqPageSchema(data.faqs)] : []),
]
---

<BaseLayout
  title={data.title}
  description={data.description}
  jsonLd={jsonLd}
  ogType="article"
  publishedTime={data.publishDate.toISOString()}
  noindex={data.placeholder}
>
  <article>
    <header class="wh-container pt-28 pb-10 md:pt-36">
      <div class="max-w-3xl">
        <a
          href={`/insights/${data.category}`}
          class="wh-sweep wh-tap inline-flex items-center text-xs font-medium tracking-widest text-muted-foreground uppercase"
        >
          <span class="wh-sweep__label">{label}</span>
        </a>
        <h1 class="mt-4 text-3xl font-medium tracking-tight text-balance md:text-5xl">
          {data.title}
        </h1>
        <p class="mt-5 text-lg text-muted-foreground">{data.description}</p>
        <p class="mt-6 text-sm text-muted-foreground">
          {data.author.name}, {data.author.role} · <time datetime={data.publishDate.toISOString()}>
            {dateFormat.format(data.publishDate)}
          </time> · {data.readTime} min read
        </p>
      </div>
    </header>

    <div class="wh-container wh-section">
      {
        data.checklist.length > 0 ? (
          <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_28rem] lg:items-start lg:gap-14">
            <div class="min-w-0">
              <Prose>
                <Content />
              </Prose>

              {/* Per-article CTA. Copy and destination come from the
                  article's own frontmatter so each piece can speak in
                  the reader's own language. `site-check` opens the URL
                  dialog; `request-quote` links straight to the wizard. */}
              {data.articleCta && (
                <aside class="mt-14 max-w-[65ch] rounded-2xl border border-accent bg-accent/10 p-6 md:p-7">
                  <h2 class="font-display text-xl">{data.articleCta.heading}</h2>
                  <p class="mt-2 text-base text-muted-foreground">{data.articleCta.body}</p>
                  <div class="mt-4">
                    {data.articleCta.kind === 'site-check' ? (
                      <SiteCheckDialog client:load label={data.articleCta.buttonLabel} />
                    ) : (
                      <Button href="/request-a-quote" variant="accent">
                        {data.articleCta.buttonLabel}
                      </Button>
                    )}
                  </div>
                </aside>
              )}

              <ShareRow title={data.title} url={url} class="mt-14 max-w-[65ch]" />

              {data.author.bio && (
                <aside class="mt-10 max-w-[65ch] rounded-xl border border-border bg-muted/40 p-6">
                  <h2 class="text-sm font-medium">{data.author.name}</h2>
                  <p class="text-xs text-muted-foreground">{data.author.role}</p>
                  <p class="mt-3 text-sm text-muted-foreground">{data.author.bio}</p>
                </aside>
              )}
            </div>

            {/* Sticky on desktop so the reader can tick items off as they
                scroll. On mobile the card sits above the article body
                instead, because a sticky element on a phone tends to
                cover the content the reader is trying to read. */}
            <div class="order-first lg:order-last lg:sticky lg:top-24">
              <ChecklistCard client:load slug={slug} sections={data.checklist} />
            </div>
          </div>
        ) : (
          <>
            <Prose>
              <Content />
            </Prose>

            {data.articleCta && (
              <aside class="mt-14 max-w-[65ch] rounded-2xl border border-accent bg-accent/10 p-6 md:p-7">
                <h2 class="font-display text-xl">{data.articleCta.heading}</h2>
                <p class="mt-2 text-base text-muted-foreground">{data.articleCta.body}</p>
                <div class="mt-4">
                  {data.articleCta.kind === 'site-check' ? (
                    <SiteCheckDialog client:load label={data.articleCta.buttonLabel} />
                  ) : (
                    <Button href="/request-a-quote" variant="accent">
                      {data.articleCta.buttonLabel}
                    </Button>
                  )}
                </div>
              </aside>
            )}

            <ShareRow title={data.title} url={url} class="mt-14 max-w-[65ch]" />

            {data.author.bio && (
              <aside class="mt-10 max-w-[65ch] rounded-xl border border-border bg-muted/40 p-6">
                <h2 class="text-sm font-medium">{data.author.name}</h2>
                <p class="text-xs text-muted-foreground">{data.author.role}</p>
                <p class="mt-3 text-sm text-muted-foreground">{data.author.bio}</p>
              </aside>
            )}
          </>
        )
      }
    </div>
  </article>

  <FAQAccordion faqs={data.faqs} />
  <CTASection />
</BaseLayout>
