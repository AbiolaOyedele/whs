---
/**
 * Work index with three filter facets.
 *
 * Every card is rendered server-side and stays in the DOM — filtering only
 * toggles a hidden attribute. That keeps the full case-study list readable by
 * crawlers and by anyone without JS, which is the point of building this on
 * Astro at all.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import WorkCard from '@/components/sections/WorkCard.astro'
import FilterSelect from '@/components/ui/FilterSelect.astro'
import CTASection from '@/components/sections/CTASection.astro'
import { breadcrumbSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
)

/** Unique, sorted facet values across every published case study. */
const facetValues = (pick: (entry: (typeof work)[number]) => readonly string[]) =>
  [...new Set(work.flatMap(pick))].sort((a, b) => a.localeCompare(b))

/* `allLabel` is written out rather than derived: appending an "s" to the facet
   name produced "All technologys". */
const facets = [
  {
    key: 'service',
    label: 'Service',
    allLabel: 'All services',
    values: facetValues((e) => e.data.services),
  },
  {
    key: 'tech',
    label: 'Technology',
    allLabel: 'All technologies',
    values: facetValues((e) => e.data.techStack),
  },
  {
    key: 'industry',
    label: 'Type',
    allLabel: 'All types',
    values: facetValues((e) => [e.data.industry]),
  },
] as const

/*
 * Built as one string rather than two adjacent expressions: the newline between
 * `{work.length}` and the pluralised noun collapsed, so the served HTML read
 * "Showing 4projects" until the filter script rewrote it. Shared with that
 * script below so both paths produce the same text.
 */
const countLabel = (n: number) => `Showing ${n} ${n === 1 ? 'project' : 'projects'}`

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Work', url: `${siteUrl}/work` },
  ]),
]
---

<BaseLayout
  title="Work"
  description="Selected work from WildHands: custom apps, internal tools and automation built to take repetitive work off people’s plates."
  jsonLd={jsonLd}
  darkHero
>
  <Hero
    eyebrow="Work"
    title="Selected projects."
    subtitle="Products, tools and internal systems we designed and built end to end."
  />

  <div class="wh-container wh-section" data-work-index>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-sm font-medium tracking-widest text-muted-foreground uppercase">Filter</h2>
      <button
        type="button"
        data-filter-reset
        hidden
        class="wh-tap inline-flex items-center rounded-full border border-border px-4 text-sm transition-colors hover:bg-muted"
      >
        Clear filters
      </button>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {
        facets.map((facet) => (
          <FilterSelect
            id={`filter-${facet.key}`}
            name={facet.key}
            label={facet.label}
            allLabel={facet.allLabel}
            values={facet.values}
          />
        ))
      }
    </div>

    <p class="mt-6 text-sm text-muted-foreground" data-filter-count aria-live="polite">
      {countLabel(work.length)}
    </p>

    <div class="wh-projects-grid mt-16 grid md:grid-cols-12" data-work-grid>
      {
        work.map((entry) => (
          <div
            data-work-item
            data-service={entry.data.services.join('|')}
            data-tech={entry.data.techStack.join('|')}
            data-industry={entry.data.industry}
          >
            <WorkCard
              href={`/work/${entry.id}`}
              client={entry.data.client}
              summary={entry.data.summary}
              techStack={entry.data.techStack}
              stats={entry.data.stats}
            />
          </div>
        ))
      }
    </div>

    <p data-filter-empty hidden class="mt-10 text-center text-muted-foreground">
      No projects match those filters. Try clearing one.
    </p>
  </div>

  <CTASection />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-work-index]')
  if (root) {
    const selects = [...root.querySelectorAll<HTMLElement>('[data-filter-select]')]
    const items = [...root.querySelectorAll<HTMLElement>('[data-work-item]')]
    const count = root.querySelector<HTMLElement>('[data-filter-count]')
    const empty = root.querySelector<HTMLElement>('[data-filter-empty]')
    const reset = root.querySelector<HTMLButtonElement>('[data-filter-reset]')

    const apply = () => {
      const active = selects
        .map((select) => ({
          key: select.dataset['filter'] ?? '',
          value: select.dataset['value'] ?? '',
        }))
        .filter((filter) => filter.value !== '')

      let visible = 0
      items.forEach((item) => {
        const matches = active.every(({ key, value }) =>
          (item.dataset[key] ?? '').split('|').includes(value)
        )
        item.hidden = !matches
        if (matches) visible += 1
      })

      if (count) {
        count.textContent = `Showing ${visible} ${visible === 1 ? 'project' : 'projects'}`
      }
      if (empty) empty.hidden = visible !== 0
      if (reset) reset.hidden = active.length === 0
    }

    selects.forEach((select) => select.addEventListener('filterchange', apply))
    reset?.addEventListener('click', () => {
      selects.forEach((select) => select.dispatchEvent(new CustomEvent('filterreset')))
      apply()
    })
  }
</script>
