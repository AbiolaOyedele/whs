---
/** Contact page. Form succeeds inline; no separate thank-you route. */
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import ContactForm from '@/components/forms/ContactForm.tsx'
import CopyPrompt from '@/components/sections/CopyPrompt.astro'
import LogoMarquee from '@/components/sections/LogoMarquee.astro'
import { SITE } from '@/config/site'
import { breadcrumbSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Get in touch', url: `${siteUrl}/get-in-touch` },
  ]),
]

/** Products WildHands designed and built, not client logos. */
const LOGOS = ['Dumpty', 'Auto Flow', 'Lazy Meet', 'The Ruff Agency']

/** Served by src/pages/agent/prompt.md.ts. */
const agentPromptUrl = `${siteUrl}/agent/prompt.md`
---

<BaseLayout
  title="Get in touch"
  description="Tell WildHands about your website. We reply to every enquiry, usually within one working day."
  jsonLd={jsonLd}
  darkHero
>
  <Hero
    eyebrow="Contact"
    title="Tell us about your website."
    subtitle="What you are running now, and what is not working about it. That is enough to start."
  />

  <!--
    Laid out to the reference's contact page: the pitch and the trust row on the
    left, the agent card stacked above the form on the right. The dark banner
    above stays — it carries the page title, so this column leads with the body
    copy rather than repeating the headline.
  -->
  <div class="wh-container wh-section">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="min-w-0">
        <p class="max-w-[34rem] text-lg leading-relaxed md:text-xl">
          Tell us what is eating your hours: the report someone rebuilds every week, the spreadsheet
          three people maintain, the thing you keep meaning to automate. We read every enquiry and
          reply with a concrete next step, usually within one working day. If you are still working
          out what you need, <a href="/services" class="underline underline-offset-4"
            >what we build</a
          > is the place to start.
        </p>

        <div class="mt-10">
          <h2 class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
            Prefer email?
          </h2>
          <ul class="mt-4 space-y-2 text-sm">
            <li>
              <a
                href={`mailto:${SITE.salesEmail}`}
                class="wh-sweep wh-tap inline-flex items-center"
              >
                <span class="wh-sweep__label">{SITE.salesEmail}</span>
              </a>
              <span class="text-muted-foreground"> &middot; new projects</span>
            </li>
            <li>
              <a href={`mailto:${SITE.hrEmail}`} class="wh-sweep wh-tap inline-flex items-center">
                <span class="wh-sweep__label">{SITE.hrEmail}</span>
              </a>
              <span class="text-muted-foreground"> &middot; hiring and freelance</span>
            </li>
          </ul>
          <p class="mt-4 max-w-prose text-sm text-muted-foreground">
            Running a formal RFP or procurement process? Send it to the sales address and we will
            confirm receipt with a named contact.
          </p>
        </div>

        <div class="mt-12 border-t border-border pt-10">
          <LogoMarquee logos={LOGOS} label="Built by WildHands" duration={40} />
        </div>
      </div>

      <div class="flex min-w-0 flex-col gap-4">
        <CopyPrompt promptUrl={agentPromptUrl} />

        <div class="rounded-3xl bg-card p-5 sm:p-8 lg:p-10">
          <h2 class="sr-only">Contact form</h2>
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
