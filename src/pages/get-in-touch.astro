---
/** Contact page. Form succeeds inline; no separate thank-you route. */
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/sections/Hero.astro'
import ContactForm from '@/components/forms/ContactForm.tsx'
import CopyPrompt from '@/components/sections/CopyPrompt.astro'
import LogoMarquee from '@/components/sections/LogoMarquee.astro'
import { SITE } from '@/config/site'
import { breadcrumbSchema } from '@/lib/seo'
import { publicEnv } from '@/config/env'

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Get in touch', url: `${siteUrl}/get-in-touch` },
  ]),
]

/** Products WildHands designed and built, not client logos. */
const LOGOS = ['Dumpty', 'Auto Flow', 'Lazy Meet', 'The Ruff Agency']

const agentPrompt = `I am looking for a studio to build a custom website, app or internal tool.
Read ${siteUrl}/services and ${siteUrl}/work, then summarise:
1. What WildHands Studio does and does not take on.
2. How they scope and price a project.
3. Two projects most similar to what I need.
Then draft a short enquiry describing my project.`
---

<BaseLayout
  title="Get in touch"
  description="Tell WildHands Studio about your website. We reply to every enquiry, usually within one working day."
  jsonLd={jsonLd}
  darkHero
>
  <Hero
    eyebrow="Contact"
    title="Tell us about your website."
    subtitle="What you are running now, and what is not working about it. That is enough to start."
  />

  <div class="wh-container wh-section">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
      <div>
        <h2 class="sr-only">Contact form</h2>
        <ContactForm client:visible />
      </div>

      <aside class="space-y-10">
        <div>
          <h2 class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
            Prefer email?
          </h2>
          <ul class="mt-4 space-y-2 text-sm">
            <li>
              <a
                href={`mailto:${SITE.salesEmail}`}
                class="wh-sweep wh-tap inline-flex items-center"
              >
                <span class="wh-sweep__label">{SITE.salesEmail}</span>
              </a>
              <span class="text-muted-foreground"> — new projects</span>
            </li>
            <li>
              <a href={`mailto:${SITE.hrEmail}`} class="wh-sweep wh-tap inline-flex items-center">
                <span class="wh-sweep__label">{SITE.hrEmail}</span>
              </a>
              <span class="text-muted-foreground"> — hiring and freelance</span>
            </li>
          </ul>
          <p class="mt-4 max-w-prose text-sm text-muted-foreground">
            Running a formal RFP or procurement process? Send it to the sales address and we will
            confirm receipt with a named contact.
          </p>
        </div>

        <CopyPrompt prompt={agentPrompt} />
      </aside>
    </div>

    <div class="mt-20 border-t border-border pt-10">
      <LogoMarquee logos={LOGOS} label="Built by WildHands" duration={40} />
    </div>
  </div>
</BaseLayout>
