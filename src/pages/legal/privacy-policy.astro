---
/**
 * Privacy policy.
 *
 * Written against what the code actually does, not a template:
 *  - No database. Every form submission is delivered as email through Resend
 *    (src/lib/resend.ts) and lives in the WildHands mailbox.
 *  - CVs are additionally stored in Cloudinary as private, authenticated raw
 *    assets (src/lib/cloudinary.ts), reachable only through an expiring signed
 *    link. Nothing else is written to storage by this site.
 *  - PostHog is consent-gated and configured with `autocapture: false`, so it
 *    records page views, not clicks or form input (PostHogLoader.astro).
 *  - The consent choice and PostHog's identifier are in localStorage, not
 *    cookies (ConsentBanner.astro).
 *  - The rate limiter holds a hashed-free IP key in per-instance memory inside
 *    an expiring window (src/lib/rate-limit.ts).
 *
 * Retention periods and lawful bases below are the positions WildHands has
 * chosen to operate to. They are reasonable and standard, but they are business
 * decisions — if the business changes how it handles enquiries or applications,
 * this page has to change with it.
 *
 * Registered company details come from COMPANY in src/config/site.ts. Fill
 * those in once the company is registered; blank fields are omitted rather than
 * printed as placeholders.
 *
 * Not legal advice. Have a qualified adviser read this before launch.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import Prose from '@/components/ui/Prose.astro'
import { COMPANY, SITE } from '@/config/site'

const updated = '27 August 2026'

/** Purpose → lawful basis, under the UK GDPR. */
const BASES = [
  {
    purpose: 'Replying to an enquiry you send us',
    data: 'Name, email, phone, what you write',
    basis: 'Legitimate interests',
    why: 'You contacted us about working together, and you expect a reply.',
  },
  {
    purpose: 'Assessing a job or freelance application',
    data: 'Name, contact details, profile links, CV, your answers',
    basis: 'Steps prior to a contract',
    why: 'We cannot consider you for work without reading what you sent.',
  },
  {
    purpose: 'Keeping an application on file for future roles',
    data: 'The same application',
    basis: 'Consent',
    why: 'Only if you tick the box. You can withdraw it at any time.',
  },
  {
    purpose: 'Sending the freelance newsletter',
    data: 'Email address',
    basis: 'Consent',
    why: 'You asked for it, and you can tell us to stop at any time.',
  },
  {
    purpose: 'Understanding which pages are useful',
    data: 'Page views, browser and country',
    basis: 'Consent',
    why: 'Analytics stay switched off unless you accept them.',
  },
] as const

const RETENTION = [
  {
    what: 'Enquiries sent through the contact form',
    how: '24 months from your last message to us',
  },
  { what: 'Applications for a role we advertised', how: '12 months from the decision' },
  {
    what: 'Applications you asked us to keep on file',
    how: '24 months, then we ask again or delete',
  },
  { what: 'CVs, stored as private files', how: 'Deleted with the application they arrived with' },
  { what: 'Newsletter subscriptions', how: 'Until you unsubscribe' },
  { what: 'Analytics', how: '12 months, then aggregated' },
] as const
---

<BaseLayout
  title="Privacy Policy"
  description="What WildHands collects, why, how long we keep it, and how to get it deleted."
>
  <div class="wh-container pt-36 pb-16 md:pt-44 md:pb-24">
    <div class="max-w-[68ch]">
      <h1 class="wh-h1-page">Privacy Policy</h1>
      <p class="mt-5 text-sm text-muted-foreground">Last updated {updated}</p>

      <!-- The short version, for anyone who will not read the whole thing. -->
      <div class="mt-10 rounded-2xl border border-border bg-card p-6 md:p-8">
        <h2 class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
          The short version
        </h2>
        <ul class="mt-4 space-y-3 text-base">
          <li>
            We collect what you type into our forms, and nothing else unless you accept analytics.
          </li>
          <li>
            We do not run a database of you. Submissions arrive as email; a CV is also filed
            privately so we can read it again.
          </li>
          <li>We do not sell your data, and we do not use it for advertising.</li>
          <li>The site sets no cookies at all until you make a choice in the banner.</li>
          <li>
            Email <a href={`mailto:${SITE.email}`} class="underline underline-offset-4">
              {SITE.email}
            </a> and we will delete everything we hold about you.
          </li>
        </ul>
      </div>

      <Prose class="mt-12">
        <h2>Who we are</h2>
        <p>
          {SITE.legalName} is the data controller for the personal data described on this page. That means
          we decide what is collected and why, and we are responsible for looking after it.
        </p>
        {
          (COMPANY.registeredName || COMPANY.number || COMPANY.address) && (
            <p>
              {COMPANY.registeredName && (
                <Fragment>Registered as {COMPANY.registeredName}. </Fragment>
              )}
              {COMPANY.number && <Fragment>Company number {COMPANY.number}. </Fragment>}
              {COMPANY.address && <Fragment>Registered office: {COMPANY.address}.</Fragment>}
            </p>
          )
        }
        <p>
          For anything about this policy, or to exercise any of the rights below, email{' '}
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. A person reads that address.
        </p>

        <h2>What we collect</h2>
        <p>There are only four ways we end up with your personal data.</p>
        <ul>
          <li>
            <strong>You contact us.</strong> Your name, email address, your phone number if you give one,
            what you write about your project, and how you heard about us if you tell us.
          </li>
          <li>
            <strong>You apply to work with us.</strong> Your name and contact details, links to your professional
            profiles, your CV, and your answers to the application questions. Freelance applications also
            ask where you are resident for tax, what you are available for, and how many hours a month
            you want. Your CV is also stored as a private file so we can read it again during the process;
            everything else stays in the email.
          </li>
          <li>
            <strong>You subscribe to the freelance newsletter.</strong> Your email address.
          </li>
          <li>
            <strong>You accept analytics.</strong> Which pages you visited, roughly where in the world
            you are, and what browser you used. Analytics do not load unless you accept them.
          </li>
        </ul>
        <p>
          We do not ask for anything sensitive, and we would rather you did not send it. Please do
          not put health information, financial details or identity documents into a form on this
          site.
        </p>

        <h2>Why we collect it, and our lawful basis</h2>
        <p>
          Under the UK GDPR we have to have a lawful basis for each thing we do with your data. Here
          is ours, in full.
        </p>
      </Prose>

      <div class="mt-6 overflow-x-auto rounded-xl border border-border">
        <table class="w-full min-w-[44rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-border bg-muted/50">
              <th scope="col" class="p-4 font-medium">What we do</th>
              <th scope="col" class="p-4 font-medium">What that uses</th>
              <th scope="col" class="p-4 font-medium">Lawful basis</th>
              <th scope="col" class="p-4 font-medium">Why that one</th>
            </tr>
          </thead>
          <tbody>
            {
              BASES.map((row) => (
                <tr class="border-b border-border last:border-0">
                  <th scope="row" class="p-4 align-top font-medium">
                    {row.purpose}
                  </th>
                  <td class="p-4 align-top text-muted-foreground">{row.data}</td>
                  <td class="p-4 align-top">{row.basis}</td>
                  <td class="p-4 align-top text-muted-foreground">{row.why}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <Prose class="mt-6">
        <p>
          Where we rely on legitimate interests, we have weighed our interest in running the
          business against your privacy. Replying to an enquiry you chose to send us is not
          something we think you would object to. If you disagree, you can object &mdash; see your
          rights below.
        </p>

        <h2>How long we keep it</h2>
        <p>
          Form submissions arrive as email rather than going into a database, so deletion means
          removing the message and its attachments from our mailbox — and, for an application,
          deleting the stored copy of the CV. These are the periods we work to.
        </p>
      </Prose>

      <div class="mt-6 overflow-x-auto rounded-xl border border-border">
        <table class="w-full min-w-[32rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-border bg-muted/50">
              <th scope="col" class="p-4 font-medium">What</th>
              <th scope="col" class="p-4 font-medium">How long</th>
            </tr>
          </thead>
          <tbody>
            {
              RETENTION.map((row) => (
                <tr class="border-b border-border last:border-0">
                  <th scope="row" class="p-4 align-top font-medium">
                    {row.what}
                  </th>
                  <td class="p-4 align-top text-muted-foreground">{row.how}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <Prose class="mt-6">
        <p>
          If a project starts, the enquiry stops being an enquiry and becomes part of the client
          record, which we keep for as long as the law requires us to keep business records. Ask us
          and we will tell you exactly what we still hold.
        </p>

        <h2>Who else touches it</h2>
        <p>
          Four companies process data on our behalf. Each is bound by a contract that limits them to
          acting on our instructions.
        </p>
        <ul>
          <li>
            <strong>Resend</strong> delivers every form submission to us by email, including any CV you
            attach. Without Resend, the form does not reach anyone.
          </li>
          <li>
            <strong>Cloudinary</strong> stores CVs sent with an application. They are kept as private
            files, not on a public address — reaching one needs a signed link that we generate and that
            expires.
          </li>
          <li>
            <strong>PostHog</strong> processes analytics, and only if you accept them.
          </li>
          <li>
            <strong>Vercel</strong> hosts the site and serves every page. Its access logs record IP addresses
            for a short period as part of running the infrastructure.
          </li>
        </ul>
        <p>
          Nobody else gets your data. We do not sell it, we do not trade it, and we do not hand it
          to advertisers. We would disclose it if a court or the law required us to, and we would
          tell you unless we were forbidden from doing so.
        </p>

        <h2>Where it goes</h2>
        <p>
          Our providers operate internationally, so your data may be processed outside the UK and
          the EEA &mdash; in practice, in the United States. Where that happens it is covered by the
          UK International Data Transfer Addendum and the EU Standard Contractual Clauses, which are
          the safeguards the law provides for exactly this. You can ask us for a copy of the
          relevant terms.
        </p>

        <h2>Cookies, and what we store in your browser</h2>
        <p>
          <strong>This site sets no cookies.</strong> Nothing at all is stored in your browser until you
          choose Accept or Decline in the banner.
        </p>
        <ul>
          <li>
            <strong>Your choice.</strong> We save it in your browser's local storage so we do not ask
            again on every page. Nothing about it is sent to us.
          </li>
          <li>
            <strong>If you accept analytics,</strong> PostHog stores an identifier in local storage so
            that a returning visitor is not counted as a new person. It is switched off entirely if you
            decline, and it never loads before you decide.
          </li>
        </ul>
        <p>
          Analytics here are deliberately narrow. We record page views. We do not record clicks,
          keystrokes, form contents, or session replays.
        </p>
        <p>
          To change your mind, clear this site's data in your browser settings. The banner will
          appear again on your next visit and you can choose differently.
        </p>

        <h2>Keeping it safe</h2>
        <p>
          The site is served only over HTTPS. Form endpoints are rate-limited to make abuse
          expensive, which involves holding your IP address briefly in memory &mdash; it is never
          written to disk and never sent anywhere. Uploaded CVs are checked by file type and size
          and renamed on our side, so a filename can never be used to attack our systems. A stored
          CV is uploaded as a private file, not a public one, so it has no address anyone can guess
          — reaching it needs a signed link that expires. Access to the mailbox holding enquiries is
          limited to the people who need it, and protected by two-factor authentication.
        </p>
        <p>
          No system is perfect. If we ever suffer a breach that puts you at risk, we will tell the
          Information Commissioner's Office within 72 hours and tell you without undue delay.
        </p>

        <h2>Your rights</h2>
        <p>You can ask us to do any of the following, free of charge.</p>
        <ul>
          <li>
            <strong>See it.</strong> Get a copy of everything we hold about you.
          </li>
          <li>
            <strong>Fix it.</strong> Correct anything that is wrong or incomplete.
          </li>
          <li>
            <strong>Delete it.</strong> Have it erased where we have no overriding reason to keep it.
          </li>
          <li>
            <strong>Limit it.</strong> Have us pause using it while a dispute is sorted out.
          </li>
          <li>
            <strong>Object to it.</strong> Tell us to stop, where we are relying on legitimate interests.
          </li>
          <li>
            <strong>Move it.</strong> Get it in a portable format, or have us send it somewhere else.
          </li>
          <li>
            <strong>Withdraw consent.</strong> Where consent is the basis, you can take it back at any
            time. That does not undo anything we did lawfully beforehand.
          </li>
        </ul>
        <p>
          Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. We will reply within one month.
          We may ask you to confirm who you are first, so that we do not hand your data to somebody
          else.
        </p>

        <h2>If you are unhappy</h2>
        <p>
          Please tell us first &mdash; most things are quicker to fix directly. If we do not put it
          right, you have the right to complain to the UK's data protection regulator, the{' '}
          <a href="https://ico.org.uk/make-a-complaint/" rel="noopener noreferrer" target="_blank">
            Information Commissioner's Office
          </a>. Complaining to them does not affect your right to a legal remedy.
        </p>
        <p>
          If you are in the EEA, you can also complain to the supervisory authority where you live
          or work.
        </p>

        <h2>Children</h2>
        <p>
          This site is aimed at businesses and at people looking for professional work. It is not
          intended for anyone under 16, and we do not knowingly collect their data. If you believe a
          child has sent us something, email us and we will delete it.
        </p>

        <h2>Changes to this policy</h2>
        <p>
          When we change how we handle data, we update this page and move the date at the top. If a
          change matters to you &mdash; a new processor, a new purpose &mdash; we will say so
          clearly here rather than burying it.
        </p>

        <h2>Contact</h2>
        <p>
          Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> for anything on this page: questions,
          corrections, deletions, or complaints.
        </p>
      </Prose>
    </div>
  </div>
</BaseLayout>
