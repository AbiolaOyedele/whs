---
/**
 * Last-resort error page.
 *
 * Astro renders this for any on-demand route that throws while rendering, in
 * place of the platform's bare "HTTP ERROR 500" screen. Pages that can fail in
 * a known way handle it themselves (admin pages via the middleware, the quote
 * pages inline); this is only for what slips past them.
 *
 * Standalone on purpose (see StandaloneLayout): no site layout, no content
 * overrides, no database. It has to render when the database is the thing
 * that failed.
 */
import StandaloneLayout from '@/layouts/StandaloneLayout.astro'
import { FlowButton } from '@/components/ui/flow-button'
import { SITE } from '@/config/site'
---

<StandaloneLayout title="Page unavailable">
  <h1 class="wh-h1-compact mb-3 text-balance">This page could not load</h1>
  <p class="mb-8 text-lg text-pretty text-muted-foreground">
    The fault is on our side, not yours. Try again in a moment, or email us if it keeps happening.
  </p>

  <div class="flex flex-wrap gap-3">
    {/* A reload rather than a link: this page is served at whatever URL
        failed, query string included, and that is what should be retried. */}
    <span data-retry>
      <FlowButton text="Try again" variant="accent" arrows={false} />
    </span>
    <FlowButton text="Go to the homepage" href="/" variant="outline" arrows={false} />
    <FlowButton text="Email us" href={`mailto:${SITE.email}`} variant="outline" arrows={false} />
  </div>
</StandaloneLayout>

<script>
  document.querySelector('[data-retry] button')?.addEventListener('click', () => location.reload())
</script>
