---
/**
 * Last-resort error page.
 *
 * Astro renders this for any on-demand route that throws while rendering, in
 * place of the platform's bare "HTTP ERROR 500" screen. Pages that can fail in
 * a known way handle it themselves (admin pages via the middleware, the quote
 * pages inline); this is only for what slips past them.
 *
 * Standalone on purpose: no site layout, no content overrides, no database. It
 * has to render when the database is the thing that failed.
 */
import '@/styles/global.css'
import Logo from '@/components/ui/Logo.astro'
import { SITE } from '@/config/site'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Page unavailable | {SITE.name}</title>
  </head>

  <body class="bg-background text-foreground">
    <main class="flex min-h-svh items-center justify-center px-5 py-12">
      <div class="w-full max-w-md">
        <Logo variant="mark" class="mb-8 h-7 w-auto" label={SITE.name} />

        <h1 class="wh-h1-compact mb-3">This page could not load</h1>
        <p class="mb-8 text-lg text-muted-foreground">
          The fault is on our side, not yours. Try again in a moment, or email us if it keeps
          happening.
        </p>

        <div class="flex flex-wrap gap-3">
          <!-- A reload rather than a link: this page is served at whatever URL
               failed, query string included, and that is what should be retried. -->
          <button
            type="button"
            data-retry
            class="inline-flex min-h-12 cursor-pointer items-center rounded-full bg-primary px-6 text-base text-primary-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            Try again
          </button>
          <a
            href="/"
            class="inline-flex min-h-12 items-center rounded-full border border-border px-6 text-base transition-colors hover:border-foreground"
          >
            Go to the homepage
          </a>
          <a
            href={`mailto:${SITE.email}`}
            class="inline-flex min-h-12 items-center rounded-full border border-border px-6 text-base transition-colors hover:border-foreground"
          >
            Email us
          </a>
        </div>
      </div>
    </main>
    <script>
      document.querySelector('[data-retry]')?.addEventListener('click', () => location.reload())
    </script>
  </body>
</html>
