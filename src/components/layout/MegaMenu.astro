---
/**
 * Desktop mega-menu panel.
 *
 * Geometry taken from the reference's compiled markup:
 *   panel   w-[47.75rem], grid-cols-[repeat(4,9.4375rem)], gap-x-8 gap-y-6, px-8 py-5
 *   column  flex min-h-[15.75rem] flex-col gap-4
 *   label   text-xs, 65% opacity, wrapped in parentheses
 *   link    text-xl / leading-8, full-bleed hover chip via -mx-2 + px-2
 *   all-X   mt-auto, text-base, underlined — pinned to the column foot
 *
 * The surface is a dark frosted panel: 48% primary over a blur(24px) backdrop,
 * 1.25rem radius. Entry scales from 0.96 with the transition suppressed on
 * first paint so it never flashes.
 */
export interface MegaMenuColumn {
  /** Rendered in parentheses, e.g. "CMS" becomes "(CMS)". */
  label: string
  links: ReadonlyArray<{ label: string; href: string }>
  /** Pinned to the bottom of the column. */
  allLink?: { label: string; href: string } | undefined
}

export interface MegaMenuFeature {
  label: string
  body: string
  href: string
  ctaLabel: string
}

interface Props {
  id: string
  columns: readonly MegaMenuColumn[]
  feature?: MegaMenuFeature | undefined
}

const { id, columns, feature } = Astro.props

const linkClass =
  '-mx-2 block w-[calc(100%+1rem)] rounded-lg px-2 py-0 text-xl leading-8 ' +
  'text-white transition-colors hover:bg-white/10 focus-visible:bg-white/10'
---

<div
  id={id}
  data-menu-panel
  hidden
  class="wh-mega absolute top-full left-1/2 z-50 -translate-x-1/2"
>
  <div
    class="grid h-auto w-[47.75rem] max-w-[calc(100vw-4rem)] grid-cols-[repeat(4,9.4375rem)] items-stretch gap-x-8 gap-y-6 px-8 py-5 text-white"
  >
    {
      columns.map((column) => (
        <div class="flex min-h-[15.75rem] flex-col gap-4">
          <p class="text-xs leading-normal text-white/65">({column.label})</p>

          <div class="flex flex-col gap-3">
            {column.links.map((link) => (
              <a href={link.href} class={linkClass}>
                {link.label}
              </a>
            ))}
          </div>

          {column.allLink && (
            <a
              href={column.allLink.href}
              class="mt-auto w-fit rounded-none p-0 text-base leading-8 text-white underline underline-offset-2 hover:bg-transparent"
            >
              {column.allLink.label}
            </a>
          )}
        </div>
      ))
    }

    {
      feature && (
        <a
          href={feature.href}
          class="group col-span-4 flex gap-4 rounded-xl bg-white p-3 text-[#131314] transition-colors hover:bg-white/95"
        >
          {/* Image box is 159x128, per the reference. TODO: real artwork. */}
          <span
            class="hidden h-32 w-[159px] shrink-0 overflow-hidden rounded-[4px] bg-[#f3f3f4] sm:block"
            aria-hidden="true"
          >
            <span
              class="block size-full transition-transform duration-300 group-hover:scale-[1.03]"
              style="background: linear-gradient(135deg, color-mix(in oklab, var(--accent) 45%, white) 0%, color-mix(in oklab, var(--accent) 20%, white) 45%, #e8e8ea 100%);"
            />
          </span>

          <span class="flex min-w-0 flex-col items-start py-1 text-left">
            <span class="text-xs leading-normal font-normal text-[#66646d]">({feature.label})</span>
            <span class="mt-2 max-w-[21rem] text-base leading-normal font-medium text-[#131314]">
              {feature.body}
            </span>
            <span class="mt-auto text-base leading-8 font-medium underline underline-offset-2">
              {feature.ctaLabel}
            </span>
          </span>
        </a>
      )
    }
  </div>
</div>

<style>
  .wh-mega {
    margin-top: 0.5rem;
    border-radius: var(--radius-mega);
    background-color: color-mix(in oklab, var(--primary) 48%, transparent);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    opacity: 0;
    scale: 0.96;
    transition:
      opacity 0.35s var(--ease-mega),
      scale 0.35s var(--ease-mega);
  }

  .wh-mega[data-open] {
    opacity: 1;
    scale: 1;
  }

  /* No transition on the very first paint, so the panel never flashes in. */
  .wh-mega[data-first-paint] {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .wh-mega {
      transition: none;
      scale: 1;
    }
  }
</style>
