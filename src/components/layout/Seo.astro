---
/**
 * Head metadata: title, description, canonical, Open Graph, Twitter Card, and
 * any JSON-LD the page supplies.
 */
import type { JsonLd } from '@/lib/seo'
import { SITE } from '@/config/site'

interface Props {
  title: string
  description: string
  canonical: string
  /** Excludes the page from indexing — used on thank-you pages and tools. */
  noindex?: boolean
  ogType?: 'website' | 'article'
  publishedTime?: string | undefined
  jsonLd?: readonly JsonLd[]
}

const {
  title,
  description,
  canonical,
  noindex = false,
  ogType = 'website',
  publishedTime,
  jsonLd = [],
} = Astro.props

/** Titles already ending in the site name are not suffixed twice. */
const fullTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_GB" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />

{
  jsonLd.map((node) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(node).replace(/</g, '\\u003c')}
    />
  ))
}
