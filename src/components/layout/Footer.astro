---
/**
 * Site footer.
 *
 * Dark surface. The wordmark is drawn in `currentColor`, so on black it renders
 * white and the lime underline reads properly. On a light ground the same
 * artwork would disappear, which is why the footer band is dark rather than the
 * logo having a second colourway.
 *
 * Link hover is the underline sweep — a 1px gradient line growing from 0% to
 * 100% width. The animated layer is a child span so the sweep tracks the text
 * box rather than the padded 44px tap target.
 */
import AnimatedGradient from '@/components/ui/animated-gradient.tsx'
import Logo from '@/components/ui/Logo.astro'
import { FOOTER_COLUMNS, SITE } from '@/config/site'

const year = new Date().getFullYear()
---

<footer class="relative isolate mt-8 overflow-hidden rounded-t-section bg-surface-dark text-white">
  <AnimatedGradient client:idle preset="footer" className="-z-10" />
  {
    /*    Scrim keeps the link columns legible whatever the gradient is doing. It
    opened at 0.55, which let a lighter pass of the animated gradient through
    and moved the measured contrast of the column headings around under it.*/
  }
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: linear-gradient(180deg, rgba(19,19,20,0.80) 0%, rgba(19,19,20,0.88) 60%, rgba(19,19,20,0.94) 100%);"
  >
  </div>
  <div class="wh-container py-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-3 lg:grid-cols-4">
      <div class="md:col-span-3 lg:col-span-2">
        <Logo variant="full" class="h-16 w-auto text-white" />
        <p class="mt-6 max-w-xs text-white/70">{SITE.tagline}</p>
        <a
          href={`mailto:${SITE.email}`}
          class="wh-sweep wh-tap mt-4 inline-flex items-center text-sm"
        >
          <span class="wh-sweep__label">{SITE.email}</span>
        </a>
      </div>

      {
        FOOTER_COLUMNS.map((column) => (
          <nav aria-label={column.heading}>
            <h2 class="text-xs font-medium tracking-widest text-white/70 uppercase">
              {column.heading}
            </h2>
            <ul class="mt-4 space-y-1">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="wh-sweep wh-footer-link inline-flex items-center text-sm text-white/85 transition-colors hover:text-white"
                    {...(link.href.startsWith('http')
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    <span class="wh-sweep__label">{link.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-white/15 pt-6 text-sm text-white/70 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.legalName}. All rights reserved.</p>
      <a
        href="/legal/privacy-policy"
        class="wh-sweep wh-tap inline-flex items-center transition-colors hover:text-white"
      >
        <span class="wh-sweep__label">Privacy Policy</span>
      </a>
    </div>
  </div>
</footer>
