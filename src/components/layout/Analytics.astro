---
/**
 * Analytics entry point.
 *
 * Nothing loads until the visitor accepts analytics cookies, and nothing loads
 * at all when the PostHog env vars are unset — so a misconfigured deploy is
 * silent rather than broken.
 */
import ConsentBanner from './ConsentBanner.astro'
import PostHogLoader from './PostHogLoader.astro'
import VercelAnalyticsLoader from './VercelAnalyticsLoader.astro'
import { publicEnv } from '@/config/env'

const posthogKey = publicEnv.PUBLIC_POSTHOG_KEY
const host = publicEnv.PUBLIC_POSTHOG_HOST
---

{posthogKey && host && <PostHogLoader posthogKey={posthogKey} host={host} />}

{
  /* Vercel Web Analytics: the source behind /admin/analytics. Cookieless, and
    served from our own origin, but still consent-gated so the banner's promise
    holds. Inert outside a Vercel deployment. */
}
<VercelAnalyticsLoader />

{
  /* First-party beacon: the source the admin's analytics panel reads. Vercel's
    tracker above still runs and their own dashboard still works; this exists
    because their READ API is undocumented and returned nothing usable. */
}
<script>
  import '@/scripts/track'
</script>

<ConsentBanner />
