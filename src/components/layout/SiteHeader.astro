---
/**
 * Site header.
 *
 * Structure verified live 2026-08-26 (docs/PROGRESS.md § D-1, D-2):
 *  - Work, Services and Stack open mega menus. About and Insights are links.
 *  - The header sits absolutely at the top of the page rather than fixed.
 *  - A masked backdrop-filter layer fades the blur out below the top edge.
 *
 * Accessibility note: the live reference renders its mega-menu triggers as
 * <a> elements with no href, which is neither keyboard- nor crawler-friendly.
 * Ours are real links to the section index, carrying `aria-expanded` for the
 * panel they reveal on hover or focus — so clicking "Work" goes to /work
 * instead of doing nothing, and the panel stays a shortcut rather than the only
 * way in. Each panel also keeps its own index link ("All services", "All work").
 */
import { getCollection } from 'astro:content'
import Button from '../ui/Button.astro'
import Logo from '../ui/Logo.astro'
import AnimatedNav from '@/components/ui/navigation-menu.tsx'
import type { NavMenu, NavMenuColumn } from '@/components/ui/navigation-menu.tsx'
import { PLAIN_NAV_LINKS, SITE } from '@/config/site'
import {
  SERVICE_PILLARS,
  SERVICE_PILLAR_LABELS,
  STACK_CATEGORIES,
  STACK_CATEGORY_ALL_LABELS,
  STACK_CATEGORY_LABELS,
} from '@/content.config'

interface Props {
  /** Renders white-on-transparent for pages that open with a dark hero band. */
  overDarkHero?: boolean
}

const { overDarkHero = false } = Astro.props

const [services, work, stack] = await Promise.all([
  getCollection('services', ({ data }) => !data.draft),
  getCollection('work', ({ data }) => !data.draft),
  getCollection('stack', ({ data }) => !data.draft),
])

const servicesByPillar = services.sort((a, b) => a.data.order - b.data.order)
const featuredWork = work.filter((entry) => entry.data.featured).slice(0, 3)

/** Groups the stack entries by category, keeping only the recommended picks. */
const stackColumns: NavMenuColumn[] = STACK_CATEGORIES.map((category) => ({
  label: STACK_CATEGORY_LABELS[category],
  links: stack
    .filter((entry) => entry.data.category === category)
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 4)
    .map((entry) => ({
      label: entry.data.name,
      href: `/stack/${category}/${entry.id.split('/').pop()}`,
    })),
  allLink: {
    label: STACK_CATEGORY_ALL_LABELS[category],
    href: `/stack/${category}`,
  },
}))

/** Services split across four columns, one per delivery pillar. */
const serviceColumns: NavMenuColumn[] = SERVICE_PILLARS.map((pillar) => ({
  label: SERVICE_PILLAR_LABELS[pillar],
  links: servicesByPillar
    .filter((entry) => entry.data.pillar === pillar)
    .map((entry) => ({ label: entry.data.title, href: `/services/${entry.id}` })),
  allLink: { label: 'All services', href: '/services' },
}))

/** Work, chunked into four columns so the grid stays even. */
const workColumns: NavMenuColumn[] = Array.from({ length: 4 }, (_, column) => ({
  label: column === 0 ? 'Featured' : 'More work',
  links: featuredWork
    .slice(column * 2, column * 2 + 2)
    .map((entry) => ({ label: entry.data.client, href: `/work/${entry.id}` })),
  allLink: column === 3 ? { label: 'All work', href: '/work' } : undefined,
})).filter((column) => column.links.length > 0)

// TODO: feature-card copy is provisional placeholder text.
const menus: NavMenu[] = [
  {
    id: 'mega-work',
    href: '/work',
    label: 'Work',
    columns: workColumns,
    feature: {
      label: 'Selected projects',
      body: 'Custom websites, apps and internal tools we have built for teams like yours.',
      href: '/work',
      ctaLabel: 'Browse the work',
    },
  },
  {
    id: 'mega-services',
    href: '/services',
    label: 'Services',
    columns: serviceColumns,
    feature: {
      label: 'Start here',
      body: 'Not sure which one you need? Tell us what is eating your hours and we will tell you what to build.',
      href: '/get-in-touch',
      ctaLabel: 'Talk to Us',
    },
  },
  {
    id: 'mega-stack',
    href: '/stack',
    label: 'Stack',
    columns: stackColumns,
    feature: {
      label: 'Enterprise stack',
      body: 'The platforms we build on, and an honest note on when each one is the wrong choice.',
      href: '/enterprise',
      ctaLabel: 'Read about',
    },
  },
]
---

<header
  data-site-header
  data-over-hero={overDarkHero ? 'true' : undefined}
  class="site-header absolute inset-x-0 top-0 z-50"
>
  <!--
    Progressive blur: five stacked layers inside a fixed 10rem band. Each layer
    blurs a little more and is masked to a different slice, so the blur ramps
    smoothly instead of ending on a hard edge. Matched to the reference.
  -->
  <div
    aria-hidden="true"
    class="pointer-events-none fixed inset-x-0 top-0 z-[21] h-40 overflow-hidden"
  >
    {
      [1, 2, 3, 4, 5].map((step) => (
        <div
          class="wh-header-blur absolute inset-0"
          style={`--layer-blur: ${step * 0.5}px; --layer-start: ${(step - 1) * 16}%; --layer-end: ${step * 20}%;`}
        />
      ))
    }
  </div>

  <div class="wh-container relative flex h-20 items-center justify-between gap-4 lg:h-28">
    <a
      href="/"
      class="wh-tap inline-flex items-center gap-2.5 text-xl tracking-tight lg:hidden"
      aria-label={`${SITE.name} — home`}
    >
      <Logo variant="mark" class="h-6 w-auto" label={`${SITE.name} — home`} />
    </a>

    <div class="hidden lg:block">
      <AnimatedNav
        client:load
        menus={menus}
        plainLinks={PLAIN_NAV_LINKS}
        ctaLabel="Talk to us"
        ctaHref="/get-in-touch"
        siteName="WildHands"
      />
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <Button href="/get-in-touch" variant="accent" size="sm" class="hidden sm:inline-flex">
        Talk to us
      </Button>

      <button
        type="button"
        data-mobile-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="wh-tap -mr-2 inline-flex flex-col items-center justify-center gap-1.5 rounded-md px-2 lg:hidden"
      >
        <span class="sr-only">Menu</span>
        <span aria-hidden="true" class="wh-burger block h-px w-6 bg-current"></span>
        <span aria-hidden="true" class="wh-burger block h-px w-6 bg-current"></span>
        <span aria-hidden="true" class="wh-burger block h-px w-6 bg-current"></span>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div id="mobile-menu" data-mobile-panel class="wh-mobile-panel lg:hidden">
    <nav aria-label="Mobile" class="wh-container max-h-[calc(100dvh-4rem)] overflow-y-auto pb-8">
      <ul class="divide-y divide-white/10 border-t border-white/10">
        {
          [
            { label: 'Work', href: '/work' },
            { label: 'Services', href: '/services' },
            { label: 'Stack', href: '/stack' },
            ...PLAIN_NAV_LINKS,
          ].map((link) => (
            <li>
              <a href={link.href} class="wh-tap flex items-center py-4 text-lg text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3">
        <Button href="/get-in-touch" variant="accent" size="lg">Talk to us</Button>
        <Button href="/freelance-hub" variant="outline" size="lg" onDark>Freelance Hub</Button>
      </div>
    </nav>
  </div>
</header>

<style>
  .wh-nav-trigger {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.625rem 1.25rem;
    border-radius: 9999px;
    font-size: 1.125rem;
    font-weight: 400;
    transition: background-color 0.15s var(--ease-standard);
  }
  .wh-nav-trigger:hover {
    background-color: color-mix(in oklab, currentColor 10%, transparent);
  }

  /* The open trigger keeps a light pill behind it while its panel is showing. */
  .wh-nav-trigger[aria-expanded='true'] {
    background-color: color-mix(in oklab, currentColor 12%, transparent);
  }

  /* Over a dark hero the chrome is white; once scrolled past it flips to the
     page foreground colour. Attribute-driven so there is no scroll jank. */
  .site-header {
    color: var(--foreground);
  }
  .site-header[data-over-hero]:not([data-scrolled]) {
    color: #fff;
  }

  .wh-mobile-panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background-color: color-mix(in oklab, var(--primary) 92%, transparent);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-2px);
    transition:
      opacity 0.3s,
      transform 0.3s,
      visibility linear 0.3s;
  }

  .site-header[data-menu-open='true'] .wh-mobile-panel {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    /* No visibility delay on open, so it is interactive immediately. */
    transition:
      opacity 0.3s,
      transform 0.3s;
  }

  /* Hamburger morphs into an X — timings verified live. */
  .wh-burger {
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .site-header[data-menu-open='true'] .wh-burger:nth-child(2) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header[data-menu-open='true'] .wh-burger:nth-child(3) {
    opacity: 0;
  }
  .site-header[data-menu-open='true'] .wh-burger:nth-child(4) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .site-header[data-menu-open='true'] {
    color: #fff;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]')
  if (header) {
    /* ---------------- Desktop mega menus ---------------- */
    const items = [...header.querySelectorAll<HTMLElement>('[data-menu-item]')]
    let openItem: HTMLElement | null = null
    let closeTimer: number | undefined

    const panelOf = (item: HTMLElement) => item.querySelector<HTMLElement>('[data-menu-panel]')
    const triggerOf = (item: HTMLElement) =>
      item.querySelector<HTMLButtonElement>('[data-menu-trigger]')

    const closeMenu = (item: HTMLElement) => {
      const panel = panelOf(item)
      const trigger = triggerOf(item)
      if (!panel || !trigger) return
      panel.removeAttribute('data-open')
      trigger.setAttribute('aria-expanded', 'false')
      // Wait for the fade before removing from the a11y tree.
      window.setTimeout(() => {
        if (!panel.hasAttribute('data-open')) panel.hidden = true
      }, 350)
      if (openItem === item) openItem = null
    }

    const openMenu = (item: HTMLElement) => {
      const panel = panelOf(item)
      const trigger = triggerOf(item)
      if (!panel || !trigger) return
      if (openItem && openItem !== item) closeMenu(openItem)

      panel.hidden = false
      // Suppress the transition for one frame so the panel never flashes.
      panel.setAttribute('data-first-paint', '')
      requestAnimationFrame(() => {
        panel.removeAttribute('data-first-paint')
        panel.setAttribute('data-open', '')
      })
      trigger.setAttribute('aria-expanded', 'true')
      openItem = item
    }

    items.forEach((item) => {
      const trigger = triggerOf(item)
      if (!trigger) return

      trigger.addEventListener('click', () => {
        if (openItem === item) closeMenu(item)
        else openMenu(item)
      })

      item.addEventListener('pointerenter', () => {
        window.clearTimeout(closeTimer)
        if (window.matchMedia('(hover: hover)').matches) openMenu(item)
      })

      item.addEventListener('pointerleave', () => {
        if (!window.matchMedia('(hover: hover)').matches) return
        closeTimer = window.setTimeout(() => closeMenu(item), 120)
      })

      item.addEventListener('focusout', (event) => {
        const next = event.relatedTarget
        if (next instanceof Node && item.contains(next)) return
        closeMenu(item)
      })
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      if (openItem) {
        const trigger = triggerOf(openItem)
        closeMenu(openItem)
        trigger?.focus()
      }
      if (header.dataset['menuOpen'] === 'true') toggleMobile(false)
    })

    document.addEventListener('pointerdown', (event) => {
      if (!openItem) return
      if (event.target instanceof Node && openItem.contains(event.target)) return
      closeMenu(openItem)
    })

    /* ---------------- Mobile panel ---------------- */
    const mobileToggle = header.querySelector<HTMLButtonElement>('[data-mobile-toggle]')

    function toggleMobile(open: boolean) {
      if (!header) return
      header.dataset['menuOpen'] = String(open)
      mobileToggle?.setAttribute('aria-expanded', String(open))
      document.body.style.overflow = open ? 'hidden' : ''
    }

    mobileToggle?.addEventListener('click', () => {
      toggleMobile(header.dataset['menuOpen'] !== 'true')
    })

    // Close the panel if the viewport grows past the mobile breakpoint.
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches) toggleMobile(false)
    })

    /* ---------------- Scroll: progressive blur + colour flip ---------------- */
    const root = document.documentElement
    let ticking = false

    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        const y = window.scrollY
        // Ramp the whole blur stack in over the first 120px of scroll.
        const scale = Math.min(1, y / 120)
        root.style.setProperty('--progressive-header-scale', scale.toFixed(3))

        // Flip to the solid foreground colour once the dark hero is behind us.
        const hero = document.querySelector<HTMLElement>('[data-dark-hero]')
        const threshold = hero ? hero.offsetHeight - header.offsetHeight : 0
        if (y > threshold) header.setAttribute('data-scrolled', '')
        else header.removeAttribute('data-scrolled')

        ticking = false
      })
    }

    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll, { passive: true })
  }
</script>
