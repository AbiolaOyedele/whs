---
/**
 * Cookie consent banner.
 *
 * Analytics stay off until the visitor explicitly accepts, which is what makes
 * the PostHog loader in Analytics.astro compliant. Hidden by default and
 * revealed by script, so it never flashes for someone who already decided.
 *
 * Anchored bottom-right rather than centred. Centred and 42rem wide, it landed
 * squarely on the home hero's call-to-action pair.
 */
---

<div
  data-consent-banner
  hidden
  role="region"
  aria-label="Cookie choices"
  class="fixed right-3 bottom-3 left-3 z-100 max-w-md rounded-xl border border-border bg-card p-5 shadow-lg sm:left-auto"
>
  <p class="text-sm text-muted-foreground">
    We use analytics cookies to understand how the site is used. They stay off unless you accept.
  </p>
  <div class="mt-4 flex flex-wrap gap-2">
    <button
      type="button"
      data-consent-accept
      class="wh-tap inline-flex items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
    >
      Accept analytics
    </button>
    <button
      type="button"
      data-consent-decline
      class="wh-tap inline-flex items-center justify-center rounded-full border border-border px-5 text-sm font-medium transition-colors hover:bg-muted"
    >
      Decline
    </button>
    <a
      href="/legal/privacy-policy"
      class="wh-tap inline-flex items-center px-2 text-sm underline underline-offset-4"
    >
      Privacy Policy
    </a>
  </div>
</div>

<script>
  const banner = document.querySelector<HTMLElement>('[data-consent-banner]')
  if (banner) {
    const KEY = 'wh-consent'

    const read = (): string | null => {
      try {
        return localStorage.getItem(KEY)
      } catch {
        return null
      }
    }

    const write = (value: string) => {
      try {
        localStorage.setItem(KEY, value)
      } catch {
        // Storage unavailable — the choice simply is not remembered.
      }
    }

    if (read() === null) banner.hidden = false

    banner.querySelector('[data-consent-accept]')?.addEventListener('click', () => {
      write('granted')
      banner.hidden = true
      window.dispatchEvent(new Event('wh:consent-granted'))
    })

    banner.querySelector('[data-consent-decline]')?.addEventListener('click', () => {
      write('denied')
      banner.hidden = true
    })
  }
</script>
