---
/**
 * The client-facing quote document.
 *
 * Extracted so that exactly one implementation renders both the real page at
 * `/quote/<slug>` and the admin preview. A preview built from a second copy of
 * this markup would drift from it, and a preview that drifts is worse than no
 * preview at all — it tells you a document is fine when it is not.
 *
 * `mode` is the only thing that differs between the two:
 *
 *   client  — the real thing. The accept/decline form posts.
 *   preview — the admin looking at it. The decision form is rendered so the
 *             layout is honest, but inert and visibly labelled, because a
 *             stray click here would record a decision on the client's behalf.
 */
import Logo from '@/components/ui/Logo.astro'
import BentoGallery from '@/components/ui/BentoGallery'
import { SITE } from '@/config/site'
import { formatMoney, lineAmount } from '@/lib/admin/money'
import type { Quote, QuoteTotals } from '@/types/quote'

interface Props {
  quote: Quote
  totals: QuoteTotals
  mode?: 'client' | 'preview'
  /**
   * Whether to offer card payment.
   *
   * Resolved by the page, not here, because it depends on three things this
   * component should not know about: whether Paystack has keys, whether the
   * quote's currency is one Paystack can charge, and whether it is already
   * paid. Offering a pay button that fails after the click is worse than not
   * offering one.
   */
  payment?: { enabled: boolean; amountMinor: number; kind: string; paid: boolean } | undefined
}

const { quote, totals, mode = 'client', payment } = Astro.props
const isPreview = mode === 'preview'

const money = (minor: number): string => formatMoney(minor, quote.currency)

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

const decided = quote.status === 'accepted' || quote.status === 'declined'
const expired = Boolean(quote.validUntil && new Date(quote.validUntil) < new Date())

const requiredItems = quote.lineItems.filter((item) => !item.isOptional)
const optionalItems = quote.lineItems.filter((item) => item.isOptional)
---

<header
  class="rounded-b-section bg-surface-dark px-5 pt-10 pb-12 text-surface-dark-foreground lg:px-10 lg:pt-14 lg:pb-16"
>
  <div class="mx-auto max-w-6xl">
    <Logo variant="mark" class="mb-10 h-7 w-auto" label={SITE.name} />

    <p class="mb-3 text-base text-white/60">
      Prepared for {quote.clientCompany || quote.clientName}
    </p>
    <h1 class="wh-h2 max-w-3xl text-balance">{quote.projectTitle}</h1>
  </div>
</header>

<!--
  Two columns from lg, with the commercial summary pinned in the right rail.

  The previous single centred column left most of a desktop screen empty while
  the document ran on for screens: the prose sat in a readable measure and the
  remaining third of the viewport did nothing. The rail puts the numbers a
  client actually scrolls back for — total, deposit, expiry — permanently in
  view, and shortens the page by lifting them out of the flow.

  Below lg it collapses to one column with the summary near the top, because on
  a phone a pinned panel is just a thing covering the document.
-->
<main class="mx-auto max-w-6xl px-5 py-10 lg:px-10 lg:py-16">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start lg:gap-12">
    <div class="min-w-0">
      {
        expired && !decided && (
          <div class="mb-8 rounded-2xl border border-border bg-muted p-5">
            <p class="text-base">
              This quote passed its valid-until date. The scope still stands: get in touch and we
              will confirm the pricing.
            </p>
          </div>
        )
      }

      {quote.introNote && <p class="wh-h3 mb-10 text-balance">{quote.introNote}</p>}

      {
        quote.projectSummary && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-2xl">The project</h2>
            <div class="max-w-prose text-lg leading-relaxed whitespace-pre-line">
              {quote.projectSummary}
            </div>
          </section>
        )
      }

      {
        quote.images.length > 0 && (
          <div class="mb-12">
            <BentoGallery
              client:visible
              title="What it will look like"
              items={quote.images.map((image) => ({
                id: image.id,
                url: image.url,
                caption: image.caption,
                width: image.width,
                height: image.height,
              }))}
            />
          </div>
        )
      }

      {
        requiredItems.length > 0 && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-2xl">What it costs</h2>

            {/* A table on desktop, stacked rows on mobile. A six-column table
                at 375px is unreadable however it is scrolled. */}
            <ul class="flex flex-col border-t border-border">
              {requiredItems.map((item) => (
                <li class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[1fr_auto]">
                  <div class="min-w-0">
                    <p class="text-lg">{item.title}</p>
                    {item.description && (
                      <p class="mt-1 max-w-prose text-base text-muted-foreground">
                        {item.description}
                      </p>
                    )}
                    {item.quantity !== 1 && (
                      <p class="mt-1 text-sm text-muted-foreground">
                        {item.quantity} × {money(item.unitPriceMinor)}
                      </p>
                    )}
                  </div>
                  <p class="font-mono text-lg sm:text-right">{money(lineAmount(item))}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        optionalItems.length > 0 && (
          <section class="mb-12">
            <h2 class="mb-1 font-display text-2xl">Optional extras</h2>
            <p class="mb-4 text-base text-muted-foreground">
              Not in the total. Say the word and we will add them.
            </p>
            <ul class="flex flex-col border-t border-border">
              {optionalItems.map((item) => (
                <li class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[1fr_auto]">
                  <div class="min-w-0">
                    <p class="text-lg">{item.title}</p>
                    {item.description && (
                      <p class="mt-1 max-w-prose text-base text-muted-foreground">
                        {item.description}
                      </p>
                    )}
                  </div>
                  <p class="font-mono text-lg sm:text-right">{money(lineAmount(item))}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        quote.phases.length > 0 && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-2xl">How long it takes</h2>
            {/* Two up from md: four phases stacked full width was most of the
                page's length for very little information. */}
            <ol class="grid gap-4 md:grid-cols-2">
              {quote.phases.map((phase, index) => (
                <li class="rounded-2xl border border-border bg-card p-5">
                  <div class="mb-3 flex items-center gap-3">
                    <span
                      class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent font-mono text-sm text-accent-foreground"
                      aria-hidden="true"
                    >
                      {index + 1}
                    </span>
                    <h3 class="font-display text-lg leading-tight">{phase.title}</h3>
                  </div>
                  {phase.durationLabel && (
                    <p class="mb-2 text-sm text-muted-foreground">{phase.durationLabel}</p>
                  )}
                  {phase.description && <p class="text-base">{phase.description}</p>}
                  {phase.deliverables.length > 0 && (
                    <ul class="mt-3 flex list-disc flex-col gap-1 pl-5 text-base text-muted-foreground">
                      {phase.deliverables.map((deliverable) => (
                        <li>{deliverable}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        quote.references.length > 0 && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-2xl">Have a look at these</h2>
            <ul class="grid gap-3 sm:grid-cols-2">
              {quote.references.map((reference) => (
                <li>
                  <a
                    href={reference.url}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="flex min-h-11 flex-col rounded-2xl border border-border bg-card p-4 transition-colors hover:border-foreground"
                  >
                    <span class="font-display text-lg">{reference.label}</span>
                    {reference.description && (
                      <span class="mt-1 text-base text-muted-foreground">
                        {reference.description}
                      </span>
                    )}
                    <span class="mt-2 truncate font-mono text-sm text-muted-foreground">
                      {reference.url}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        (quote.paymentTerms || quote.terms) && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-2xl">The details</h2>

            {/*
              Collapsed by default, on <details> so it works with JavaScript off.

              Terms are the longest section and the one clients skim rather than
              read line by line; leaving them expanded pushed the decision far
              enough down the page that people stopped reaching it.
            */}
            <div class="flex flex-col gap-2">
              {quote.paymentTerms && (
                <details class="group rounded-2xl border border-border bg-card" open>
                  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 font-display text-lg">
                    Payment
                    <span
                      class="text-muted-foreground transition-transform group-open:rotate-180"
                      aria-hidden="true"
                    >
                      ▾
                    </span>
                  </summary>
                  <p class="max-w-prose px-5 pb-5 text-base whitespace-pre-line text-muted-foreground">
                    {quote.paymentTerms}
                  </p>
                </details>
              )}

              {quote.terms && (
                <details class="group rounded-2xl border border-border bg-card">
                  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 font-display text-lg">
                    Terms
                    <span
                      class="text-muted-foreground transition-transform group-open:rotate-180"
                      aria-hidden="true"
                    >
                      ▾
                    </span>
                  </summary>
                  <p class="max-w-prose px-5 pb-5 text-base whitespace-pre-line text-muted-foreground">
                    {quote.terms}
                  </p>
                </details>
              )}
            </div>
          </section>
        )
      }

      <section
        id="decision"
        class="rounded-section bg-surface-dark p-6 text-surface-dark-foreground lg:p-10"
      >
        {
          decided ? (
            <>
              <h2 class="wh-h3 mb-3">
                {quote.status === 'accepted' ? 'Thank you' : 'Thanks for letting us know'}
              </h2>
              <p class="text-lg text-white/70">
                {quote.status === 'accepted'
                  ? 'We have this and will be in touch shortly to get started.'
                  : 'If anything changes, or you would like this reworked, just reply to our email.'}
              </p>
            </>
          ) : (
            <>
              <h2 class="wh-h3 mb-3">Happy with this?</h2>
              <p class="mb-8 max-w-xl text-lg text-white/70">
                Let us know either way. Nothing here is binding: it tells us whether to book the
                time in.
              </p>

              <form method="post" class="flex flex-col gap-5" inert={isPreview || undefined}>
                <label for="note" class="text-base text-white/60">
                  Anything you want to add? (optional)
                </label>
                <textarea
                  id="note"
                  name="note"
                  rows="3"
                  maxlength="2000"
                  disabled={isPreview}
                  class="rounded-xl border border-white/20 bg-white/5 px-4 py-3 text-lg text-white outline-none focus-visible:border-accent disabled:opacity-60"
                />

                <div class="flex flex-wrap gap-3">
                  <button
                    type="submit"
                    name="decision"
                    value="accepted"
                    disabled={isPreview}
                    class="min-h-14 rounded-full bg-accent px-8 text-lg text-accent-foreground transition-opacity hover:opacity-90 disabled:opacity-60"
                  >
                    Let's do it
                  </button>
                  <button
                    type="submit"
                    name="decision"
                    value="declined"
                    disabled={isPreview}
                    class="min-h-14 rounded-full border border-white/30 px-8 text-lg text-white transition-colors hover:border-white disabled:opacity-60"
                  >
                    Not right now
                  </button>
                </div>
              </form>

              {isPreview && (
                <p class="mt-5 text-base text-white/50">
                  These buttons are disabled in preview. Your client will see them working.
                </p>
              )}
            </>
          )
        }
      </section>

      <footer
        class="mt-10 flex flex-wrap items-center justify-between gap-4 text-base text-muted-foreground"
      >
        <p>
          Questions?{' '}
          <a class="underline" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </p>
        <Logo variant="mark" class="h-5 w-auto opacity-60" label={SITE.name} />
      </footer>
    </div>

    <!-- The commercial summary. Ordered first on mobile so the price is not
         buried below the whole narrative. -->
    <aside class="order-first lg:sticky lg:top-8 lg:order-none">
      <div class="rounded-3xl border border-border bg-card p-6">
        <p class="text-sm text-muted-foreground">Total</p>
        <p class="mb-5 font-mono text-3xl leading-none">{money(totals.totalMinor)}</p>

        <dl class="flex flex-col gap-2 border-t border-border pt-4 text-base">
          <div class="flex justify-between gap-4">
            <dt class="text-muted-foreground">Subtotal</dt>
            <dd class="font-mono">{money(totals.subtotalMinor)}</dd>
          </div>
          {
            totals.discountMinor > 0 && (
              <div class="flex justify-between gap-4">
                <dt class="text-muted-foreground">Discount</dt>
                <dd class="font-mono">− {money(totals.discountMinor)}</dd>
              </div>
            )
          }
          {
            quote.taxRateBp > 0 && (
              <div class="flex justify-between gap-4">
                <dt class="text-muted-foreground">Tax ({quote.taxRateBp / 100}%)</dt>
                <dd class="font-mono">{money(totals.taxMinor)}</dd>
              </div>
            )
          }
          {
            quote.depositPercent > 0 && quote.depositPercent < 100 && (
              <>
                <div class="mt-2 flex justify-between gap-4 border-t border-border pt-3">
                  <dt class="text-muted-foreground">To start ({quote.depositPercent}%)</dt>
                  <dd class="font-mono">{money(totals.depositMinor)}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-muted-foreground">On delivery</dt>
                  <dd class="font-mono">{money(totals.balanceMinor)}</dd>
                </div>
              </>
            )
          }
          {
            quote.validUntil && (
              <div class="mt-2 flex justify-between gap-4 border-t border-border pt-3">
                <dt class="text-muted-foreground">Valid until</dt>
                <dd>{dateFormat.format(new Date(quote.validUntil))}</dd>
              </div>
            )
          }
        </dl>

        {
          payment?.paid && (
            <p class="mt-5 rounded-xl border border-accent bg-accent/10 px-4 py-3 text-base">
              Paid. Thank you.
            </p>
          )
        }

        {
          !decided && !payment?.paid && (
            <a
              href="#decision"
              class="mt-5 flex min-h-12 items-center justify-center rounded-full bg-primary px-6 text-base text-primary-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              Respond to this quote
            </a>
          )
        }

        <a
          href={`/api/v1/quote/${quote.slug}/invoice`}
          class="mt-2 flex min-h-12 items-center justify-center gap-2 rounded-full border border-border px-6 text-base transition-colors hover:border-foreground"
          aria-disabled={isPreview ? 'true' : undefined}
        >
          <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
            <path
              d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Download invoice
        </a>

        {
          payment?.enabled && !payment.paid && (
            <>
              <button
                type="button"
                data-pay-button
                data-slug={quote.slug}
                disabled={isPreview}
                class="mt-2 flex min-h-12 w-full items-center justify-center rounded-full bg-accent px-6 text-base text-accent-foreground transition-opacity hover:opacity-90 disabled:opacity-60"
              >
                Pay {money(payment.amountMinor)} {payment.kind === 'deposit' ? 'deposit' : 'now'}
              </button>
              <p data-pay-error class="mt-2 hidden text-sm text-destructive" role="alert" />
              <p class="mt-2 text-sm text-muted-foreground">
                Card or bank transfer, handled by Paystack. We never see your card details.
              </p>
            </>
          )
        }
      </div>
    </aside>
  </div>
</main>

<!--
  The only JavaScript on this page besides the gallery island.

  Deliberately not a framework component: it is one fetch and one redirect, and
  the button must still be visible (and the copy honest) if the script never
  runs, which is why the fallback is an explanatory error rather than a dead
  button.
-->
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-pay-button]').forEach((button) => {
    const error = document.querySelector<HTMLElement>('[data-pay-error]')

    button.addEventListener('click', async () => {
      const original = button.textContent
      button.disabled = true
      button.textContent = 'Taking you to checkout…'
      error?.classList.add('hidden')

      try {
        const response = await fetch(`/api/v1/quote/${button.dataset['slug']}/pay`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: '{}',
        })
        const body = await response.json()

        if (!response.ok) {
          if (error) {
            error.textContent = body?.error?.message ?? 'We could not start that payment.'
            error.classList.remove('hidden')
          }
          button.disabled = false
          button.textContent = original
          return
        }

        window.location.href = body.url
      } catch {
        if (error) {
          error.textContent = 'We could not reach the server. Please try again.'
          error.classList.remove('hidden')
        }
        button.disabled = false
        button.textContent = original
      }
    })
  })
</script>
