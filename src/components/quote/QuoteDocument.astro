---
/**
 * The client-facing quote document.
 *
 * Extracted so that exactly one implementation renders both the real page at
 * `/quote/<slug>` and the admin preview. A preview built from a second copy of
 * this markup would drift from it, and a preview that drifts is worse than no
 * preview at all — it tells you a document is fine when it is not.
 *
 * `mode` is the only thing that differs between the two:
 *
 *   client  — the real thing. The accept/decline form posts.
 *   preview — the admin looking at it. The decision form is rendered so the
 *             layout is honest, but inert and visibly labelled, because a
 *             stray click here would record a decision on the client's behalf.
 */
import Icon from '@/components/ui/Icon.astro'
import Logo from '@/components/ui/Logo.astro'
import BentoGallery from '@/components/ui/BentoGallery'
import { SITE } from '@/config/site'
import { formatMoney, lineAmount } from '@/lib/admin/money'
import type { Quote, QuoteTotals } from '@/types/quote'

interface Props {
  quote: Quote
  totals: QuoteTotals
  mode?: 'client' | 'preview'
  /**
   * Whether to offer card payment.
   *
   * Resolved by the page, not here, because it depends on three things this
   * component should not know about: whether Paystack has keys, whether the
   * quote's currency is one Paystack can charge, and whether it is already
   * paid. Offering a pay button that fails after the click is worse than not
   * offering one.
   */
  payment?:
    | {
        enabled: boolean
        amountMinor: number
        kind: string
        paidMinor: number
        outstandingMinor: number
      }
    | undefined
  /**
   * Whether the client may still change their selection.
   *
   * Resolved by the page for the same reason as `payment`: it depends on the
   * payment records, which this component has no business reading.
   */
  selection?: { locked: boolean; message: string | null } | undefined
}

const { quote, totals, mode = 'client', payment, selection } = Astro.props
const isPreview = mode === 'preview'

const money = (minor: number): string => formatMoney(minor, quote.currency)

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

const decided = quote.status === 'accepted' || quote.status === 'declined'
const expired = Boolean(quote.validUntil && new Date(quote.validUntil) < new Date())

/* Base scope: charged whatever the client picks. Items belonging to an option
   are rendered inside that option's card instead, so nothing appears twice. */
const requiredItems = quote.lineItems.filter((item) => item.optionId === null && !item.isOptional)
const optionalItems = quote.lineItems.filter((item) => item.optionId === null && item.isOptional)

const packages = quote.options.filter((option) => option.kind === 'package')
const addons = quote.options.filter((option) => option.kind === 'addon')

const itemsFor = (optionId: string): typeof quote.lineItems =>
  quote.lineItems.filter((item) => item.optionId === optionId)

/* The preview pane is a rendering of the document, not a working copy of it —
   clicking a package there would write a selection onto a live client quote. */
const canChoose = !isPreview && selection?.locked !== true
const chooserLocked = !isPreview && selection?.locked === true
---

<header
  class="rounded-b-section bg-surface-dark px-5 pt-10 pb-12 text-surface-dark-foreground lg:px-10 lg:pt-14 lg:pb-16"
>
  <div class="mx-auto max-w-6xl">
    <Logo variant="mark" class="mb-10 h-7 w-auto" label={SITE.name} />

    <p class="mb-3 text-base text-white/60">
      Prepared for {quote.clientCompany || quote.clientName}
    </p>
    <h1 class="wh-h2 max-w-3xl text-balance">{quote.projectTitle}</h1>
  </div>
</header>

{
  /*  Two columns from lg, with the commercial summary pinned in the right rail.

  The previous single centred column left most of a desktop screen empty while
  the document ran on for screens: the prose sat in a readable measure and the
  remaining third of the viewport did nothing. The rail puts the numbers a
  client actually scrolls back for — total, deposit, expiry — permanently in
  view, and shortens the page by lifting them out of the flow.

  Below lg it collapses to one column with the summary near the top, because on
  a phone a pinned panel is just a thing covering the document.*/
}
<main class="mx-auto max-w-6xl px-5 py-10 lg:px-10 lg:py-16">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start lg:gap-12">
    <div class="min-w-0 lg:col-start-1 lg:row-start-1">
      {
        expired && !decided && (
          <div class="mb-8 rounded-2xl border border-border bg-muted p-5">
            <p class="text-base">
              This quote passed its valid-until date. The scope still stands: get in touch and we
              will confirm the pricing.
            </p>
          </div>
        )
      }

      {quote.introNote && <p class="wh-h3 mb-10 text-balance">{quote.introNote}</p>}

      {
        quote.projectSummary && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-2xl">The project</h2>
            <div class="max-w-prose text-lg leading-relaxed whitespace-pre-line">
              {quote.projectSummary}
            </div>
          </section>
        )
      }

      {
        quote.images.length > 0 && (
          <div class="mb-12">
            <BentoGallery
              client:visible
              title="What it will look like"
              items={quote.images.map((image) => ({
                id: image.id,
                url: image.url,
                caption: image.caption,
                width: image.width,
                height: image.height,
              }))}
            />
          </div>
        )
      }

      {
        (packages.length > 0 || addons.length > 0) && (
          <p
            class="mb-4 hidden rounded-2xl border border-border bg-card px-5 py-3 text-base"
            role="status"
            aria-live="polite"
            data-option-status
          />
        )
      }

      {
        packages.length > 0 && (
          <section class="mb-12" data-option-group="package">
            <h2 class="mb-1 font-display text-2xl">Choose your package</h2>
            <p class="mb-4 max-w-prose text-base text-muted-foreground">
              {chooserLocked
                ? (selection?.message ?? 'This choice is now fixed.')
                : 'Pick the one that fits. The total updates as you choose, and you can change your mind until you accept.'}
            </p>

            {/* One up on a phone, side by side from md. Packages are read by
                  comparison, so they must sit at the same height with their
                  prices on the same line — hence a grid rather than cards that
                  size to their own content. */}
            <div class="grid gap-4 sm:grid-cols-2">
              {packages.map((option) => (
                <label
                  class:list={[
                    /* `cursor-pointer` and `cursor-default` carry the same
                       specificity, so listing both leaves the winner to whichever
                       Tailwind emits last — not to the order written here. Choose
                       one, never override. */
                    'relative flex min-h-14 flex-col rounded-2xl border bg-card p-5 transition-colors',
                    canChoose ? 'cursor-pointer' : 'cursor-default',
                    option.isSelected
                      ? 'border-foreground ring-1 ring-foreground'
                      : 'border-border hover:border-foreground',
                  ]}
                  data-option-card={option.id}
                >
                  {/* A real radio, visually replaced rather than removed: it
                        carries the keyboard and screen-reader behaviour that a
                        div with a click handler would have to reimplement badly. */}
                  <input
                    type="radio"
                    name="wh-package"
                    value={option.id}
                    checked={option.isSelected}
                    disabled={!canChoose}
                    class="sr-only"
                    data-option-input
                    data-option-kind="package"
                    data-option-slug={quote.slug}
                  />

                  <span class="flex items-start justify-between gap-3">
                    <span class="font-display text-xl leading-tight">{option.title}</span>
                    <span
                      class:list={[
                        'mt-1 flex size-5 shrink-0 items-center justify-center rounded-full border transition-colors',
                        option.isSelected ? 'border-foreground bg-foreground' : 'border-border',
                      ]}
                      data-option-indicator
                      aria-hidden="true"
                    >
                      <span
                        class:list={[
                          'size-2 rounded-full bg-background transition-opacity',
                          option.isSelected ? 'opacity-100' : 'opacity-0',
                        ]}
                        data-option-dot
                      />
                    </span>
                  </span>

                  {/* Steps down with magnitude, as the summary card does. A
                      package card is a third of a column at xl, and a
                      seven-figure naira total at text-2xl runs past its edge. */}
                  <span
                    class:list={[
                      'mt-2 font-mono leading-none',
                      itemsFor(option.id).reduce((sum, item) => sum + lineAmount(item), 0) >=
                      100_000_000
                        ? 'text-lg'
                        : 'text-2xl',
                    ]}
                  >
                    {money(itemsFor(option.id).reduce((sum, item) => sum + lineAmount(item), 0))}
                  </span>

                  {option.description && (
                    <span class="mt-2 text-base text-muted-foreground">{option.description}</span>
                  )}

                  {/*
                      The breakdown folds away.

                      What a client compares is the name, the price and the one
                      sentence. Three packages listing every line at once is a
                      wall of text at exactly the moment they are choosing.

                      `details` rather than script, so it still opens with
                      JavaScript off. The summary sits inside the package label,
                      so its click is intercepted — without that, expanding the
                      breakdown would also select the package.
                    */}
                  {itemsFor(option.id).length > 0 && (
                    <details class="group mt-4 border-t border-border pt-3" data-option-details>
                      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 text-base text-muted-foreground">
                        <Icon
                          name="chevronDown"
                          class="size-3 shrink-0 transition-transform group-open:rotate-180"
                        />
                        What&#39;s included
                        <span class="ml-auto font-mono text-sm">{itemsFor(option.id).length}</span>
                      </summary>
                      <ul class="mt-3 flex flex-col gap-2">
                        {itemsFor(option.id).map((item) => (
                          <li class="flex items-baseline justify-between gap-3 text-base">
                            <span class="min-w-0">{item.title}</span>
                            <span class="shrink-0 font-mono text-sm text-muted-foreground">
                              {money(lineAmount(item))}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </details>
                  )}
                </label>
              ))}
            </div>
          </section>
        )
      }

      {
        addons.length > 0 && (
          <section class="mb-12" data-option-group="addon">
            <h2 class="mb-1 font-display text-2xl">Add anything else?</h2>
            <p class="mb-4 max-w-prose text-base text-muted-foreground">
              {chooserLocked
                ? (selection?.message ?? 'This choice is now fixed.')
                : 'Tick what you want. Each one adds to the total.'}
            </p>

            <ul class="flex flex-col gap-3">
              {addons.map((option) => (
                <li>
                  <label
                    class:list={[
                      'flex min-h-14 items-start gap-4 rounded-2xl border bg-card p-5 transition-colors',
                      canChoose ? 'cursor-pointer' : 'cursor-default',
                      option.isSelected
                        ? 'border-foreground ring-1 ring-foreground'
                        : 'border-border hover:border-foreground',
                    ]}
                    data-option-card={option.id}
                  >
                    <input
                      type="checkbox"
                      checked={option.isSelected}
                      disabled={!canChoose}
                      class="sr-only"
                      data-option-input
                      data-option-kind="addon"
                      data-option-slug={quote.slug}
                      value={option.id}
                    />

                    <span
                      class:list={[
                        'mt-1 flex size-5 shrink-0 items-center justify-center rounded-md border transition-colors',
                        option.isSelected ? 'border-foreground bg-foreground' : 'border-border',
                      ]}
                      aria-hidden="true"
                    >
                      <Icon
                        name="check"
                        strokeWidth={3}
                        class:list={[
                          'size-3 text-background transition-opacity',
                          option.isSelected ? 'opacity-100' : 'opacity-0',
                        ]}
                      />
                    </span>

                    <span class="flex min-w-0 flex-1 flex-col">
                      <span class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                        <span class="font-display text-lg leading-tight">{option.title}</span>
                        <span class="font-mono text-lg">
                          {money(
                            itemsFor(option.id).reduce((sum, item) => sum + lineAmount(item), 0)
                          )}
                        </span>
                      </span>
                      {option.description && (
                        <span class="mt-1 text-base text-muted-foreground">
                          {option.description}
                        </span>
                      )}
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        requiredItems.length > 0 && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-2xl">What it costs</h2>

            {/* A table on desktop, stacked rows on mobile. A six-column table
                at 375px is unreadable however it is scrolled. */}
            <ul class="flex flex-col border-t border-border">
              {requiredItems.map((item) => (
                <li class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[1fr_auto]">
                  <div class="min-w-0">
                    <p class="text-lg">{item.title}</p>
                    {item.description && (
                      <p class="mt-1 max-w-prose text-base text-muted-foreground">
                        {item.description}
                      </p>
                    )}
                    {item.quantity !== 1 && (
                      <p class="mt-1 text-sm text-muted-foreground">
                        {item.quantity} × {money(item.unitPriceMinor)}
                      </p>
                    )}
                  </div>
                  <p class="font-mono text-lg sm:text-right">{money(lineAmount(item))}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        optionalItems.length > 0 && (
          <section class="mb-12">
            <h2 class="mb-1 font-display text-2xl">Optional extras</h2>
            <p class="mb-4 text-base text-muted-foreground">
              Not in the total. Say the word and we will add them.
            </p>
            <ul class="flex flex-col border-t border-border">
              {optionalItems.map((item) => (
                <li class="grid gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[1fr_auto]">
                  <div class="min-w-0">
                    <p class="text-lg">{item.title}</p>
                    {item.description && (
                      <p class="mt-1 max-w-prose text-base text-muted-foreground">
                        {item.description}
                      </p>
                    )}
                  </div>
                  <p class="font-mono text-lg sm:text-right">{money(lineAmount(item))}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        quote.phases.length > 0 && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-2xl">How long it takes</h2>
            {/* Two up from md: four phases stacked full width was most of the
                page's length for very little information. */}
            <ol class="grid gap-4 md:grid-cols-2">
              {quote.phases.map((phase, index) => (
                <li class="rounded-2xl border border-border bg-card p-5">
                  <div class="mb-3 flex items-center gap-3">
                    <span
                      class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent font-mono text-sm text-accent-foreground"
                      aria-hidden="true"
                    >
                      {index + 1}
                    </span>
                    <h3 class="font-display text-lg leading-tight">{phase.title}</h3>
                  </div>
                  {phase.durationLabel && (
                    <p class="mb-2 text-sm text-muted-foreground">{phase.durationLabel}</p>
                  )}
                  {phase.description && <p class="text-base">{phase.description}</p>}
                  {phase.deliverables.length > 0 && (
                    <ul class="mt-3 flex list-disc flex-col gap-1 pl-5 text-base text-muted-foreground">
                      {phase.deliverables.map((deliverable) => (
                        <li>{deliverable}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        quote.references.length > 0 && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-2xl">Have a look at these</h2>
            <ul class="grid gap-3 sm:grid-cols-2">
              {quote.references.map((reference) => (
                <li>
                  <a
                    href={reference.url}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="flex min-h-11 flex-col rounded-2xl border border-border bg-card p-4 transition-colors hover:border-foreground"
                  >
                    <span class="font-display text-lg">{reference.label}</span>
                    {reference.description && (
                      <span class="mt-1 text-base text-muted-foreground">
                        {reference.description}
                      </span>
                    )}
                    <span class="mt-2 truncate font-mono text-sm text-muted-foreground">
                      {reference.url}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        (quote.paymentTerms || quote.terms) && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-2xl">The details</h2>

            {/*
              Collapsed by default, on <details> so it works with JavaScript off.

              Terms are the longest section and the one clients skim rather than
              read line by line; leaving them expanded pushed the decision far
              enough down the page that people stopped reaching it.
            */}
            <div class="flex flex-col gap-2">
              {quote.paymentTerms && (
                <details class="group rounded-2xl border border-border bg-card" open>
                  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 font-display text-lg">
                    Payment
                    <Icon
                      name="chevronDown"
                      class="size-3 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
                    />
                  </summary>
                  <p class="max-w-prose px-5 pb-5 text-base whitespace-pre-line text-muted-foreground">
                    {quote.paymentTerms}
                  </p>
                </details>
              )}

              {quote.terms && (
                <details class="group rounded-2xl border border-border bg-card">
                  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 font-display text-lg">
                    Terms
                    <Icon
                      name="chevronDown"
                      class="size-3 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
                    />
                  </summary>
                  <p class="max-w-prose px-5 pb-5 text-base whitespace-pre-line text-muted-foreground">
                    {quote.terms}
                  </p>
                </details>
              )}
            </div>
          </section>
        )
      }
    </div>

    {
      /* The commercial summary. Ordered first on mobile so the price is not
         buried below the whole narrative.*/
    }
    {
      /*      The commercial summary.

      Placed by explicit grid coordinates rather than DOM order, because the
      two layouts want opposite things. On a phone it reads AFTER the whole
      narrative: a client should understand what they are buying before they
      meet the number, and a seven-figure total as the first thing on screen
      reads as a demand rather than a proposal. On a desktop it pins beside
      the narrative from the top, where it is reference rather than reveal.*/
    }
    <aside class="lg:sticky lg:top-8 lg:col-start-2 lg:row-start-1">
      <div class="rounded-3xl border border-border bg-card p-6">
        <p class="text-sm text-muted-foreground">Total</p>
        {
          /* Steps down with magnitude: a seven-figure naira total at 3xl runs
            past the edge of the card. */
        }
        <p
          class:list={[
            'mb-5 font-mono leading-none',
            totals.totalMinor >= 100_000_000 ? 'text-xl' : 'text-3xl',
          ]}
          data-total="total"
        >
          {money(totals.totalMinor)}
        </p>

        {
          /* `min-w-0` on the label and `whitespace-nowrap` on the value: without
            it a long amount squeezed "To start (40%)" and "On delivery" onto
            two lines each. */
        }
        <dl
          class="flex flex-col gap-2 border-t border-border pt-4 text-base [&_dd]:shrink-0 [&_dd]:whitespace-nowrap [&_dt]:min-w-0"
        >
          <div class="flex justify-between gap-4">
            <dt class="text-muted-foreground">Subtotal</dt>
            <dd class="font-mono" data-total="subtotal">{money(totals.subtotalMinor)}</dd>
          </div>
          {
            totals.discountMinor > 0 && (
              <div class="flex justify-between gap-4">
                <dt class="text-muted-foreground">Discount</dt>
                <dd class="font-mono" data-total="discount">
                  − {money(totals.discountMinor)}
                </dd>
              </div>
            )
          }
          {
            quote.taxRateBp > 0 && (
              <div class="flex justify-between gap-4">
                <dt class="text-muted-foreground">Tax ({quote.taxRateBp / 100}%)</dt>
                <dd class="font-mono" data-total="tax">
                  {money(totals.taxMinor)}
                </dd>
              </div>
            )
          }
          {
            quote.depositPercent > 0 && quote.depositPercent < 100 && (
              <>
                <div class="mt-2 flex justify-between gap-4 border-t border-border pt-3">
                  <dt class="text-muted-foreground">To start ({quote.depositPercent}%)</dt>
                  <dd class="font-mono" data-total="deposit">
                    {money(totals.depositMinor)}
                  </dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-muted-foreground">On delivery</dt>
                  <dd class="font-mono" data-total="balance">
                    {money(totals.balanceMinor)}
                  </dd>
                </div>
              </>
            )
          }
          {
            quote.validUntil && (
              <div class="mt-2 flex justify-between gap-4 border-t border-border pt-3">
                <dt class="text-muted-foreground">Valid until</dt>
                <dd>{dateFormat.format(new Date(quote.validUntil))}</dd>
              </div>
            )
          }
        </dl>

        {
          payment && payment.paidMinor > 0 && payment.outstandingMinor > 0 && (
            <div class="mt-5 rounded-xl border border-border bg-muted px-4 py-3 text-base">
              <p>
                Paid so far <span class="font-mono">{money(payment.paidMinor)}</span>
              </p>
              <p class="text-muted-foreground">
                Still to pay <span class="font-mono">{money(payment.outstandingMinor)}</span>
              </p>
            </div>
          )
        }

        {
          payment?.outstandingMinor === 0 && (
            <p class="mt-5 flex min-h-12 items-center justify-center rounded-full border border-accent bg-accent/10 px-4 text-base">
              Paid. Thank you.
            </p>
          )
        }

        {
          !decided && payment?.outstandingMinor !== 0 && (
            <a
              href="#decision"
              class="mt-5 flex min-h-12 items-center justify-center rounded-full bg-primary px-6 text-base text-primary-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              Respond to this quote
            </a>
          )
        }

        {
          /* Only once they have said yes: an invoice for work a client has not
            agreed to is a bill, not a document. The endpoint enforces the same
            rule, so hiding the button is presentation rather than the control. */
        }
        {
          quote.status === 'accepted' && (
            <a
              href={`/api/v1/quote/${quote.slug}/invoice`}
              class="mt-2 flex min-h-12 items-center justify-center gap-2 rounded-full border border-border px-6 text-base transition-colors hover:border-foreground"
              aria-disabled={isPreview ? 'true' : undefined}
            >
              <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true">
                <path
                  d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              Download invoice
            </a>
          )
        }

        {
          payment?.enabled && (
            <>
              {/* Just the action. The amount is already on the "To start" row
                  directly above, and repeating a seven-figure naira total on a
                  button wrapped it onto two lines. */}
              <button
                type="button"
                data-pay-button
                data-slug={quote.slug}
                disabled={isPreview}
                class="mt-2 flex min-h-12 w-full items-center justify-center rounded-full bg-accent px-6 text-base whitespace-nowrap text-accent-foreground transition-colors hover:bg-foreground hover:text-background disabled:opacity-60"
              >
                {payment.kind === 'deposit' ? 'Pay the deposit' : 'Pay the balance'}
              </button>
              <p data-pay-error class="mt-2 hidden text-sm text-destructive" role="alert" />
              <p class="mt-2 text-sm text-muted-foreground">
                Card or bank transfer, handled by Paystack. We never see your card details.
              </p>
            </>
          )
        }
      </div>
    </aside>

    {/* Full width and last on both layouts: the ask comes after the price.*/}
    <div class="min-w-0 lg:col-span-2">
      <section
        id="decision"
        class="rounded-section bg-surface-dark p-6 text-surface-dark-foreground lg:p-10"
      >
        {
          decided ? (
            <>
              <h2 class="wh-h3 mb-3">
                {quote.status === 'accepted' ? 'Thank you' : 'Thanks for letting us know'}
              </h2>
              <p class="text-lg text-white/70">
                {quote.status === 'accepted'
                  ? 'We have this and will be in touch shortly to get started.'
                  : 'If anything changes, or you would like this reworked, just reply to our email.'}
              </p>
            </>
          ) : (
            <>
              <h2 class="wh-h3 mb-3">Happy with this?</h2>
              <p class="mb-8 max-w-xl text-lg text-white/70">
                Let us know either way. Nothing here is binding: it tells us whether to book the
                time in.
              </p>

              <form method="post" class="flex flex-col gap-5" inert={isPreview || undefined}>
                <label for="note" class="text-base text-white/60">
                  Anything you want to add? (optional)
                </label>
                <textarea
                  id="note"
                  name="note"
                  rows="3"
                  maxlength="2000"
                  disabled={isPreview}
                  class="rounded-xl border border-white/20 bg-white/5 px-4 py-3 text-lg text-white outline-none focus-visible:border-accent disabled:opacity-60"
                />

                <div class="flex flex-wrap gap-3">
                  <button
                    type="submit"
                    name="decision"
                    value="accepted"
                    disabled={isPreview}
                    class="min-h-14 rounded-full bg-accent px-8 text-lg text-accent-foreground transition-colors hover:bg-white hover:text-foreground disabled:opacity-60"
                  >
                    Let's do it
                  </button>
                  <button
                    type="submit"
                    name="decision"
                    value="declined"
                    disabled={isPreview}
                    class="min-h-14 rounded-full border border-white/30 px-8 text-lg text-white transition-colors hover:border-white disabled:opacity-60"
                  >
                    Not right now
                  </button>
                </div>
              </form>

              {isPreview && (
                <p class="mt-5 text-base text-white/50">
                  These buttons are disabled in preview. Your client will see them working.
                </p>
              )}
            </>
          )
        }
      </section>

      <footer
        class="mt-10 flex flex-wrap items-center justify-between gap-4 text-base text-muted-foreground"
      >
        <p>
          Questions?{' '}
          <a class="underline" href={`mailto:${SITE.email}`}>
            {SITE.email}
          </a>
        </p>
        <Logo variant="mark" class="h-5 w-auto opacity-60" label={SITE.name} />
      </footer>
    </div>
  </div>
</main>

{
  /*  The only JavaScript on this page besides the gallery island.

  Deliberately not a framework component: it is one fetch and one redirect, and
  the button must still be visible (and the copy honest) if the script never
  runs, which is why the fallback is an explanatory error rather than a dead
  button.*/
}
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-pay-button]').forEach((button) => {
    const error = document.querySelector<HTMLElement>('[data-pay-error]')

    button.addEventListener('click', async () => {
      const original = button.textContent
      button.disabled = true
      button.textContent = 'Taking you to checkout…'
      error?.classList.add('hidden')

      try {
        const response = await fetch(`/api/v1/quote/${button.dataset['slug']}/pay`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: '{}',
        })
        const body = await response.json()

        if (!response.ok) {
          if (error) {
            error.textContent = body?.error?.message ?? 'We could not start that payment.'
            error.classList.remove('hidden')
          }
          button.disabled = false
          button.textContent = original
          return
        }

        window.location.href = body.url
      } catch {
        if (error) {
          error.textContent = 'We could not reach the server. Please try again.'
          error.classList.remove('hidden')
        }
        button.disabled = false
        button.textContent = original
      }
    })
  })

  /*
   * Package and add-on selection.
   *
   * Two phases, because they have different deadlines.
   *
   * The CARD responds on the click, from state the browser already has. Waiting
   * on a round trip to show a radio filling in makes a working page feel
   * broken — the client clicks, nothing moves, and they click again.
   *
   * The FIGURES wait for the server, because the server owns the arithmetic.
   * They arrive pre-formatted so this file never does currency itself, and they
   * are keyed by name so a row the page does not have is caught rather than
   * silently skipped.
   */
  /*
   * The "What's included" disclosure lives inside the package's <label>, so a
   * click on it would toggle the details AND activate the label's radio —
   * selecting a package the client only wanted to read about.
   *
   * `preventDefault` cancels both, and the open state is then set by hand.
   * Keyboard activation of a <summary> dispatches a click too, so Enter and
   * Space go through this same path.
   */
  document.querySelectorAll<HTMLElement>('[data-option-details] > summary').forEach((summary) => {
    summary.addEventListener('click', (event) => {
      event.preventDefault()
      const details = summary.parentElement as HTMLDetailsElement | null
      if (details) details.open = !details.open
    })
  })

  {
    const inputs = [...document.querySelectorAll<HTMLInputElement>('[data-option-input]')]

    if (inputs.length > 0) {
      const status = document.querySelector<HTMLElement>('[data-option-status]')

      /*
       * No slug means the markup and this script have drifted. Posting anyway
       * builds `/api/v1/quote//select`, which normalises to a different route
       * and 404s — a failure that reads to the client as "we could not save
       * that" and gives nobody a reason. Refuse instead, and say so.
       */
      const slug = inputs[0]?.dataset['optionSlug']
      if (!slug) {
        console.error('[quote] option controls are missing data-option-slug')
        inputs.forEach((input) => {
          input.disabled = true
        })
        if (status) {
          status.textContent =
            'We cannot save changes to this quote right now. Please email us and we will sort it out.'
          status.classList.remove('hidden')
        }
        throw new Error('missing data-option-slug')
      }

      const SELECTED_CARD = ['border-foreground', 'ring-1', 'ring-foreground']
      const UNSELECTED_CARD = ['border-border', 'hover:border-foreground']
      const SELECTED_MARK = ['border-foreground', 'bg-foreground']

      /** Paints one option's card to match its input. No network, no waiting. */
      const paint = (input: HTMLInputElement): void => {
        const card = input.closest<HTMLElement>('[data-option-card]')
        if (!card) return

        card.classList.toggle('border-foreground', input.checked)
        SELECTED_CARD.forEach((cls) => card.classList.toggle(cls, input.checked))
        UNSELECTED_CARD.forEach((cls) => card.classList.toggle(cls, !input.checked))

        const mark = card.querySelector<HTMLElement>('[data-option-indicator]')
        SELECTED_MARK.forEach((cls) => mark?.classList.toggle(cls, input.checked))
        mark?.classList.toggle('border-border', !input.checked)

        const dot = card.querySelector<HTMLElement>('[data-option-dot]')
        dot?.classList.toggle('opacity-100', input.checked)
        dot?.classList.toggle('opacity-0', !input.checked)
      }

      /** Repaints every card. Radios are exclusive, so one click moves two. */
      const paintAll = (): void => inputs.forEach(paint)

      let inFlight = 0

      inputs.forEach((input) => {
        input.addEventListener('change', async () => {
          // Immediate, before anything is sent.
          paintAll()

          const previous = inputs.map((other) => other.checked)
          const request = (inFlight += 1)

          status?.classList.add('hidden')

          try {
            const response = await fetch(`/api/v1/quote/${slug}/select`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ optionId: input.value, selected: input.checked }),
            })

            // A slower earlier click landing after a faster later one would
            // otherwise repaint the page with the wrong answer.
            if (request !== inFlight) return

            if (!response.ok) {
              const body = await response.json().catch(() => null)
              inputs.forEach((other, index) => {
                other.checked = previous[index] ?? false
              })
              paintAll()
              if (status) {
                status.textContent =
                  body?.error?.message ?? 'We could not save that. Please try again.'
                status.classList.remove('hidden')
              }
              return
            }

            const body = (await response.json()) as {
              display: Record<string, string>
              totalIsLarge: boolean
              options: Array<{ id: string; isSelected: boolean }>
            }

            // The server is the authority on what is selected, not the click.
            body.options.forEach((option) => {
              const control = inputs.find((other) => other.value === option.id)
              if (control) control.checked = option.isSelected
            })
            paintAll()

            for (const [key, value] of Object.entries(body.display)) {
              const cell = document.querySelector<HTMLElement>(`[data-total="${key}"]`)
              if (!cell) {
                // A row the server reports and the page cannot show means the
                // two have diverged. Reload rather than display a partial truth.
                window.location.reload()
                return
              }
              cell.textContent = value
            }

            const total = document.querySelector<HTMLElement>('[data-total="total"]')
            total?.classList.toggle('text-xl', body.totalIsLarge)
            total?.classList.toggle('text-3xl', !body.totalIsLarge)
          } catch {
            if (request !== inFlight) return
            inputs.forEach((other, index) => {
              other.checked = previous[index] ?? false
            })
            paintAll()
            if (status) {
              status.textContent = 'We could not reach the server. Please try again.'
              status.classList.remove('hidden')
            }
          }
        })
      })
    }
  }
</script>
