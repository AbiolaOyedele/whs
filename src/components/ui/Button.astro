---
/**
 * Button / link button. Renders an <a> when `href` is set, otherwise a <button>.
 * Every variant clears the 44px tap-target minimum.
 */
interface Props {
  variant?: 'primary' | 'accent' | 'outline' | 'ghost' | 'link'
  size?: 'sm' | 'md' | 'lg'
  href?: string
  type?: 'button' | 'submit' | 'reset'
  disabled?: boolean
  class?: string
  /** Renders light-on-dark, for use inside dark hero bands. */
  onDark?: boolean
  [key: string]: unknown
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
  onDark = false,
  ...rest
} = Astro.props

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-medium ' +
  'transition-[background-color,color,border-color,opacity,transform] duration-150 ease-standard ' +
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring ' +
  'disabled:pointer-events-none disabled:opacity-50 active:scale-[0.98] text-center'

/* Heights and type sizes verified against the reference: the primary pill is
   48px tall with 24px side padding and 18px text. */
const sizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'min-h-11 px-5 text-base',
  md: 'min-h-12 px-6 text-lg',
  lg: 'min-h-12 px-6 text-lg',
}

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary: onDark
    ? 'bg-white text-[color:var(--foreground)] hover:bg-white/90'
    : 'bg-primary text-primary-foreground hover:opacity-90',
  accent: 'bg-accent text-accent-foreground hover:opacity-90',
  outline: onDark
    ? 'border border-white/30 text-white hover:bg-white/10'
    : 'border border-border bg-transparent hover:bg-muted',
  ghost: onDark ? 'text-white hover:bg-white/10' : 'hover:bg-muted',
  link: 'px-0 min-h-11 underline-offset-4 hover:underline ' + (onDark ? 'text-white' : ''),
}

const classes = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ')
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}
