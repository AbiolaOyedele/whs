---
/**
 * Button / link button.
 *
 * `primary`, `accent` and `outline` use the flow interaction: on hover the pill
 * squares off to a 12px radius, a circle expands from the centre to flood the
 * surface, and a pair of arrows slides across. It is entirely CSS `group-hover`,
 * so it ships no JavaScript — the React twin in `flow-button.tsx` exists only
 * for use inside islands.
 *
 * `ghost` and `link` stay plain: the flow treatment reads as a call to action
 * and would be noise on an inline text link.
 *
 * Renders an <a> when `href` is set, otherwise a <button>.
 */
interface Props {
  variant?: 'primary' | 'accent' | 'outline' | 'ghost' | 'link'
  size?: 'sm' | 'md' | 'lg'
  href?: string
  type?: 'button' | 'submit' | 'reset'
  disabled?: boolean
  class?: string
  /** Inverts the outline treatment for use on dark surfaces. */
  onDark?: boolean
  /** Sliding arrows on hover. Turn off for wide buttons, where the arrows
   *  travel a long way from the label and read as unrelated. */
  arrows?: boolean
  [key: string]: unknown
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
  onDark = false,
  arrows = true,
  ...rest
} = Astro.props

const isFlow = variant === 'primary' || variant === 'accent' || variant === 'outline'

/* `lg` used to be byte-identical to `md`, so eight call sites asked for a
   bigger button and got the default. */
const sizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'min-h-11 px-6 text-base',
  md: 'min-h-12 px-8 text-lg',
  lg: 'min-h-14 px-10 text-lg md:text-xl',
}

/** Resting surface, plus the colour the expanding circle floods with. */
const flowTones: Record<'primary' | 'accent' | 'outline', { base: string; circle: string }> = {
  primary: {
    base: 'border-[1.5px] border-transparent bg-primary text-primary-foreground hover:text-accent-foreground',
    circle: 'bg-accent',
  },
  accent: {
    base: 'border-[1.5px] border-transparent bg-accent text-accent-foreground hover:text-background',
    circle: 'bg-foreground',
  },
  outline: onDark
    ? {
        base: 'border-[1.5px] border-white/40 bg-transparent text-white hover:text-[#131314]',
        circle: 'bg-white',
      }
    : {
        base: 'border-[1.5px] border-border bg-transparent text-foreground hover:text-background',
        circle: 'bg-foreground',
      },
}

const plainVariants: Record<'ghost' | 'link', string> = {
  ghost: onDark ? 'text-white hover:bg-white/10' : 'hover:bg-muted',
  link: 'px-0 underline-offset-4 hover:underline ' + (onDark ? 'text-white' : ''),
}

const base =
  'group relative inline-flex items-center justify-center gap-1 text-center font-medium ' +
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring ' +
  'disabled:pointer-events-none disabled:opacity-50'

const flowBase =
  'overflow-hidden rounded-[100px] transition-all duration-[600ms] ' +
  'ease-[cubic-bezier(0.23,1,0.32,1)] hover:rounded-[12px] hover:border-transparent active:scale-[0.97]'

const classes = isFlow
  ? [base, flowBase, sizes[size], flowTones[variant].base, className].filter(Boolean).join(' ')
  : [
      base,
      'rounded-full transition-colors duration-150',
      variant === 'link' ? 'min-h-11' : sizes[size],
      plainVariants[variant as 'ghost' | 'link'],
      className,
    ]
      .filter(Boolean)
      .join(' ')

const Tag = href ? 'a' : 'button'
const tagProps = href ? { href } : { type, disabled }
---

<Tag class={classes} {...tagProps} {...rest}>
  {
    isFlow ? (
      <Fragment>
        {/* Arrow sliding in from the left. */}
        {arrows && (
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="absolute left-[-25%] z-[9] h-4 w-4 transition-all duration-[800ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:left-4"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        )}

        {/*
          With arrows, the label slides across to make room for them. Without,
          it stays centred — a sideways shift with nothing to make room for
          reads as misalignment — and picks up a small scale instead, so the
          button still responds to the pointer and matches the flow timing.
        */}
        <span
          class={`relative z-[1] transition-all duration-[800ms] ease-out ${
            arrows
              ? '-translate-x-3 group-hover:translate-x-3'
              : 'group-hover:scale-[1.045] group-hover:tracking-[0.01em]'
          }`}
        >
          <slot />
        </span>

        {/*
          Circle expanding from the centre to flood the button.

          Sized as a percentage of the button's own width with `aspect-square`,
          not a fixed pixel diameter — a fixed 260px could not reach the ends of
          a 298px-wide button, which left the resting colour showing in two
          slivers either side. Animated with `scale` rather than width/height so
          it composites on the GPU instead of triggering layout each frame.
        */}
        <span
          aria-hidden="true"
          class={`absolute top-1/2 left-1/2 aspect-square w-[135%] -translate-x-1/2 -translate-y-1/2 scale-0 rounded-full opacity-0 transition-[transform,opacity] duration-[800ms] ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:scale-100 group-hover:opacity-100 ${flowTones[variant].circle}`}
        />

        {/* Arrow sliding out to the right. */}
        {arrows && (
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="absolute right-4 z-[9] h-4 w-4 transition-all duration-[800ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:right-[-25%]"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        )}
      </Fragment>
    ) : (
      <slot />
    )
  }
</Tag>

<style>
  /* The circle and arrows are decorative; never animate them for users who
     have asked for reduced motion. The colour change still applies. */
  @media (prefers-reduced-motion: reduce) {
    .group svg,
    .group span {
      transition: none !important;
    }
  }
</style>
