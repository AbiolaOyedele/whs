---
/**
 * FAQ accordion.
 *
 * Built on <details>/<summary> so every answer is present in the static HTML
 * and readable by assistive tech, search crawlers, and AI crawlers that do not
 * execute JS. The script only adds the height animation on top.
 */
import SectionHeading from './SectionHeading.astro'

interface Faq {
  question: string
  answer: string
}

interface Props {
  faqs: readonly Faq[]
  heading?: string
  eyebrow?: string
  class?: string
}

const { faqs, heading = 'Frequently asked questions', eyebrow, class: className = '' } = Astro.props
---

{
  faqs.length > 0 && (
    <section class={`wh-container wh-section ${className}`}>
      <SectionHeading eyebrow={eyebrow} level={2}>
        {heading}
      </SectionHeading>

      <div class="mt-8 divide-y divide-border border-y border-border">
        {faqs.map((faq) => (
          <details class="wh-faq group">
            <summary class="wh-tap flex w-full cursor-pointer list-none items-center justify-between gap-4 py-5 text-left text-base font-medium md:text-lg [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <span
                aria-hidden="true"
                class="relative size-5 shrink-0 transition-transform duration-300 ease-standard group-open:rotate-45"
              >
                <span class="absolute top-1/2 left-0 h-px w-5 -translate-y-1/2 bg-current" />
                <span class="absolute top-0 left-1/2 h-5 w-px -translate-x-1/2 bg-current" />
              </span>
            </summary>
            <div class="wh-faq__panel">
              <p class="max-w-[65ch] pb-5 text-muted-foreground">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}
