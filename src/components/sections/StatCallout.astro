---
/** Large numeric result with a small label underneath. */
interface Props {
  value: string
  label: string
  onDark?: boolean
  size?: 'md' | 'lg'
  class?: string
}

const { value, label, onDark = false, size = 'md', class: className = '' } = Astro.props
const valueSize = size === 'lg' ? 'text-4xl md:text-6xl' : 'text-3xl md:text-4xl'
---

<div class={className}>
  <p class={`${valueSize} font-medium tracking-tighter tabular-nums`}>{value}</p>
  <p class={`mt-1 text-sm ${onDark ? 'text-white/60' : 'text-muted-foreground'}`}>{label}</p>
</div>
