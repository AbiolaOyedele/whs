---
/** Reverse-chronological article list with a progressive "Load more" control. */
import type { CollectionEntry } from 'astro:content'
import { INSIGHT_CATEGORY_LABELS } from '@/content.config'

interface Props {
  posts: ReadonlyArray<CollectionEntry<'insights'>>
  /** Items visible before "Load more" is pressed. */
  pageSize?: number
  class?: string
}

const { posts, pageSize = 9, class: className = '' } = Astro.props

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<div data-article-list data-page-size={pageSize} class={className}>
  {
    posts.length === 0 ? (
      <p class="text-muted-foreground">Articles will be published soon.</p>
    ) : (
      <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => (
          <li data-article-item hidden={index >= pageSize}>
            <article class="relative flex h-full flex-col rounded-xl border border-border bg-card p-6 transition-[transform,box-shadow] duration-200 ease-out focus-within:-translate-y-0.5 focus-within:shadow-md hover:-translate-y-0.5 hover:shadow-md">
              <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
                {INSIGHT_CATEGORY_LABELS[post.data.category]}
              </p>
              <h2 class="mt-3 text-lg font-medium">
                <a
                  href={`/insights/${post.data.category}/${post.id.split('/').pop()}`}
                  class="after:absolute after:inset-0 after:content-['']"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 flex-1 text-sm text-muted-foreground">{post.data.description}</p>
              <p class="mt-6 text-xs text-muted-foreground">
                {post.data.author.name} ·{' '}
                <time datetime={post.data.publishDate.toISOString()}>
                  {dateFormat.format(post.data.publishDate)}
                </time>{' '}
                · {post.data.readTime} min read
              </p>
            </article>
          </li>
        ))}
      </ul>
    )
  }

  {
    posts.length > pageSize && (
      <div class="mt-10 flex justify-center">
        <button
          type="button"
          data-load-more
          class="wh-tap inline-flex items-center rounded-full border border-border px-6 text-sm font-medium transition-colors hover:bg-muted"
        >
          Load more
        </button>
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-article-list]').forEach((list) => {
    const button = list.querySelector<HTMLButtonElement>('[data-load-more]')
    if (!button) return
    const step = Number(list.dataset['pageSize'] ?? '9')

    button.addEventListener('click', () => {
      const hidden = [...list.querySelectorAll<HTMLElement>('[data-article-item][hidden]')]
      hidden.slice(0, step).forEach((item) => {
        item.hidden = false
      })
      // Move focus to the first newly revealed card so keyboard users keep place.
      hidden[0]?.querySelector('a')?.focus()
      if (list.querySelectorAll('[data-article-item][hidden]').length === 0) button.hidden = true
    })
  })
</script>
