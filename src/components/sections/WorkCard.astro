---
/**
 * Case-study card.
 *
 * The stack in muted type above the card, then the media with the client name
 * in its top-left corner and up to two stat pills along the bottom, then the
 * summary underneath with an accent arrow that slides in on hover or focus.
 *
 * The app sits inset in the media, below a dark band that holds the name, like
 * a window rising into the card. Laid over the app itself, the name collided
 * with the app's own wordmark, which lives in the same corner, and white text
 * vanished on white screens. The band keeps the name's contrast fixed. The
 * pills carry a hairline edge for the same reason: a white pill on a white
 * screen otherwise has no outline at all.
 *
 * The media has no height of its own. Its shape comes from the grid slot the
 * card sits in (`[data-slot]` in global.css): landscape in a wide slot,
 * portrait in a narrow one, a banner across the full width, and near-square on
 * a phone. Cards in a row align to the top rather than stretching to match, so
 * a portrait card beside a landscape one keeps its own proportions.
 *
 * The whole card is one link, so the media is the tap target. The arrow is
 * decoration on top of that, which is why it can appear on hover alone.
 *
 * The card carries no outer margin. All spacing between cards lives on the
 * grid, so there is one source of truth for the rhythm.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import LivePreview from '@/components/sections/LivePreview.astro'
import Icon from '@/components/ui/Icon.astro'
import type { LivePreviewSlug } from '@/config/previews'

interface Stat {
  value: string
  label: string
}

interface Props {
  href: string
  client: string
  summary: string
  stats?: readonly Stat[]
  /** Shown above the card. The first three, so it stays on one line on a phone. */
  stack?: readonly string[]
  /** Real screenshot. Falls back to the seeded gradient when absent. */
  cover?: ImageMetadata | undefined
  /** Describes what the screenshot shows. Required alongside `cover`. */
  coverAlt?: string | undefined
  /** The running app. Takes the place of `cover` when both are set. */
  preview?: LivePreviewSlug | undefined
  /** Position in the grid's nine-card cycle, when the card is a grid item itself. */
  gridSlot?: number | undefined
  class?: string
}

const {
  href,
  client,
  summary,
  stats = [],
  stack = [],
  cover,
  coverAlt,
  preview,
  gridSlot,
  class: className = '',
} = Astro.props

/*
 * Placeholder artwork for entries with no screenshot yet, varied per project.
 * Seeded off the client name so a given project keeps its own colour across
 * the home page and the work index.
 */
const seed = [...client].reduce((total, char) => total + char.charCodeAt(0), 0)
const hue = (seed * 47) % 360
const angle = 120 + (seed % 5) * 15
const placeholder =
  `linear-gradient(${angle}deg, #1c1c1f 0%, #2b2b30 46%, #191919 100%), ` +
  `radial-gradient(70% 60% at ${25 + (seed % 5) * 12}% ${18 + (seed % 4) * 14}%, ` +
  `oklch(72% 0.14 ${hue} / 0.5), transparent 70%)`

const motion = 'transition-transform duration-300 ease-out'
/* The app or screenshot, inset below the name band and open at the bottom. */
const frame = `absolute inset-x-3 top-16 bottom-0 rounded-t-2xl md:inset-x-5 ${motion} group-hover:-translate-y-1.5`
---

<a href={href} data-slot={gridSlot} class:list={['group relative block rounded-3xl', className]}>
  {
    stack.length > 0 && (
      <span class="absolute -top-8 ml-5 truncate text-muted-foreground">
        ({stack.slice(0, 3).join(', ')})
      </span>
    )
  }

  <div class="wh-work-media relative overflow-clip rounded-3xl bg-surface-dark">
    {
      /*      Screenshots keep their top-left corner: these are application windows,
      and that corner is where an interface puts what identifies it.*/
    }
    {
      preview ? (
        <LivePreview slug={preview} class={frame} />
      ) : cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1024px) 60vw, 100vw"
          class={`${frame} h-[calc(100%-4rem)] w-[calc(100%-1.5rem)] object-cover object-left-top md:w-[calc(100%-2.5rem)]`}
        />
      ) : (
        <div
          aria-hidden="true"
          class={`absolute inset-0 ${motion} group-hover:scale-[1.03]`}
          style={`background: ${placeholder}; background-blend-mode: screen;`}
        />
      )
    }

    <span
      class="pointer-events-none absolute top-5 left-5 z-20 text-2xl text-surface-dark-foreground"
    >
      {client}
    </span>

    {
      stats.length > 0 && (
        <span class="absolute right-5 bottom-5 left-5 z-10 flex flex-col items-start gap-y-1">
          {stats.slice(0, 2).map((stat) => (
            <span class="rounded-full bg-card px-4 py-2 text-sm text-card-foreground ring-1 ring-border md:px-6 md:text-base">
              <span class="font-medium tabular-nums">{stat.value}</span> {stat.label}
            </span>
          ))}
        </span>
      )
    }
  </div>

  <span class="flex w-full items-start justify-between gap-4 px-5">
    <span class="pt-5 text-lg text-balance md:text-xl lg:max-w-[66%] lg:text-2xl">
      {summary}
    </span>
    <span
      aria-hidden="true"
      class="mt-5 hidden h-10 shrink-0 translate-y-2 items-center rounded-full bg-accent px-6 text-accent-foreground opacity-0 transition-[opacity,transform] duration-500 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 lg:inline-flex"
    >
      <Icon name="arrowRight" class="size-4" />
    </span>
  </span>
</a>
