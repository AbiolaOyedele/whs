---
/**
 * Closing CTA band. The single implementation.
 *
 * The home page and /services each hand-rolled their own version of this, with
 * different radii (12 / 24 / 24px), different padding, different heading scales
 * (30-48 / 36-64 / 32-56px) and different alignment. `align` and `size` cover
 * what those two needed, so there is one component again.
 */
import Button from '../ui/Button.astro'
import AnimatedText from './AnimatedText.astro'

interface Props {
  heading?: string
  subheading?: string
  ctaLabel?: string
  ctaHref?: string
  secondaryLabel?: string
  secondaryHref?: string
  note?: string
  /** `lg` is the full-height closing band used at the foot of the home page. */
  size?: 'md' | 'lg'
  align?: 'left' | 'center'
  class?: string
}

const {
  heading = 'Your hours should not go into work a system could do.',
  subheading = 'Tell us where it hurts and we will tell you what we would do about it.',
  ctaLabel = 'Talk to us',
  ctaHref = '/get-in-touch',
  secondaryLabel,
  secondaryHref,
  note,
  size = 'md',
  align = 'left',
  class: className = '',
} = Astro.props

const centred = align === 'center'

const panel =
  size === 'lg'
    ? 'min-h-[32rem] justify-center px-6 py-20 md:px-14 lg:min-h-[38rem] lg:py-28'
    : 'px-6 py-14 md:px-12 md:py-20'
---

<section class={`wh-container wh-section ${className}`}>
  <div
    class={`relative isolate flex flex-col overflow-clip rounded-3xl bg-surface-dark text-surface-dark-foreground ${panel}`}
  >
    {
      /* Accent wash. Mirrors the hero's glow so the page opens and closes on
         the same surface treatment.*/
    }
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(70rem 40rem at 82% 8%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 62%);"
    >
    </div>

    <div class={centred ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl'}>
      <AnimatedText>
        <h2 class="wh-h2-display text-balance">{heading}</h2>
      </AnimatedText>
      <p
        class={`mt-5 text-lg text-white/70 md:text-xl ${centred ? 'mx-auto max-w-[36rem]' : 'max-w-[36rem]'}`}
      >
        {subheading}
      </p>

      <div class={`mt-9 flex flex-wrap gap-3 ${centred ? 'justify-center' : ''}`}>
        <Button href={ctaHref} variant="accent" size="lg">{ctaLabel}</Button>
        {
          secondaryLabel && secondaryHref && (
            <Button href={secondaryHref} variant="outline" size="lg" onDark>
              {secondaryLabel}
            </Button>
          )
        }
      </div>

      {note && <p class="mt-6 text-sm text-white/60">{note}</p>}
    </div>
  </div>
</section>
