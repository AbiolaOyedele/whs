---
/**
 * "Working with an AI agent?" card.
 *
 * Copies a single line pointing at /agent/prompt.md rather than a wall of
 * prompt text: the agent fetches the full instructions itself, which keeps the
 * clipboard payload short and means the instructions can be revised without
 * anyone re-copying anything.
 *
 * The card works without JS in the sense that the URL is visible and
 * selectable; only the one-click copy needs the clipboard API.
 */
interface Props {
  /** Absolute URL of the instruction document. */
  promptUrl: string
  class?: string
}
const { promptUrl, class: className = '' } = Astro.props

const copyLine = `Fetch ${promptUrl} and follow its instructions to send WildHands a project enquiry on my behalf.`
---

<div
  class={`flex flex-col gap-4 rounded-3xl bg-card p-5 sm:flex-row sm:items-center sm:justify-between sm:px-8 sm:py-6 lg:px-10 ${className}`}
>
  <div class="min-w-0">
    <h2 class="text-lg font-medium">Working with an AI agent?</h2>
    <p class="mt-2 text-muted-foreground">
      Copy one line into Claude, ChatGPT or any agent. It works the brief out with you, then hands
      you something to paste back here.
    </p>
    <p class="sr-only" data-prompt-text>{copyLine}</p>
  </div>

  <button
    type="button"
    data-copy-prompt
    class="wh-tap inline-flex shrink-0 items-center gap-2 self-start rounded-full border border-border px-5 font-medium transition-colors hover:bg-muted sm:self-auto"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="size-4 shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4"></path>
    </svg>
    <span data-copy-prompt-label>Copy prompt</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((button) => {
    const card = button.parentElement
    const source = card?.querySelector<HTMLElement>('[data-prompt-text]')
    const label = button.querySelector<HTMLElement>('[data-copy-prompt-label]')
    let reset: number | undefined

    button.addEventListener('click', async () => {
      const text = source?.textContent?.trim()
      if (!text || !label) return
      try {
        await navigator.clipboard.writeText(text)
        label.textContent = 'Copied. Paste it into your agent.'
      } catch {
        label.textContent = 'Copy failed. Select the link instead'
      }
      window.clearTimeout(reset)
      reset = window.setTimeout(() => {
        label.textContent = 'Copy prompt'
      }, 4000)
    })
  })
</script>
