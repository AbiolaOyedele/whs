---
/**
 * Copy-to-clipboard prompt block for visitors researching with an AI assistant.
 * The prompt text is fully visible without JS; only the copy button needs it.
 */
interface Props {
  prompt: string
  class?: string
}
const { prompt, class: className = '' } = Astro.props
---

<div class={`rounded-xl border border-border bg-muted/40 p-5 ${className}`}>
  <h2 class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
    Working with an AI agent?
  </h2>
  <p class="mt-3 text-sm text-muted-foreground">
    Copy this into Claude, ChatGPT, or any agent to have it research us for you.
  </p>

  <div class="mt-4 overflow-x-auto rounded-lg bg-surface-dark p-4">
    <pre
      class="font-mono text-xs whitespace-pre-wrap text-white/80"><code data-prompt-text>{prompt}</code></pre>
  </div>

  <button
    type="button"
    data-copy-prompt
    class="wh-tap mt-3 inline-flex items-center rounded-full border border-border px-4 text-sm transition-colors hover:bg-muted"
  >
    <span data-copy-prompt-label>Copy prompt</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((button) => {
    const container = button.closest('div')
    const source = container?.querySelector<HTMLElement>('[data-prompt-text]')
    const label = button.querySelector<HTMLElement>('[data-copy-prompt-label]')

    button.addEventListener('click', async () => {
      if (!source?.textContent || !label) return
      try {
        await navigator.clipboard.writeText(source.textContent)
        label.textContent = 'Copied'
      } catch {
        label.textContent = 'Select the text to copy'
      }
      window.setTimeout(() => {
        label.textContent = 'Copy prompt'
      }, 2000)
    })
  })
</script>
