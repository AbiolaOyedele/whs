---
/**
 * Pull-quote with attribution and an optional video trigger.
 * The modal is a React island; without a videoUrl no JS ships at all.
 */
import VideoModal from '../ui/VideoModal.tsx'

interface Props {
  quote: string
  name: string
  role: string
  company: string
  videoUrl?: string | undefined
  onDark?: boolean
  class?: string
}

const { quote, name, role, company, videoUrl, onDark = false, class: className = '' } = Astro.props
const meta = onDark ? 'text-white/60' : 'text-muted-foreground'
---

<figure class={className}>
  <blockquote class="text-2xl font-medium tracking-tight text-balance md:text-3xl lg:text-4xl">
    <p>{quote}</p>
  </blockquote>
  <figcaption class={`mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 text-sm ${meta}`}>
    <span>
      <span class={onDark ? 'text-white' : 'text-foreground'}>{name}</span>
      {', '}{role}, {company}
    </span>
    {
      videoUrl && (
        <VideoModal
          client:visible
          videoUrl={videoUrl}
          label={`Watch ${name}'s story`}
          onDark={onDark}
        />
      )
    }
  </figcaption>
</figure>
