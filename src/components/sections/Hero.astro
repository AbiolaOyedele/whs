---
/**
 * Dark hero band.
 *
 * Two absolutely-positioned blocks on large screens, matching the reference:
 *   Block A (upper left, 10.35% / 28.7%, 38.82% wide) — headline, then the
 *           client wordmark row directly beneath it.
 *   Block B (lower right half, bottom 5.55%) — the standfirst paragraph, then
 *           a two-column grid of full-width CTA buttons 80px tall.
 *
 * Below `lg` both fall back to a single flex column.
 *
 * `data-dark-hero` is what SiteHeader measures to decide when to flip its text
 * colour, so any page opening with this component gets that behaviour free.
 */
import AnimatedText from './AnimatedText.astro'
import AnimatedGradient from '@/components/ui/animated-gradient.tsx'

interface Props {
  eyebrow?: string | undefined
  title: string
  /** Standfirst, rendered bottom-right on the home hero. */
  standfirst?: string | undefined
  /** Short subtitle rendered under the headline on inner pages. */
  subtitle?: string | undefined
  variant?: 'home' | 'page'
  videoSrc?: string | undefined
  posterSrc?: string | undefined
  class?: string
}

const {
  eyebrow,
  title,
  standfirst,
  subtitle,
  variant = 'page',
  videoSrc,
  posterSrc,
  class: className = '',
} = Astro.props

const isHome = variant === 'home'
---

<section
  data-dark-hero
  class={`relative isolate overflow-hidden rounded-b-[2rem] bg-[#131314] text-white ${isHome ? 'wh-hero-home' : ''} ${className}`}
>
  {
    videoSrc ? (
      <video
        class="absolute inset-0 size-full object-cover"
        src={videoSrc}
        poster={posterSrc}
        autoplay
        loop
        muted
        playsinline
        aria-hidden="true"
      />
    ) : (
      /* WebGL gradient layered over a CSS beam. The CSS layer is the fallback,
         not decoration: the canvas removes itself when WebGL is unavailable or
         the shader fails to compile, and this shows through unchanged. */
      <div aria-hidden="true" class="absolute inset-0 overflow-hidden bg-[#0a0a0b]">
        <div class="wh-hero-beam" />
        <div class="wh-hero-beam wh-hero-beam--secondary" />
        <div class="wh-hero-glow" />
        <AnimatedGradient client:idle preset="hero" />
      </div>
    )
  }

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background: linear-gradient(180deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.08) 55%, rgba(0,0,0,0.38) 100%);"
  >
  </div>

  <div class="absolute inset-0 z-10 flex flex-col px-5 pt-36 pb-5 sm:px-8 sm:pb-8 lg:block lg:p-0">
    <!-- Block A — headline and client wordmarks -->
    <div
      class={`self-start md:ml-[calc(10.35%-2rem)] lg:absolute lg:left-[10.35%] lg:ml-0 lg:w-[38.82%] ${isHome ? 'lg:top-[28.7%]' : 'lg:top-[38%]'}`}
    >
      {
        eyebrow && (
          <p class="mb-5 text-sm font-medium tracking-widest text-white/50 uppercase">{eyebrow}</p>
        )
      }
      <AnimatedText immediate>
        <h1 class="wh-h1 mix-blend-difference">{title}</h1>
      </AnimatedText>
      {
        subtitle && (
          <p class="mt-8 max-w-[35rem] text-xl leading-[1.25] font-medium text-white/70">
            {subtitle}
          </p>
        )
      }
      <div class="mt-8 max-w-[35rem]">
        <slot name="logos" />
      </div>
    </div>

    <!-- Block B — standfirst and the CTA pair -->
    <div
      class="mt-12 flex flex-col justify-end md:ml-[calc(10.35%-2rem)] md:w-[60%] lg:absolute lg:right-8 lg:bottom-[5.55%] lg:left-1/2 lg:mt-0 lg:ml-0 lg:w-auto"
    >
      {
        standfirst && (
          <p class="max-w-[35rem] text-xl leading-[1.25] sm:text-2xl lg:leading-[1.2]">
            {standfirst}
          </p>
        )
      }
      <div class="mt-10 grid gap-1 sm:grid-cols-2 lg:mt-[7.75rem]">
        <slot name="cta" />
      </div>
      <slot />
    </div>
  </div>
</section>
