---
/**
 * Dark hero band.
 *
 * Both variants lay their content out inside `.wh-container`, so the headline
 * sits on the same left edge as every section below it. The previous version
 * indented by `10.35%` (and `calc(10.35% - 2rem)` at md), which put the hero on
 * a horizontal grid nothing else on the page shared — at 768px the H1 started
 * at 71px while the sections under it started at 20px, and on `/work` the page
 * title sat 124px right of the filters directly beneath it.
 *
 * `home` — a flex column that fills the viewport and no more: headline and
 * wordmarks at the top, standfirst and CTAs pinned to the bottom in a two-up
 * row. It used to be two absolutely-positioned blocks inside an explicit
 * `clamp(65rem, 99.1667vw, 89.25rem)` height, which ran to 1269px on a 900px
 * screen and 1428px on a 1080px one — putting both calls to action below the
 * fold on every desktop size, and leaving the lower-left quarter of the band
 * empty.
 *
 * `page` — the same blocks in normal flow, so the section is as tall as its
 * content.
 *
 * `data-dark-hero` is what SiteHeader measures to decide when to flip its text
 * colour, so any page opening with this component gets that behaviour free.
 */
import AnimatedText from './AnimatedText.astro'
import AnimatedGradient from '@/components/ui/animated-gradient.tsx'

interface Props {
  eyebrow?: string | undefined
  title: string
  /** Standfirst, rendered bottom-left on the home hero. */
  standfirst?: string | undefined
  /** Short subtitle rendered under the headline on inner pages. */
  subtitle?: string | undefined
  variant?: 'home' | 'page'
  videoSrc?: string | undefined
  posterSrc?: string | undefined
  class?: string
  /**
   * Content-registry keys for the headline and standfirst.
   *
   * Rendered as `data-wh-content` so the website editor's live preview can
   * patch the text in place as you type, instead of reloading the page. Purely
   * additive: a data attribute costs nothing when nobody is previewing, and the
   * hero renders identically without them.
   */
  titleKey?: string | undefined
  standfirstKey?: string | undefined
}

const {
  eyebrow,
  title,
  standfirst,
  subtitle,
  variant = 'page',
  videoSrc,
  posterSrc,
  class: className = '',
  titleKey,
  standfirstKey,
} = Astro.props

const isHome = variant === 'home'
---

<section
  data-dark-hero
  class={`relative isolate flex flex-col overflow-hidden rounded-b-section bg-[#131314] text-white ${isHome ? 'wh-hero-home' : ''} ${className}`}
>
  {
    videoSrc ? (
      <video
        class="absolute inset-0 size-full object-cover"
        src={videoSrc}
        poster={posterSrc}
        autoplay
        loop
        muted
        playsinline
        aria-hidden="true"
      />
    ) : (
      /* WebGL gradient layered over a CSS beam. The CSS layer is the fallback,
         not decoration: the canvas removes itself when WebGL is unavailable or
         the shader fails to compile, and this shows through unchanged. */
      <div aria-hidden="true" class="absolute inset-0 overflow-hidden bg-[#0a0a0b]">
        <div class="wh-hero-beam" />
        <div class="wh-hero-beam wh-hero-beam--secondary" />
        <div class="wh-hero-glow" />
        <AnimatedGradient client:idle preset="hero" />
      </div>
    )
  }

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background: linear-gradient(180deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.08) 55%, rgba(0,0,0,0.38) 100%);"
  >
  </div>

  <div
    class={`wh-container relative z-10 flex flex-1 flex-col ${
      isHome
        ? /* justify-between puts the standfirst and CTAs on the bottom edge
             without an absolute offset, so the band can be viewport-height.
             The top pad sets where the headline starts; it eats the slack in
             the middle of the band rather than growing it. */
          'justify-between gap-16 pt-44 pb-10 md:pt-52 lg:pt-60 lg:pb-16'
        : /* Clears the fixed header, then leaves breathing room below it
             before the headline starts. */
          'gap-10 pt-36 pb-16 lg:pt-44 lg:pb-24'
    }`}
  >
    <!-- Block A: headline and client wordmarks -->
    <!--
      Home: measure set for a three-line headline, widened at xl so it stays
      three rather than stepping to four as the type grows with the viewport.
      Inner pages keep the wider measure — their titles are full sentences, and
      the home measure ran them to four and five lines.
    -->
    <div class={isHome ? 'max-w-[35rem] xl:max-w-[46rem]' : 'max-w-[52rem]'}>
      {
        eyebrow && (
          <p class="mb-5 text-sm font-medium tracking-widest text-white/60 uppercase">{eyebrow}</p>
        )
      }
      <!--
        No `mix-blend-difference` on the headline. The backdrop is a dark scrim
        over a near-black field, so plain white reads fine — and the blend mode
        made the H1 render through the open mega-menu panel and compete with
        the menu labels, as well as putting the site's largest piece of type
        beyond the reach of any contrast check.
      -->
      <AnimatedText immediate>
        <h1
          class={isHome ? 'wh-h1 text-balance' : 'wh-h1-page text-balance'}
          data-wh-content={titleKey}
        >
          {title}
        </h1>
      </AnimatedText>
      {
        subtitle && (
          <p class="mt-8 max-w-[38rem] text-xl leading-[1.25] font-medium text-white/75">
            {subtitle}
          </p>
        )
      }
      <div class="mt-8 empty:hidden">
        <slot name="logos" />
      </div>
    </div>

    <!--
      Block B: standfirst and the CTA pair. Two columns at lg so the lower half
      of the band carries content across its full width instead of leaving the
      left side empty.
    -->
    <div
      class={`empty:hidden ${
        isHome
          ? 'flex flex-col gap-10 lg:grid lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-16'
          : 'flex flex-col'
      }`}
    >
      {
        standfirst && (
          <p
            class="max-w-[38rem] text-xl leading-[1.3] text-white/85 sm:text-2xl"
            data-wh-content={standfirstKey}
          >
            {standfirst}
          </p>
        )
      }
      <div class="grid w-full gap-3 empty:hidden sm:auto-cols-fr sm:grid-flow-col lg:w-auto">
        <slot name="cta" />
      </div>
      <slot />
    </div>
  </div>
</section>
