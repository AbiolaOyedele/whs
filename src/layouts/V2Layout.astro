---
/**
 * Document shell for the v2 site: the <html>/<head> half of the Next app's
 * root layout (website-v2/src/app/layout.tsx). The <body> is one React
 * island, src/v2/App.tsx, which holds the header, background, page and
 * footer so client-side navigation keeps all of them alive between pages.
 *
 * Fonts are WildHands' own: Diagramm for headings, IBM Plex Sans for body
 * copy, the system monospace for labels. The faces are declared in
 * src/v2/app/globals.css; these variables are the names the v2 CSS reads.
 */
import '@v2/app/globals.css'
import Seo from '@/components/layout/Seo.astro'
import { organizationSchema, webSiteSchema, type JsonLd } from '@/lib/seo'
import { publicEnv } from '@/config/env'

interface Props {
  title: string
  description: string
  /** Value for <html data-scene>; the background picks its scene from it. */
  scene: string
  /** Value for <html data-template>. */
  template: string
  /** Structured data nodes, one <script type="application/ld+json"> each. */
  jsonLd?: JsonLd[]
  /** Kept out of search results even after launch. */
  noindex?: boolean
}

const { title, description, scene, template, jsonLd = [], noindex = false } = Astro.props

/**
 * Every v2 page stays out of search results until the site launches. Set to
 * false at launch: canonical links, social tags and structured data are
 * already in place.
 */
const HIDDEN_UNTIL_LAUNCH = true

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', siteUrl).href
const schemas: JsonLd[] = [organizationSchema(siteUrl), webSiteSchema(siteUrl), ...jsonLd]
---

<!doctype html>
<html lang="en" class="is-initial-loading" data-scene={scene} data-template={template}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#131314" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Diagramm-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexSans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} canonical={canonical} noindex={HIDDEN_UNTIL_LAUNCH || noindex} jsonLd={schemas} />
    <style is:global>
      :root {
        --font-stand-sans: 'IBM Plex Sans';
        --font-stand-secondary: 'Diagramm', 'IBM Plex Sans';
        --font-stand-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
