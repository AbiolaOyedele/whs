---
/**
 * The single page shell. Every route renders through here so the header,
 * footer, SEO head and skip link stay consistent.
 */
import '@/styles/global.css'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import Footer from '@/components/layout/Footer.astro'
import Seo from '@/components/layout/Seo.astro'
import Analytics from '@/components/layout/Analytics.astro'
import { organizationSchema, webSiteSchema, type JsonLd } from '@/lib/seo'
import { publicEnv } from '@/config/env'
import { loadSiteContent, tokenOverrideCss } from '@/lib/admin/content'

interface Props {
  title: string
  description: string
  /** Set on pages that open with the dark Hero band. */
  darkHero?: boolean
  noindex?: boolean
  ogType?: 'website' | 'article'
  publishedTime?: string | undefined
  jsonLd?: readonly JsonLd[]
}

const {
  title,
  description,
  darkHero = false,
  noindex = false,
  ogType = 'website',
  publishedTime,
  jsonLd = [],
} = Astro.props

/*
 * Load any edited copy and design tokens before the page body renders.
 *
 * Every route renders through this layout, so one await here covers the whole
 * site. It is cached for the process, which means the static build issues a
 * single database read for all fifty-six pages, and it never throws: an
 * unreachable database renders the copy committed in the repository.
 */
await loadSiteContent()
const tokenCss = tokenOverrideCss()

const siteUrl = publicEnv.PUBLIC_SITE_URL.replace(/\/$/, '')
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', siteUrl).href

const schemas: JsonLd[] = [organizationSchema(siteUrl), webSiteSchema(siteUrl), ...jsonLd]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f3f4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/IBMPlexSans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Diagramm-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      ogType={ogType}
      publishedTime={publishedTime}
      jsonLd={schemas}
    />
    <Analytics />
    {
      /* Only the tokens that differ from global.css, so an unedited site ships
        no extra bytes. Inline, so it cascades without a second request. */
    }
    {tokenCss && <style set:html={tokenCss} />}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-3 focus:text-primary-foreground"
    >
      Skip to content
    </a>

    <SiteHeader overDarkHero={darkHero} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {
      /* Accordion behaviour, loaded once for every page. No-op where there are
         no accordions.*/
    }
    <script>
      import '@/scripts/accordion'
    </script>

    {
      /* Loaded unconditionally, and gates itself at runtime on ?whpreview=1.

         It used to sit behind `{isPreviewFrame && ...}`, which does not work:
         Astro hoists and bundles `<script>` tags at build time, and one inside
         a JSX expression is never collected, so the bridge shipped on no page
         at all and the live preview silently never updated. Self-gating costs a
         few hundred bytes and actually runs.*/
    }
    <script>
      import '@/scripts/preview-bridge'
    </script>
  </body>
</html>
