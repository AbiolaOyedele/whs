{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx", "**/*.astro"],
  "exclude": ["dist", "node_modules", ".vercel"],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@v2/*": ["src/v2/*"],
      "next/navigation": ["src/v2/shims/next-navigation.ts"],
      "next/link": ["src/v2/shims/next-link.tsx"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
